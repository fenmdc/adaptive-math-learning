  {"id":"alg1_rem_v1_linear_003","statement":"Solve 3x+4=19.","answer":"5","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"15","text":"15"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations"],"prerequisiteConcepts":["prealg_simplification"],"skills":["two_step_equation"],"patterns":["undo_addition_then_multiplication"],"misconceptions":["divides_before_removing_constant"],"isAutoGradable":true,"solution":"Subtract 4 to get 3x=15, then divide by 3 to get x=5.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-linear","chapterTitle":"Linear Equations","sequence":25103},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_linear_004","statement":"Solve 5(x-2)=20.","answer":"6","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"4","text":"4"},{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"22","text":"22"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","prealg_simplification"],"prerequisiteConcepts":["prealg_simplification"],"skills":["equation_with_parentheses"],"patterns":["divide_then_add"],"misconceptions":["stops_at_parenthetical_value"],"isAutoGradable":true,"solution":"Divide by 5 to get x-2=4, then add 2 to obtain x=6.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-linear","chapterTitle":"Linear Equations","sequence":25104},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_linear_005","statement":"Solve 4x-3=2x+11.","answer":"7","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"8","text":"8"},{"value":"14","text":"14"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations"],"prerequisiteConcepts":["prealg_simplification"],"skills":["variables_both_sides"],"patterns":["collect_variable_terms"],"misconceptions":["combines_across_equality"],"isAutoGradable":true,"solution":"Subtract 2x and add 3 to get 2x=14, so x=7.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-linear","chapterTitle":"Linear Equations","sequence":25105},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_linear_006","statement":"Solve (x/4)+3=8.","answer":"20","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"11","text":"11"},{"value":"20","text":"20"},{"value":"32","text":"32"},{"value":"44","text":"44"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["fraction_equation"],"patterns":["undo_addition_then_division"],"misconceptions":["divides_instead_of_multiplies"],"isAutoGradable":true,"solution":"Subtract 3 to get x/4=5, then multiply by 4 to get x=20.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-linear","chapterTitle":"Linear Equations","sequence":25106},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_linear_007","statement":"A number doubled and then increased by 7 equals 31. What is the number?","answer":"12","answerType":"multiple_choice","choices":[{"value":"7","text":"7"},{"value":"12","text":"12"},{"value":"15","text":"15"},{"value":"19","text":"19"},{"value":"24","text":"24"}],"difficulty":3,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","prealg_word_to_equation"],"prerequisiteConcepts":["prealg_word_to_equation"],"skills":["model_two_step_equation"],"patterns":["verbal_to_equation"],"misconceptions":["reverses_operation_order"],"isAutoGradable":true,"solution":"Write 2x+7=31. Subtract 7 and divide by 2 to get x=12.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-linear","chapterTitle":"Linear Equations","sequence":25107},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_linear_008","statement":"The perimeter of a rectangle is 34. Its length is 3 more than its width. What is the width?","answer":"7","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"10","text":"10"},{"value":"14","text":"14"},{"value":"17","text":"17"}],"difficulty":3,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","geo_perimeter"],"prerequisiteConcepts":["geo_perimeter"],"skills":["geometric_equation_model"],"patterns":["substitute_related_dimension"],"misconceptions":["uses_area_formula"],"isAutoGradable":true,"solution":"Let width be w and length w+3. Then 2w+2(w+3)=34, so 4w=28 and w=7.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-linear","chapterTitle":"Linear Equations","sequence":25108},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_func_001","statement":"If f(x)=2x+3, what is f(4)?","answer":"11","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"9","text":"9"},{"value":"11","text":"11"},{"value":"14","text":"14"},{"value":"24","text":"24"}],"difficulty":1,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_functions","concepts":["alg_functions","prealg_substitution"],"prerequisiteConcepts":["prealg_substitution"],"skills":["function_evaluation"],"patterns":["substitute_input"],"misconceptions":["ignores_constant_term"],"isAutoGradable":true,"solution":"Substitute 4 for x: f(4)=2(4)+3=11.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-functions","chapterTitle":"Functions and Graphs","sequence":25201},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_func_002","statement":"Which ordered pair lies on y=3x-1?","answer":"(2,5)","answerType":"multiple_choice","choices":[{"value":"(0,1)","text":"(0,1)"},{"value":"(1,1)","text":"(1,1)"},{"value":"(2,5)","text":"(2,5)"},{"value":"(3,5)","text":"(3,5)"},{"value":"(5,2)","text":"(5,2)"}],"difficulty":1,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_graphing","concepts":["alg_graphing","alg_functions"],"prerequisiteConcepts":["prealg_substitution"],"skills":["test_ordered_pair"],"patterns":["substitute_coordinates"],"misconceptions":["swaps_x_and_y"],"isAutoGradable":true,"solution":"For (2,5), 3(2)-1=5, so the pair satisfies the equation.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-functions","chapterTitle":"Functions and Graphs","sequence":25202},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_func_003","statement":"What is the slope of y=-2x+5?","answer":"-2","answerType":"multiple_choice","choices":[{"value":"-5","text":"-5"},{"value":"-2","text":"-2"},{"value":"2","text":"2"},{"value":"5","text":"5"},{"value":"7","text":"7"}],"difficulty":1,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_graphing","concepts":["alg_graphing","alg_functions"],"prerequisiteConcepts":["geo_coordinate_geometry"],"skills":["identify_slope"],"patterns":["slope_intercept_form"],"misconceptions":["chooses_y_intercept"],"isAutoGradable":true,"solution":"In y=mx+b, the coefficient m is the slope, so the slope is -2.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-functions","chapterTitle":"Functions and Graphs","sequence":25203},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_func_004","statement":"What is the y-intercept of y=4x-7?","answer":"-7","answerType":"multiple_choice","choices":[{"value":"-7","text":"-7"},{"value":"-4","text":"-4"},{"value":"0","text":"0"},{"value":"4","text":"4"},{"value":"7","text":"7"}],"difficulty":1,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_graphing","concepts":["alg_graphing"],"prerequisiteConcepts":["geo_coordinate_geometry"],"skills":["identify_y_intercept"],"patterns":["slope_intercept_form"],"misconceptions":["drops_negative_sign"],"isAutoGradable":true,"solution":"In y=mx+b, b is the y-intercept, so the intercept is -7.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-functions","chapterTitle":"Functions and Graphs","sequence":25204},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_func_005","statement":"A line passes through (1,3) and (5,11). What is its slope?","answer":"2","answerType":"multiple_choice","choices":[{"value":"1/2","text":"1/2"},{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"8","text":"8"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_graphing","concepts":["alg_graphing","geo_coordinate_geometry"],"prerequisiteConcepts":["geo_coordinate_geometry"],"skills":["slope_from_points"],"patterns":["rise_over_run"],"misconceptions":["reverses_fraction"],"isAutoGradable":true,"solution":"Slope=(11-3)/(5-1)=8/4=2.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-functions","chapterTitle":"Functions and Graphs","sequence":25205},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_func_006","statement":"Which equation has slope 3 and y-intercept -4?","answer":"y=3x-4","answerType":"multiple_choice","choices":[{"value":"y=-4x+3","text":"y=-4x+3"},{"value":"y=3x-4","text":"y=3x-4"},{"value":"y=4x-3","text":"y=4x-3"},{"value":"y=3x+4","text":"y=3x+4"},{"value":"y=-3x-4","text":"y=-3x-4"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_graphing","concepts":["alg_graphing","alg_functions"],"prerequisiteConcepts":["alg_functions"],"skills":["write_slope_intercept_equation"],"patterns":["map_m_and_b"],"misconceptions":["swaps_slope_and_intercept"],"isAutoGradable":true,"solution":"Substitute m=3 and b=-4 into y=mx+b to get y=3x-4.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-functions","chapterTitle":"Functions and Graphs","sequence":25206},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_func_007","statement":"The table has x-values 0,1,2 and y-values 5,8,11. Which rule matches it?","answer":"y=3x+5","answerType":"multiple_choice","choices":[{"value":"y=3x+5","text":"y=3x+5"},{"value":"y=5x+3","text":"y=5x+3"},{"value":"y=3x-5","text":"y=3x-5"},{"value":"y=5x","text":"y=5x"},{"value":"y=x+5","text":"y=x+5"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_functions","concepts":["alg_functions","alg_graphing"],"prerequisiteConcepts":["arith_integers"],"skills":["derive_linear_rule"],"patterns":["constant_difference_and_initial_value"],"misconceptions":["swaps_rate_and_start"],"isAutoGradable":true,"solution":"The output starts at 5 when x=0 and increases by 3 per step, so y=3x+5.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-functions","chapterTitle":"Functions and Graphs","sequence":25207},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_func_008","statement":"A linear function has f(2)=7 and slope 4. What is f(5)?","answer":"19","answerType":"multiple_choice","choices":[{"value":"11","text":"11"},{"value":"15","text":"15"},{"value":"19","text":"19"},{"value":"20","text":"20"},{"value":"27","text":"27"}],"difficulty":3,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_functions","concepts":["alg_functions","alg_graphing"],"prerequisiteConcepts":["alg_graphing"],"skills":["apply_rate_of_change"],"patterns":["output_change_from_input_change"],"misconceptions":["multiplies_new_input_by_slope_only"],"isAutoGradable":true,"solution":"The input rises by 3, so the output rises by 4×3=12. Thus f(5)=7+12=19.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-functions","chapterTitle":"Functions and Graphs","sequence":25208},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_system_001","statement":"Which ordered pair solves x+y=7 and x-y=1?","answer":"(4,3)","answerType":"multiple_choice","choices":[{"value":"(3,4)","text":"(3,4)"},{"value":"(4,3)","text":"(4,3)"},{"value":"(5,2)","text":"(5,2)"},{"value":"(6,1)","text":"(6,1)"},{"value":"(7,0)","text":"(7,0)"}],"difficulty":1,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_systems","concepts":["alg_systems","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["test_system_solution"],"patterns":["satisfy_both_equations"],"misconceptions":["checks_only_one_equation"],"isAutoGradable":true,"solution":"For (4,3), 4+3=7 and 4-3=1, so it satisfies both equations.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-systems","chapterTitle":"Systems of Equations","sequence":25301},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_system_002","statement":"Solve x+y=10 and x-y=4. What is x?","answer":"7","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"10","text":"10"},{"value":"14","text":"14"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_systems","concepts":["alg_systems"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["elimination"],"patterns":["add_opposite_terms"],"misconceptions":["forgets_to_divide_sum"],"isAutoGradable":true,"solution":"Add the equations to get 2x=14, then divide by 2 to get x=7.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-systems","chapterTitle":"Systems of Equations","sequence":25302},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_system_003","statement":"Solve y=2x+1 and y=7. What is x?","answer":"3","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"7","text":"7"},{"value":"15","text":"15"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_systems","concepts":["alg_systems","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["substitution"],"patterns":["replace_equal_expression"],"misconceptions":["adds_equations_without_alignment"],"isAutoGradable":true,"solution":"Substitute y=7 into 7=2x+1. Then 2x=6 and x=3.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-systems","chapterTitle":"Systems of Equations","sequence":25303},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_system_004","statement":"Solve x+y=9 and 2x+y=13. What is y?","answer":"5","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"9","text":"9"},{"value":"13","text":"13"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_systems","concepts":["alg_systems"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["elimination_then_back_substitute"],"patterns":["subtract_equations"],"misconceptions":["reports_eliminated_variable"],"isAutoGradable":true,"solution":"Subtract the first equation from the second to get x=4. Then 4+y=9, so y=5.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-systems","chapterTitle":"Systems of Equations","sequence":25304},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_system_005","statement":"How many solutions does the system y=2x+3 and y=2x-4 have?","answer":"0","answerType":"multiple_choice","choices":[{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"infinitely many","text":"infinitely many"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_systems","concepts":["alg_systems","alg_graphing"],"prerequisiteConcepts":["alg_graphing"],"skills":["classify_parallel_system"],"patterns":["same_slope_different_intercept"],"misconceptions":["assumes_every_system_intersects"],"isAutoGradable":true,"solution":"The lines have equal slopes but different y-intercepts, so they are parallel and have 0 solutions.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-systems","chapterTitle":"Systems of Equations","sequence":25305},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_system_006","statement":"How many solutions does 2x+y=6 and 4x+2y=12 have?","answer":"infinitely many","answerType":"multiple_choice","choices":[{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"2","text":"2"},{"value":"12","text":"12"},{"value":"infinitely many","text":"infinitely many"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_systems","concepts":["alg_systems"],"prerequisiteConcepts":["prealg_simplification"],"skills":["classify_dependent_system"],"patterns":["equivalent_equations"],"misconceptions":["counts_equations_as_solutions"],"isAutoGradable":true,"solution":"The second equation is twice the first, so both describe the same line and have infinitely many common points.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-systems","chapterTitle":"Systems of Equations","sequence":25306},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_system_007","statement":"Adult tickets cost $8 and student tickets cost $5. Ten tickets cost $62. How many adult tickets were sold?","answer":"4","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"8","text":"8"}],"difficulty":3,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_systems","concepts":["alg_systems","prealg_word_to_equation"],"prerequisiteConcepts":["prealg_word_to_equation"],"skills":["model_ticket_system"],"patterns":["count_and_value_equations"],"misconceptions":["uses_one_equation_only"],"isAutoGradable":true,"solution":"Let a+s=10 and 8a+5s=62. Substitute s=10-a to get 3a=12, so a=4.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-systems","chapterTitle":"Systems of Equations","sequence":25307},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_factor_001","statement":"What is the greatest common factor of 6x and 9x^2?","answer":"3x","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"3x","text":"3x"},{"value":"6x","text":"6x"},{"value":"9x","text":"9x"},{"value":"54x^3","text":"54x^3"}],"difficulty":1,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_factoring","concepts":["alg_factoring","nt_gcd"],"prerequisiteConcepts":["nt_gcd"],"skills":["monomial_gcf"],"patterns":["shared_coefficient_and_variable"],"misconceptions":["omits_variable_factor"],"isAutoGradable":true,"solution":"The coefficient GCF is 3 and both terms contain at least one x, so the GCF is 3x.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-factoring","chapterTitle":"Factoring Foundations","sequence":25401},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_factor_002","statement":"Factor 8x+12 using the greatest common factor.","answer":"4(2x+3)","answerType":"multiple_choice","choices":[{"value":"2(4x+6)","text":"2(4x+6)"},{"value":"4(2x+3)","text":"4(2x+3)"},{"value":"4(2x+8)","text":"4(2x+8)"},{"value":"8(x+12)","text":"8(x+12)"},{"value":"12(8x+1)","text":"12(8x+1)"}],"difficulty":1,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_factoring","concepts":["alg_factoring","prealg_simplification"],"prerequisiteConcepts":["prealg_simplification"],"skills":["factor_gcf"],"patterns":["reverse_distribution"],"misconceptions":["does_not_use_greatest_factor"],"isAutoGradable":true,"solution":"The greatest common factor is 4. Dividing each term by 4 gives 4(2x+3).","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-factoring","chapterTitle":"Factoring Foundations","sequence":25402},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_factor_003","statement":"Factor x^2+7x+12.","answer":"(x+3)(x+4)","answerType":"multiple_choice","choices":[{"value":"(x+2)(x+6)","text":"(x+2)(x+6)"},{"value":"(x+3)(x+4)","text":"(x+3)(x+4)"},{"value":"(x-3)(x-4)","text":"(x-3)(x-4)"},{"value":"(x+1)(x+12)","text":"(x+1)(x+12)"},{"value":"x(x+7)+12","text":"x(x+7)+12"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_factoring","concepts":["alg_factoring","alg_quadratics"],"prerequisiteConcepts":["prealg_simplification"],"skills":["factor_monic_trinomial"],"patterns":["sum_and_product_pair"],"misconceptions":["finds_product_but_wrong_sum"],"isAutoGradable":true,"solution":"Find numbers with product 12 and sum 7: 3 and 4. Thus (x+3)(x+4).","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-factoring","chapterTitle":"Factoring Foundations","sequence":25403},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_factor_004","statement":"Factor x^2-9.","answer":"(x-3)(x+3)","answerType":"multiple_choice","choices":[{"value":"(x-9)(x+1)","text":"(x-9)(x+1)"},{"value":"(x-3)^2","text":"(x-3)^2"},{"value":"(x-3)(x+3)","text":"(x-3)(x+3)"},{"value":"x(x-9)","text":"x(x-9)"},{"value":"(x+3)^2","text":"(x+3)^2"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_factoring","concepts":["alg_factoring","alg_quadratics"],"prerequisiteConcepts":["arith_exponents"],"skills":["difference_of_squares"],"patterns":["a_squared_minus_b_squared"],"misconceptions":["uses_same_sign_factors"],"isAutoGradable":true,"solution":"Use a^2-b^2=(a-b)(a+b) with a=x and b=3.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-factoring","chapterTitle":"Factoring Foundations","sequence":25404},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_rem_v1_factor_005","statement":"Factor x^2-5x+6.","answer":"(x-2)(x-3)","answerType":"multiple_choice","choices":[{"value":"(x+2)(x+3)","text":"(x+2)(x+3)"},{"value":"(x-2)(x-3)","text":"(x-2)(x-3)"},{"value":"(x-1)(x-6)","text":"(x-1)(x-6)"},{"value":"(x+2)(x-3)","text":"(x+2)(x-3)"},{"value":"x(x-5)+6","text":"x(x-5)+6"}],"difficulty":2,"source":"algebra1_remediation_v1_original","primaryConcept":"alg_factoring","concepts":["alg_factoring","alg_quadratics"],"prerequisiteConcepts":["arith_integers"],"skills":["factor_signed_trinomial"],"patterns":["positive_product_negative_sum"],"misconceptions":["ignores_middle_term_sign"],"isAutoGradable":true,"solution":"The factors must multiply to 6 and add to -5, so use -2 and -3.","curriculum":{"course":"Algebra 1","theme":"Remediation Foundations","chapter":"algebra1-remediation-v1-factoring","chapterTitle":"Factoring Foundations","sequence":25405},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
