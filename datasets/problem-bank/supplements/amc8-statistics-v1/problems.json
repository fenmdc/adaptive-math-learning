[
  {"id":"amc8_stats_v1_mean_001","statement":"The mean of 7, 9, 12, 14, and x is 11. What is x?","answer":"13","answerType":"multiple_choice","choices":[{"value":"11","text":"11"},{"value":"12","text":"12"},{"value":"13","text":"13"},{"value":"14","text":"14"},{"value":"15","text":"15"}],"difficulty":2,"source":"amc8_statistics_v1_original","primaryConcept":"stats_mean","concepts":["stats_mean"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["recover_missing_value_from_mean"],"patterns":["mean_times_count_equals_total"],"misconceptions":["uses_mean_as_missing_value"],"isAutoGradable":true,"solution":"The five numbers total 5·11=55. The known numbers total 42, so x=55-42=13.","curriculum":{"course":"AMC8","theme":"Statistics","chapter":"amc8-statistics-v1","chapterTitle":"AMC8 Statistics Reviewed Practice","sequence":30601},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"remediationTargetId":"amc8-statistics-p0","reviewStatus":"reviewed"},
  {"id":"amc8_stats_v1_median_001","statement":"The five integers 4, 8, 10, 15, and n are listed in increasing order. If their median is 10, which value could n have?","answer":"18","answerType":"multiple_choice","choices":[{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"9","text":"9"},{"value":"10","text":"10"},{"value":"18","text":"18"}],"difficulty":3,"source":"amc8_statistics_v1_original","primaryConcept":"stats_median","concepts":["stats_median"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["preserve_order_for_median"],"patterns":["identify_middle_after_insertion"],"misconceptions":["computes_mean_instead_of_median"],"isAutoGradable":true,"solution":"For 10 to remain the middle value after n is included, n must be at least 10. Among the choices, 18 fits the stated increasing order without duplicating 10.","curriculum":{"course":"AMC8","theme":"Statistics","chapter":"amc8-statistics-v1","chapterTitle":"AMC8 Statistics Reviewed Practice","sequence":30602},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"remediationTargetId":"amc8-statistics-p0","reviewStatus":"reviewed"},
  {"id":"amc8_stats_v1_mode_001","statement":"The data set 2, 3, 3, 5, 7, 7, and k has exactly one mode, which is 3. Which value must k be?","answer":"3","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"8","text":"8"}],"difficulty":3,"source":"amc8_statistics_v1_original","primaryConcept":"stats_mode","concepts":["stats_mode"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["adjust_frequency_to_change_mode"],"patterns":["compare_value_frequencies"],"misconceptions":["chooses_current_most_frequent_value"],"isAutoGradable":true,"solution":"Currently 3 and 7 each occur twice. Setting k=3 makes 3 occur three times, so 3 becomes the unique mode.","curriculum":{"course":"AMC8","theme":"Statistics","chapter":"amc8-statistics-v1","chapterTitle":"AMC8 Statistics Reviewed Practice","sequence":30603},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"remediationTargetId":"amc8-statistics-p0","reviewStatus":"reviewed"},
  {"id":"amc8_stats_v1_range_001","statement":"A data set has range 18. Its smallest value is 7. After the largest value is increased by 4, what is the new range?","answer":"22","answerType":"multiple_choice","choices":[{"value":"14","text":"14"},{"value":"18","text":"18"},{"value":"21","text":"21"},{"value":"22","text":"22"},{"value":"29","text":"29"}],"difficulty":4,"source":"amc8_statistics_v1_original","primaryConcept":"stats_range","concepts":["stats_range"],"prerequisiteConcepts":["arith_integers"],"skills":["update_range_after_extreme_changes"],"patterns":["maximum_minus_minimum"],"misconceptions":["changes_minimum_with_maximum"],"isAutoGradable":true,"solution":"The original maximum is 7+18=25. The new maximum is 29, so the new range is 29-7=22.","curriculum":{"course":"AMC8","theme":"Statistics","chapter":"amc8-statistics-v1","chapterTitle":"AMC8 Statistics Reviewed Practice","sequence":30604},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"remediationTargetId":"amc8-statistics-p0","reviewStatus":"reviewed"},
  {"id":"amc8_stats_v1_mean_002","statement":"A class of 8 students has a mean quiz score of 76. After a ninth student joins, the mean becomes 78. What is the new student's score?","answer":"94","answerType":"multiple_choice","choices":[{"value":"78","text":"78"},{"value":"84","text":"84"},{"value":"90","text":"90"},{"value":"94","text":"94"},{"value":"96","text":"96"}],"difficulty":4,"source":"amc8_statistics_v1_original","primaryConcept":"stats_mean","concepts":["stats_mean"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["combine_mean_and_count"],"patterns":["new_total_minus_old_total"],"misconceptions":["adds_change_in_mean_to_old_mean"],"isAutoGradable":true,"solution":"The old total is 8·76=608 and the new total is 9·78=702. The new score is 702-608=94.","curriculum":{"course":"AMC8","theme":"Statistics","chapter":"amc8-statistics-v1","chapterTitle":"AMC8 Statistics Reviewed Practice","sequence":30605},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"remediationTargetId":"amc8-statistics-p0","reviewStatus":"reviewed"},
  {"id":"amc8_stats_v1_combined_001","statement":"Five distinct positive integers have mean 12, median 11, and range 16. The least value is 4, and the two greatest values are 15 and 20. What is the second least value?","answer":"10","answerType":"multiple_choice","choices":[{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"10","text":"10"},{"value":"11","text":"11"},{"value":"12","text":"12"}],"difficulty":5,"source":"amc8_statistics_v1_original","primaryConcept":"stats_mean","concepts":["stats_mean","stats_median","stats_range"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["combine_mean_median_and_range"],"patterns":["ordered_data_total_constraint"],"misconceptions":["uses_range_as_unknown_value"],"isAutoGradable":true,"solution":"The ordered values are 4, x, 11, 15, 20. Their total is 5·12=60, so x=60-(4+11+15+20)=10.","curriculum":{"course":"AMC8","theme":"Statistics","chapter":"amc8-statistics-v1","chapterTitle":"AMC8 Statistics Reviewed Practice","sequence":30606},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"remediationTargetId":"amc8-statistics-p0","reviewStatus":"reviewed"}
]
