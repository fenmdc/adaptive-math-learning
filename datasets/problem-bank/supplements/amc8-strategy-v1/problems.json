[
  {"id":"amc8_strategy_v1_prop_001","statement":"Three identical notebooks cost $18. At the same rate, how much do 7 notebooks cost?","answer":"$42","answerType":"multiple_choice","choices":[{"value":"$21","text":"$21"},{"value":"$36","text":"$36"},{"value":"$42","text":"$42"},{"value":"$54","text":"$54"},{"value":"$126","text":"$126"}],"difficulty":2,"source":"amc8_strategy_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["unit_rate"],"patterns":["unit_rate_then_scale"],"misconceptions":["uses_additive_difference"],"isAutoGradable":true,"solution":"Each notebook costs $18÷3=$6, so 7 cost 7×$6=$42.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-proportions","chapterTitle":"Proportional Transfer","sequence":26101},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_prop_002","statement":"The ratio of red marbles to blue marbles is 4:7. If there are 28 blue marbles, how many red marbles are there?","answer":"16","answerType":"multiple_choice","choices":[{"value":"12","text":"12"},{"value":"16","text":"16"},{"value":"21","text":"21"},{"value":"24","text":"24"},{"value":"49","text":"49"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["ratio_scaling"],"patterns":["match_corresponding_parts"],"misconceptions":["uses_total_parts_as_multiplier"],"isAutoGradable":true,"solution":"Blue scales from 7 to 28 by 4, so red scales from 4 to 16.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-proportions","chapterTitle":"Proportional Transfer","sequence":26102},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_prop_003","statement":"A rectangle has length-to-width ratio 5:3 and perimeter 64. What is its area?","answer":"240","answerType":"multiple_choice","choices":[{"value":"96","text":"96"},{"value":"160","text":"160"},{"value":"192","text":"192"},{"value":"240","text":"240"},{"value":"960","text":"960"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","geo_perimeter","geo_area"],"prerequisiteConcepts":["arith_ratios","geo_perimeter"],"skills":["ratio_dimension_model"],"patterns":["semiperimeter_as_ratio_sum"],"misconceptions":["sets_full_perimeter_equal_to_one_length_width_sum"],"isAutoGradable":true,"solution":"Let dimensions be 5k and 3k. Then 2(8k)=64, so k=4; the area is 20×12=240.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-proportions","chapterTitle":"Proportional Transfer","sequence":26103},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_prop_004","statement":"A class has boys and girls in the ratio 3:5. If the class has 32 students, how many are girls?","answer":"20","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"12","text":"12"},{"value":"20","text":"20"},{"value":"24","text":"24"},{"value":"25","text":"25"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["part_whole_ratio"],"patterns":["total_ratio_parts"],"misconceptions":["uses_five_eighths_of_wrong_total"],"isAutoGradable":true,"solution":"There are 3+5=8 equal parts; each part is 32÷8=4, so girls number 5×4=20.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-proportions","chapterTitle":"Proportional Transfer","sequence":26104},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_prop_005","statement":"A cyclist travels the same distance at 30 km/h and then at 60 km/h. What is the average speed for the whole trip?","answer":"40 km/h","answerType":"multiple_choice","choices":[{"value":"36 km/h","text":"36 km/h"},{"value":"40 km/h","text":"40 km/h"},{"value":"45 km/h","text":"45 km/h"},{"value":"48 km/h","text":"48 km/h"},{"value":"50 km/h","text":"50 km/h"}],"difficulty":5,"source":"amc8_strategy_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["equal_distance_average_speed"],"patterns":["total_distance_over_total_time"],"misconceptions":["averages_speeds_directly"],"isAutoGradable":true,"solution":"Use 60 km each way: times are 2 h and 1 h. Total distance 120 km over 3 h gives 40 km/h.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-proportions","chapterTitle":"Proportional Transfer","sequence":26105},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_prop_006","statement":"Six workers can finish a job in 10 days at the same constant rate. How many days would 15 workers need?","answer":"4","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"4","text":"4"},{"value":"6","text":"6"},{"value":"15","text":"15"},{"value":"25","text":"25"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["inverse_proportion"],"patterns":["constant_worker_days"],"misconceptions":["uses_direct_proportion"],"isAutoGradable":true,"solution":"The job requires 6×10=60 worker-days. With 15 workers, it takes 60÷15=4 days.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-proportions","chapterTitle":"Proportional Transfer","sequence":26106},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_ie_001","statement":"How many integers from 1 through 50 are divisible by 2 or by 5?","answer":"30","answerType":"multiple_choice","choices":[{"value":"25","text":"25"},{"value":"30","text":"30"},{"value":"35","text":"35"},{"value":"40","text":"40"},{"value":"45","text":"45"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion","nt_divisibility"],"prerequisiteConcepts":["nt_divisibility"],"skills":["inclusion_exclusion"],"patterns":["two_overlapping_sets"],"misconceptions":["double_counts_intersection"],"isAutoGradable":true,"solution":"There are 25 multiples of 2 and 10 of 5, with 5 multiples of 10 counted twice: 25+10-5=30.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-inclusion-exclusion","chapterTitle":"Inclusion and Exclusion","sequence":26201},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_ie_002","statement":"In a group, 18 students study math, 15 study science, and 7 study both. How many study at least one subject?","answer":"26","answerType":"multiple_choice","choices":[{"value":"22","text":"22"},{"value":"25","text":"25"},{"value":"26","text":"26"},{"value":"33","text":"33"},{"value":"40","text":"40"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion"],"prerequisiteConcepts":["counting_principle"],"skills":["two_set_union"],"patterns":["subtract_shared_members"],"misconceptions":["adds_groups_without_overlap_correction"],"isAutoGradable":true,"solution":"Add both groups and subtract the 7 counted twice: 18+15-7=26.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-inclusion-exclusion","chapterTitle":"Inclusion and Exclusion","sequence":26202},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_ie_003","statement":"How many integers from 1 through 60 are divisible by exactly one of 3 and 4?","answer":"25","answerType":"multiple_choice","choices":[{"value":"20","text":"20"},{"value":"25","text":"25"},{"value":"30","text":"30"},{"value":"35","text":"35"},{"value":"40","text":"40"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion","nt_lcm"],"prerequisiteConcepts":["nt_lcm"],"skills":["exclusive_or_counting"],"patterns":["subtract_intersection_twice"],"misconceptions":["subtracts_intersection_once"],"isAutoGradable":true,"solution":"Counts are 20 multiples of 3, 15 of 4, and 5 of 12. Exactly one gives 20+15-2×5=25.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-inclusion-exclusion","chapterTitle":"Inclusion and Exclusion","sequence":26203},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_ie_004","statement":"Of 40 students, 22 play chess, 18 play tennis, and 9 play both. How many play neither?","answer":"9","answerType":"multiple_choice","choices":[{"value":"0","text":"0"},{"value":"5","text":"5"},{"value":"9","text":"9"},{"value":"13","text":"13"},{"value":"31","text":"31"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion"],"prerequisiteConcepts":["counting_principle"],"skills":["union_then_complement"],"patterns":["neither_as_total_minus_union"],"misconceptions":["subtracts_both_groups_without_overlap"],"isAutoGradable":true,"solution":"At least one sport: 22+18-9=31. Neither: 40-31=9.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-inclusion-exclusion","chapterTitle":"Inclusion and Exclusion","sequence":26204},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_ie_005","statement":"How many three-digit strings formed from 1,2,3,4,5 contain at least one digit 5, if repetition is allowed?","answer":"61","answerType":"multiple_choice","choices":[{"value":"25","text":"25"},{"value":"36","text":"36"},{"value":"60","text":"60"},{"value":"61","text":"61"},{"value":"64","text":"64"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion","counting_principle"],"prerequisiteConcepts":["counting_principle"],"skills":["complement_counting"],"patterns":["total_minus_none"],"misconceptions":["counts_exactly_one_special_digit"],"isAutoGradable":true,"solution":"All strings: 5^3=125. Strings with no 5: 4^3=64. Therefore 125-64=61.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-inclusion-exclusion","chapterTitle":"Inclusion and Exclusion","sequence":26205},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_ie_006","statement":"How many integers from 1 through 100 are divisible by 2, 3, or 5?","answer":"74","answerType":"multiple_choice","choices":[{"value":"67","text":"67"},{"value":"70","text":"70"},{"value":"73","text":"73"},{"value":"74","text":"74"},{"value":"80","text":"80"}],"difficulty":5,"source":"amc8_strategy_v1_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion","nt_lcm"],"prerequisiteConcepts":["nt_lcm"],"skills":["three_set_inclusion_exclusion"],"patterns":["add_singles_subtract_pairs_add_triple"],"misconceptions":["omits_triple_intersection_correction"],"isAutoGradable":true,"solution":"50+33+20-16-10-6+3=74, using pairwise LCMs 6,10,15 and triple LCM 30.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-inclusion-exclusion","chapterTitle":"Inclusion and Exclusion","sequence":26206},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_sim_001","statement":"Two similar triangles have corresponding sides 6 and 9. If another side of the smaller triangle is 10, what is the corresponding larger side?","answer":"15","answerType":"multiple_choice","choices":[{"value":"12","text":"12"},{"value":"13","text":"13"},{"value":"15","text":"15"},{"value":"16","text":"16"},{"value":"19","text":"19"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","arith_proportions"],"prerequisiteConcepts":["arith_proportions"],"skills":["similarity_scale_factor"],"patterns":["corresponding_side_ratio"],"misconceptions":["uses_additive_side_change"],"isAutoGradable":true,"solution":"The scale factor is 9/6=3/2, so the larger side is 10×3/2=15.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-similarity","chapterTitle":"Similarity and Scale","sequence":26301},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_sim_002","statement":"A figure is enlarged by a scale factor of 3. If its original area is 12, what is its new area?","answer":"108","answerType":"multiple_choice","choices":[{"value":"36","text":"36"},{"value":"72","text":"72"},{"value":"96","text":"96"},{"value":"108","text":"108"},{"value":"324","text":"324"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","geo_area"],"prerequisiteConcepts":["geo_area"],"skills":["area_scale_factor"],"patterns":["square_linear_scale"],"misconceptions":["scales_area_linearly"],"isAutoGradable":true,"solution":"Area scales by the square of the length factor: 12×3^2=108.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-similarity","chapterTitle":"Similarity and Scale","sequence":26302},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_sim_003","statement":"Similar polygons have areas in the ratio 16:25. If the smaller perimeter is 32, what is the larger perimeter?","answer":"40","answerType":"multiple_choice","choices":[{"value":"36","text":"36"},{"value":"40","text":"40"},{"value":"42","text":"42"},{"value":"50","text":"50"},{"value":"80","text":"80"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","geo_area","geo_perimeter"],"prerequisiteConcepts":["geo_similarity"],"skills":["recover_length_ratio_from_area"],"patterns":["square_root_area_ratio"],"misconceptions":["uses_area_ratio_for_perimeter"],"isAutoGradable":true,"solution":"The linear ratio is √16:√25=4:5, so the larger perimeter is 32×5/4=40.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-similarity","chapterTitle":"Similarity and Scale","sequence":26303},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_sim_004","statement":"A 6-foot pole casts an 8-foot shadow. At the same time, a tree casts a 28-foot shadow. How tall is the tree?","answer":"21 feet","answerType":"multiple_choice","choices":[{"value":"18 feet","text":"18 feet"},{"value":"20 feet","text":"20 feet"},{"value":"21 feet","text":"21 feet"},{"value":"26 feet","text":"26 feet"},{"value":"34 feet","text":"34 feet"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","arith_proportions"],"prerequisiteConcepts":["arith_proportions"],"skills":["shadow_similarity"],"patterns":["constant_height_shadow_ratio"],"misconceptions":["adds_shadow_difference"],"isAutoGradable":true,"solution":"Height/shadow is constant: h/28=6/8, so h=21 feet.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-similarity","chapterTitle":"Similarity and Scale","sequence":26304},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_sim_005","statement":"In triangle ABC, D lies on AB and E lies on AC with DE parallel to BC. If AD/AB=2/5 and DE=6, what is BC?","answer":"15","answerType":"multiple_choice","choices":[{"value":"9","text":"9"},{"value":"12","text":"12"},{"value":"15","text":"15"},{"value":"18","text":"18"},{"value":"30","text":"30"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","arith_proportions"],"prerequisiteConcepts":["arith_proportions"],"skills":["parallel_segment_similarity"],"patterns":["small_to_large_scale"],"misconceptions":["reverses_scale_factor"],"isAutoGradable":true,"solution":"The small-to-large side ratio is 2/5, so 6/BC=2/5 and BC=15.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-similarity","chapterTitle":"Similarity and Scale","sequence":26305},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_sim_006","statement":"A right triangle with legs 9 and 12 is similar to a right triangle whose hypotenuse is 25. What is the shorter leg of the larger triangle?","answer":"15","answerType":"multiple_choice","choices":[{"value":"12","text":"12"},{"value":"15","text":"15"},{"value":"18","text":"18"},{"value":"20","text":"20"},{"value":"25","text":"25"}],"difficulty":5,"source":"amc8_strategy_v1_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","geo_pythagorean"],"prerequisiteConcepts":["geo_pythagorean"],"skills":["pythagorean_similarity_scale"],"patterns":["identify_base_triple_then_scale"],"misconceptions":["matches_hypotenuse_to_leg"],"isAutoGradable":true,"solution":"The first hypotenuse is 15, so the scale factor is 25/15=5/3. The shorter leg is 9×5/3=15.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-similarity","chapterTitle":"Similarity and Scale","sequence":26306},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_arc_001","statement":"A circle has radius 8. What is the length of a 90-degree arc?","answer":"4π","answerType":"multiple_choice","choices":[{"value":"2π","text":"2π"},{"value":"4π","text":"4π"},{"value":"8π","text":"8π"},{"value":"16π","text":"16π"},{"value":"32π","text":"32π"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"geo_arc_length","concepts":["geo_arc_length","geo_circles"],"prerequisiteConcepts":["geo_circles"],"skills":["fraction_of_circumference"],"patterns":["central_angle_over_full_turn"],"misconceptions":["uses_full_circumference"],"isAutoGradable":true,"solution":"The circumference is 16π, and 90° is one quarter of a circle, so the arc is 4π.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-arcs","chapterTitle":"Arc Length and Circular Motion","sequence":26401},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_arc_002","statement":"A semicircle has diameter 10. What is the length of its curved arc, not including the diameter?","answer":"5π","answerType":"multiple_choice","choices":[{"value":"2.5π","text":"2.5π"},{"value":"5π","text":"5π"},{"value":"10π","text":"10π"},{"value":"5π+10","text":"5π+10"},{"value":"10π+10","text":"10π+10"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"geo_arc_length","concepts":["geo_arc_length","geo_circles"],"prerequisiteConcepts":["geo_circles"],"skills":["semicircle_arc"],"patterns":["half_circumference"],"misconceptions":["includes_diameter_in_arc"],"isAutoGradable":true,"solution":"A full circle with diameter 10 has circumference 10π; half the circumference is 5π.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-arcs","chapterTitle":"Arc Length and Circular Motion","sequence":26402},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_arc_003","statement":"A circle has radius 6. What is the length of a 60-degree arc?","answer":"2π","answerType":"multiple_choice","choices":[{"value":"π","text":"π"},{"value":"2π","text":"2π"},{"value":"3π","text":"3π"},{"value":"6π","text":"6π"},{"value":"12π","text":"12π"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"geo_arc_length","concepts":["geo_arc_length","geo_circles"],"prerequisiteConcepts":["geo_circles"],"skills":["arc_fraction"],"patterns":["one_sixth_circumference"],"misconceptions":["uses_sector_area_formula"],"isAutoGradable":true,"solution":"The circumference is 12π, and 60/360=1/6, so the arc length is 2π.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-arcs","chapterTitle":"Arc Length and Circular Motion","sequence":26403},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_arc_004","statement":"A wheel has diameter 0.5 meter. How many complete revolutions does it make while traveling 10π meters?","answer":"20","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"10","text":"10"},{"value":"20","text":"20"},{"value":"40","text":"40"},{"value":"80","text":"80"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"geo_arc_length","concepts":["geo_arc_length","geo_circles","arith_proportions"],"prerequisiteConcepts":["geo_circles"],"skills":["circular_revolutions"],"patterns":["distance_divided_by_circumference"],"misconceptions":["uses_radius_as_circumference"],"isAutoGradable":true,"solution":"Each revolution covers circumference πd=0.5π meters. Thus 10π÷0.5π=20 revolutions.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-arcs","chapterTitle":"Arc Length and Circular Motion","sequence":26404},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_arc_005","statement":"An arc in a circle of radius 10 has length 5π. What is its central angle?","answer":"90°","answerType":"multiple_choice","choices":[{"value":"45°","text":"45°"},{"value":"60°","text":"60°"},{"value":"90°","text":"90°"},{"value":"120°","text":"120°"},{"value":"180°","text":"180°"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"geo_arc_length","concepts":["geo_arc_length","geo_circles","arith_proportions"],"prerequisiteConcepts":["geo_circles"],"skills":["recover_central_angle"],"patterns":["arc_to_circumference_fraction"],"misconceptions":["uses_arc_length_as_angle"],"isAutoGradable":true,"solution":"The circumference is 20π, so the arc is one quarter of it. One quarter of 360° is 90°.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-arcs","chapterTitle":"Arc Length and Circular Motion","sequence":26405},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_arc_006","statement":"A track consists of two straight segments of length 12 joined by two semicircles of diameter 8. What is the track's perimeter?","answer":"24+8π","answerType":"multiple_choice","choices":[{"value":"12+4π","text":"12+4π"},{"value":"24+4π","text":"24+4π"},{"value":"24+8π","text":"24+8π"},{"value":"40+8π","text":"40+8π"},{"value":"24+16π","text":"24+16π"}],"difficulty":5,"source":"amc8_strategy_v1_original","primaryConcept":"geo_arc_length","concepts":["geo_arc_length","geo_perimeter"],"prerequisiteConcepts":["geo_circles","geo_perimeter"],"skills":["stadium_perimeter"],"patterns":["two_semicircles_make_circle"],"misconceptions":["includes_internal_diameters"],"isAutoGradable":true,"solution":"The straight parts total 24. The two semicircles form a full circle of diameter 8, adding 8π, for 24+8π.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-arcs","chapterTitle":"Arc Length and Circular Motion","sequence":26406},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_range_001","statement":"What is the range of the data set 4, 9, 11, 15, 18?","answer":"14","answerType":"multiple_choice","choices":[{"value":"9","text":"9"},{"value":"11","text":"11"},{"value":"14","text":"14"},{"value":"18","text":"18"},{"value":"57","text":"57"}],"difficulty":2,"source":"amc8_strategy_v1_original","primaryConcept":"stats_range","concepts":["stats_range"],"prerequisiteConcepts":["arith_integers"],"skills":["range_max_minus_min"],"patterns":["extreme_values_only"],"misconceptions":["uses_maximum_as_range"],"isAutoGradable":true,"solution":"Range equals maximum minus minimum: 18-4=14.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-range","chapterTitle":"Range and Extreme Values","sequence":26501},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_range_002","statement":"The minimum of a data set is 7 and its range is 19. What is its maximum?","answer":"26","answerType":"multiple_choice","choices":[{"value":"12","text":"12"},{"value":"19","text":"19"},{"value":"26","text":"26"},{"value":"33","text":"33"},{"value":"133","text":"133"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"stats_range","concepts":["stats_range"],"prerequisiteConcepts":["arith_integers"],"skills":["recover_maximum"],"patterns":["maximum_equals_minimum_plus_range"],"misconceptions":["subtracts_range_from_minimum"],"isAutoGradable":true,"solution":"Maximum=minimum+range=7+19=26.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-range","chapterTitle":"Range and Extreme Values","sequence":26502},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_range_003","statement":"The data set 3, 5, 8, 12 has a new value 20 added. By how much does the range increase?","answer":"8","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"5","text":"5"},{"value":"8","text":"8"},{"value":"11","text":"11"},{"value":"17","text":"17"}],"difficulty":3,"source":"amc8_strategy_v1_original","primaryConcept":"stats_range","concepts":["stats_range"],"prerequisiteConcepts":["arith_integers"],"skills":["range_change"],"patterns":["new_extreme_value"],"misconceptions":["reports_new_range"],"isAutoGradable":true,"solution":"Old range is 12-3=9; new range is 20-3=17. The increase is 17-9=8.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-range","chapterTitle":"Range and Extreme Values","sequence":26503},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_range_004","statement":"Every value in a data set is multiplied by 3. If the original range is 8, what is the new range?","answer":"24","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"11","text":"11"},{"value":"16","text":"16"},{"value":"24","text":"24"},{"value":"64","text":"64"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"stats_range","concepts":["stats_range","arith_proportions"],"prerequisiteConcepts":["stats_range"],"skills":["scale_range"],"patterns":["difference_scales_multiplicatively"],"misconceptions":["adds_scale_factor_to_range"],"isAutoGradable":true,"solution":"Both maximum and minimum are tripled, so their difference and the range are also tripled: 3×8=24.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-range","chapterTitle":"Range and Extreme Values","sequence":26504},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_range_005","statement":"The five integers 6, 10, 13, x, 21 have range 18. What is the smallest possible value of x?","answer":"3","answerType":"multiple_choice","choices":[{"value":"0","text":"0"},{"value":"3","text":"3"},{"value":"6","text":"6"},{"value":"18","text":"18"},{"value":"24","text":"24"}],"difficulty":4,"source":"amc8_strategy_v1_original","primaryConcept":"stats_range","concepts":["stats_range","arith_integers"],"prerequisiteConcepts":["stats_range"],"skills":["recover_missing_extreme"],"patterns":["fixed_maximum_range"],"misconceptions":["subtracts_known_minimum_from_range"],"isAutoGradable":true,"solution":"To make x as small as possible it is the minimum, while 21 remains maximum. Then 21-x=18, so x=3.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-range","chapterTitle":"Range and Extreme Values","sequence":26505},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_strategy_v1_range_006","statement":"A set of four distinct integers has minimum 2, maximum 14, and mean 8. What is the greatest possible value of its second-largest integer?","answer":"13","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"10","text":"10"},{"value":"11","text":"11"},{"value":"12","text":"12"},{"value":"13","text":"13"}],"difficulty":5,"source":"amc8_strategy_v1_original","primaryConcept":"stats_range","concepts":["stats_range","stats_mean"],"prerequisiteConcepts":["stats_mean"],"skills":["optimize_internal_value"],"patterns":["fixed_sum_with_distinct_extremes"],"misconceptions":["ignores_distinct_integer_constraint"],"isAutoGradable":true,"solution":"The total is 32. After 2 and 14, the middle values sum to 16. To maximize the larger middle value, minimize the other distinct integer above 2 to 3, giving 13.","curriculum":{"course":"AMC8","theme":"Strategy Foundations","chapter":"amc8-strategy-v1-range","chapterTitle":"Range and Extreme Values","sequence":26506},"locale":{"language":"en-US","displayTrack":"AMC Competition","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
]
