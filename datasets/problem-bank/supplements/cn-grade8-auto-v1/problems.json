  {"id":"cn_grade8_auto_v1_linear_001","statement":"水池原有30升水，每分钟增加6升。水量达到120升需要多少分钟？","answer":"15","answerType":"multiple_choice","choices":[{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"15","text":"15"},{"value":"18","text":"18"},{"value":"20","text":"20"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_linear_function_application","primaryConcept":"alg_functions","concepts":["alg_functions","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["一次函数应用"],"patterns":["初始量加变化率乘时间"],"misconceptions":["忽略初始水量"],"isAutoGradable":true,"solution":"由30+6x=120，得x=15。","curriculum":{"course":"CN Junior High Math","theme":"八年级一次函数","chapter":"cn-grade8-auto-v1-linear","chapterTitle":"八年级一次函数客观练习","sequence":28801},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_linear_002","statement":"甲车在起点前方20 km处以60 km/h行驶，乙车从起点以80 km/h追赶。乙车多少小时后追上甲车？","answer":"1","answerType":"multiple_choice","choices":[{"value":"0.5","text":"0.5"},{"value":"1","text":"1"},{"value":"1.5","text":"1.5"},{"value":"2","text":"2"},{"value":"4","text":"4"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_linear_function_intersection","primaryConcept":"alg_functions","concepts":["alg_functions","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["函数交点"],"patterns":["追及路程相等"],"misconceptions":["用速度和计算"],"isAutoGradable":true,"solution":"相遇时80t=20+60t，解得t=1。","curriculum":{"course":"CN Junior High Math","theme":"八年级一次函数","chapter":"cn-grade8-auto-v1-linear","chapterTitle":"八年级一次函数客观练习","sequence":28802},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_linear_003","statement":"一次函数经过点(2,7)和(5,16)，它的表达式是？","answer":"y=3x+1","answerType":"multiple_choice","choices":[{"value":"y=2x+3","text":"y=2x+3"},{"value":"y=3x+1","text":"y=3x+1"},{"value":"y=3x-1","text":"y=3x-1"},{"value":"y=4x-1","text":"y=4x-1"},{"value":"y=5x-3","text":"y=5x-3"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_linear_function_table_model","primaryConcept":"alg_graphing","concepts":["alg_graphing","alg_functions"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["待定系数法"],"patterns":["两点确定直线"],"misconceptions":["斜率或截距计算错误"],"isAutoGradable":true,"solution":"斜率为(16-7)/(5-2)=3，代入(2,7)得截距1，所以y=3x+1。","curriculum":{"course":"CN Junior High Math","theme":"八年级一次函数","chapter":"cn-grade8-auto-v1-linear","chapterTitle":"八年级一次函数客观练习","sequence":28803},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_system_001","statement":"A果汁每升含糖80 g，B果汁每升含糖40 g。配成10 L、含糖560 g的果汁，需要A果汁多少升？","answer":"4","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"6","text":"6"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_linear_system_mixture","primaryConcept":"alg_systems","concepts":["alg_systems"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["方程组混合问题"],"patterns":["总量与总含量"],"misconceptions":["只使用体积条件"],"isAutoGradable":true,"solution":"设A为x升，则80x+40(10-x)=560，得x=4。","curriculum":{"course":"CN Junior High Math","theme":"八年级方程组应用","chapter":"cn-grade8-auto-v1-systems","chapterTitle":"八年级方程组客观练习","sequence":28901},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_system_002","statement":"成人票和学生票共40张，单价分别为30元和18元，共花888元。成人票有多少张？","answer":"14","answerType":"multiple_choice","choices":[{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"14","text":"14"},{"value":"16","text":"16"},{"value":"26","text":"26"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_linear_system_ticket_application","primaryConcept":"alg_systems","concepts":["alg_systems"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["方程组票价问题"],"patterns":["数量和与总价"],"misconceptions":["混淆两类票数量"],"isAutoGradable":true,"solution":"设成人票x张，30x+18(40-x)=888，得12x=168，x=14。","curriculum":{"course":"CN Junior High Math","theme":"八年级方程组应用","chapter":"cn-grade8-auto-v1-systems","chapterTitle":"八年级方程组客观练习","sequence":28902},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_system_003","statement":"两个数的和为46，较大的数比较小数的2倍少5。较大的数是多少？","answer":"29","answerType":"multiple_choice","choices":[{"value":"17","text":"17"},{"value":"23","text":"23"},{"value":"27","text":"27"},{"value":"29","text":"29"},{"value":"34","text":"34"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_linear_system_number_application","primaryConcept":"alg_systems","concepts":["alg_systems"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["数量关系建模"],"patterns":["和与倍数关系"],"misconceptions":["把少5写成加5"],"isAutoGradable":true,"solution":"设小数为x，大数为2x-5，x+2x-5=46，得x=17，大数为29。","curriculum":{"course":"CN Junior High Math","theme":"八年级方程组应用","chapter":"cn-grade8-auto-v1-systems","chapterTitle":"八年级方程组客观练习","sequence":28903},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_pythagorean_001","statement":"一架10米长的梯子靠在墙上，梯脚离墙6米。梯子顶端离地面多少米？","answer":"8","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"10","text":"10"},{"value":"16","text":"16"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_pythagorean_word_problem","primaryConcept":"geo_pythagorean","concepts":["geo_pythagorean"],"prerequisiteConcepts":["geo_triangles"],"skills":["勾股定理应用"],"patterns":["斜边平方减直角边平方"],"misconceptions":["直接用斜边减底边"],"isAutoGradable":true,"solution":"高度为√(10²-6²)=√64=8米。","curriculum":{"course":"CN Junior High Math","theme":"八年级勾股定理","chapter":"cn-grade8-auto-v1-pythagorean","chapterTitle":"八年级勾股定理客观练习","sequence":29001},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_pythagorean_002","statement":"三角形三边长为9、12、15。这个三角形是什么三角形？","answer":"直角三角形","answerType":"multiple_choice","choices":[{"value":"锐角三角形","text":"锐角三角形"},{"value":"直角三角形","text":"直角三角形"},{"value":"钝角三角形","text":"钝角三角形"},{"value":"等边三角形","text":"等边三角形"},{"value":"不能组成三角形","text":"不能组成三角形"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_pythagorean_converse","primaryConcept":"geo_pythagorean","concepts":["geo_pythagorean"],"prerequisiteConcepts":["geo_triangles"],"skills":["勾股定理逆定理"],"patterns":["两短边平方和等于最长边平方"],"misconceptions":["未把最长边作为斜边候选"],"isAutoGradable":true,"solution":"9²+12²=81+144=225=15²，所以是直角三角形。","curriculum":{"course":"CN Junior High Math","theme":"八年级勾股定理","chapter":"cn-grade8-auto-v1-pythagorean","chapterTitle":"八年级勾股定理客观练习","sequence":29002},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_pythagorean_003","statement":"坐标平面上A(1,2)、B(7,10)，线段AB的长度是多少？","answer":"10","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"14","text":"14"},{"value":"100","text":"100"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_pythagorean_coordinate_distance_variant","primaryConcept":"geo_pythagorean","concepts":["geo_pythagorean","geo_coordinate_geometry"],"prerequisiteConcepts":["geo_pythagorean"],"skills":["坐标距离"],"patterns":["横纵坐标差构成直角边"],"misconceptions":["直接相加坐标差"],"isAutoGradable":true,"solution":"横向差6、纵向差8，AB=√(6²+8²)=10。","curriculum":{"course":"CN Junior High Math","theme":"八年级勾股定理","chapter":"cn-grade8-auto-v1-pythagorean","chapterTitle":"八年级勾股定理客观练习","sequence":29003},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_coordinate_001","statement":"点A(-2,5)、B(6,1)的中点坐标是什么？","answer":"(2,3)","answerType":"multiple_choice","choices":[{"value":"(2,3)","text":"(2,3)"},{"value":"(4,6)","text":"(4,6)"},{"value":"(-4,4)","text":"(-4,4)"},{"value":"(2,2)","text":"(2,2)"},{"value":"(4,3)","text":"(4,3)"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_coordinate_midpoint_constructed","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry"],"prerequisiteConcepts":["arith_integers"],"skills":["中点坐标"],"patterns":["两个方向分别取平均"],"misconceptions":["坐标直接相加不除二"],"isAutoGradable":true,"solution":"中点为((-2+6)/2,(5+1)/2)=(2,3)。","curriculum":{"course":"CN Junior High Math","theme":"八年级坐标几何","chapter":"cn-grade8-auto-v1-coordinate","chapterTitle":"八年级坐标几何客观练习","sequence":29101},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_coordinate_002","statement":"坐标平面上A(1,2)、B(7,2)、C(7,5)、D(1,5)围成图形的面积是多少？","answer":"18","answerType":"multiple_choice","choices":[{"value":"9","text":"9"},{"value":"12","text":"12"},{"value":"18","text":"18"},{"value":"24","text":"24"},{"value":"36","text":"36"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_coordinate_rectangle_area","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry","geo_area"],"prerequisiteConcepts":["geo_area"],"skills":["坐标图形面积"],"patterns":["坐标差求边长"],"misconceptions":["把坐标值当边长"],"isAutoGradable":true,"solution":"长为7-1=6，宽为5-2=3，面积为18。","curriculum":{"course":"CN Junior High Math","theme":"八年级坐标几何","chapter":"cn-grade8-auto-v1-coordinate","chapterTitle":"八年级坐标几何客观练习","sequence":29102},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_coordinate_003","statement":"点P(-3,5)关于y轴对称的点是？","answer":"(3,5)","answerType":"multiple_choice","choices":[{"value":"(-3,-5)","text":"(-3,-5)"},{"value":"(3,-5)","text":"(3,-5)"},{"value":"(3,5)","text":"(3,5)"},{"value":"(5,-3)","text":"(5,-3)"},{"value":"(-5,3)","text":"(-5,3)"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_coordinate_reflection","primaryConcept":"geo_transformations","concepts":["geo_transformations","geo_coordinate_geometry"],"prerequisiteConcepts":["geo_coordinate_geometry"],"skills":["轴对称坐标"],"patterns":["关于y轴横坐标变号"],"misconceptions":["纵坐标也变号"],"isAutoGradable":true,"solution":"关于y轴对称时横坐标变号、纵坐标不变，得到(3,5)。","curriculum":{"course":"CN Junior High Math","theme":"八年级坐标几何","chapter":"cn-grade8-auto-v1-coordinate","chapterTitle":"八年级坐标几何客观练习","sequence":29103},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_congruence_001","statement":"两个三角形有两组对应边相等，且这两边的夹角相等。可以使用哪种全等判定？","answer":"SAS","answerType":"multiple_choice","choices":[{"value":"SSS","text":"SSS"},{"value":"SAS","text":"SAS"},{"value":"ASA","text":"ASA"},{"value":"AAS","text":"AAS"},{"value":"HL","text":"HL"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_congruence_proof_sas","primaryConcept":"geo_congruence","concepts":["geo_congruence"],"prerequisiteConcepts":["geo_triangles"],"skills":["全等三角形判定"],"patterns":["边角边"],"misconceptions":["忽略夹角条件"],"isAutoGradable":true,"solution":"两边及其夹角对应相等使用边角边，即SAS。","curriculum":{"course":"CN Junior High Math","theme":"八年级全等三角形","chapter":"cn-grade8-auto-v1-congruence","chapterTitle":"八年级全等客观练习","sequence":29201},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_congruence_002","statement":"两个直角三角形的斜边和一条对应直角边分别相等，可以使用哪种全等判定？","answer":"HL","answerType":"multiple_choice","choices":[{"value":"SSS","text":"SSS"},{"value":"SAS","text":"SAS"},{"value":"ASA","text":"ASA"},{"value":"AAS","text":"AAS"},{"value":"HL","text":"HL"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_congruence_hl_proof","primaryConcept":"geo_congruence","concepts":["geo_congruence"],"prerequisiteConcepts":["geo_triangles"],"skills":["直角三角形全等"],"patterns":["斜边直角边"],"misconceptions":["把HL用于任意三角形"],"isAutoGradable":true,"solution":"直角三角形的斜边和一条直角边对应相等，使用HL判定。","curriculum":{"course":"CN Junior High Math","theme":"八年级全等三角形","chapter":"cn-grade8-auto-v1-congruence","chapterTitle":"八年级全等客观练习","sequence":29202},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_congruence_003","statement":"已知△ABC≌△DEF，对应顺序为A对D、B对E、C对F。若AC=9 cm，则哪条边等于9 cm？","answer":"DF","answerType":"multiple_choice","choices":[{"value":"DE","text":"DE"},{"value":"DF","text":"DF"},{"value":"EF","text":"EF"},{"value":"AB","text":"AB"},{"value":"BC","text":"BC"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_congruence_cpctc_application","primaryConcept":"geo_congruence","concepts":["geo_congruence"],"prerequisiteConcepts":["geo_triangles"],"skills":["全等对应关系"],"patterns":["对应边相等"],"misconceptions":["忽略顶点对应顺序"],"isAutoGradable":true,"solution":"A对应D、C对应F，因此边AC对应DF，故DF=9 cm。","curriculum":{"course":"CN Junior High Math","theme":"八年级全等三角形","chapter":"cn-grade8-auto-v1-congruence","chapterTitle":"八年级全等客观练习","sequence":29203},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_similarity_001","statement":"△ABC中DE∥BC，D在AB上，E在AC上。AD=4，DB=6，AE=5，则AC等于多少？","answer":"12.5","answerType":"multiple_choice","choices":[{"value":"7.5","text":"7.5"},{"value":"10","text":"10"},{"value":"12.5","text":"12.5"},{"value":"15","text":"15"},{"value":"25","text":"25"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_similarity_application","primaryConcept":"geo_similarity","concepts":["geo_similarity"],"prerequisiteConcepts":["arith_ratios"],"skills":["相似三角形比例"],"patterns":["对应边成比例"],"misconceptions":["把DB当作AB"],"isAutoGradable":true,"solution":"AB=10，由AD/AB=AE/AC得4/10=5/AC，所以AC=12.5。","curriculum":{"course":"CN Junior High Math","theme":"八年级相似三角形","chapter":"cn-grade8-auto-v1-similarity","chapterTitle":"八年级相似客观练习","sequence":29301},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_similarity_002","statement":"两个相似三角形对应边长比为2:5，小三角形面积为12平方厘米。大三角形面积是多少？","answer":"75","answerType":"multiple_choice","choices":[{"value":"30","text":"30"},{"value":"48","text":"48"},{"value":"60","text":"60"},{"value":"75","text":"75"},{"value":"150","text":"150"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_similarity_scale_area","primaryConcept":"geo_similarity","concepts":["geo_similarity","geo_area"],"prerequisiteConcepts":["arith_ratios"],"skills":["相似图形面积比"],"patterns":["面积比等于边长比平方"],"misconceptions":["面积按边长比直接放大"],"isAutoGradable":true,"solution":"面积比为4:25，大面积=12×25/4=75。","curriculum":{"course":"CN Junior High Math","theme":"八年级相似三角形","chapter":"cn-grade8-auto-v1-similarity","chapterTitle":"八年级相似客观练习","sequence":29302},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_similarity_003","statement":"同一时刻，1.5米高竹竿的影长为2米，一棵树影长为8米。树高是多少米？","answer":"6","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"12","text":"12"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_similarity_shadow_height","primaryConcept":"geo_similarity","concepts":["geo_similarity"],"prerequisiteConcepts":["arith_ratios"],"skills":["相似测高"],"patterns":["高度影长比例相等"],"misconceptions":["直接相加影长差"],"isAutoGradable":true,"solution":"h/8=1.5/2，所以h=6米。","curriculum":{"course":"CN Junior High Math","theme":"八年级相似三角形","chapter":"cn-grade8-auto-v1-similarity","chapterTitle":"八年级相似客观练习","sequence":29303},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_stats_001","statement":"数据A为8、8、9、10、10，数据B为6、8、9、10、12，两组平均数相同。哪组数据波动更大？","answer":"B组","answerType":"multiple_choice","choices":[{"value":"A组","text":"A组"},{"value":"B组","text":"B组"},{"value":"两组相同","text":"两组相同"},{"value":"只看平均数无法比较","text":"只看平均数无法比较"},{"value":"两组都没有波动","text":"两组都没有波动"}],"difficulty":2,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_data_variation_explanation","primaryConcept":"stats_range","concepts":["stats_range","stats_mean"],"prerequisiteConcepts":["stats_mean"],"skills":["数据波动比较"],"patterns":["离均值距离与极差"],"misconceptions":["平均数相同就认为分布相同"],"isAutoGradable":true,"solution":"B组数值离平均数更远，极差6也大于A组的2，因此B组波动更大。","curriculum":{"course":"CN Junior High Math","theme":"八年级统计","chapter":"cn-grade8-auto-v1-statistics","chapterTitle":"八年级统计客观练习","sequence":29401},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_stats_002","statement":"五名同学平均身高160 cm，加入一名同学后六人平均身高162 cm。新同学身高是多少厘米？","answer":"172","answerType":"multiple_choice","choices":[{"value":"162","text":"162"},{"value":"168","text":"168"},{"value":"170","text":"170"},{"value":"172","text":"172"},{"value":"180","text":"180"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_statistics_mean_change","primaryConcept":"stats_mean","concepts":["stats_mean"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["平均数反求数据"],"patterns":["新旧总量之差"],"misconceptions":["只用两个平均数相减"],"isAutoGradable":true,"solution":"原总身高800，新总身高972，新同学身高972-800=172。","curriculum":{"course":"CN Junior High Math","theme":"八年级统计","chapter":"cn-grade8-auto-v1-statistics","chapterTitle":"八年级统计客观练习","sequence":29402},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_stats_003","statement":"课堂表现占20%、作业占30%、测试占50%，三项得分为90、80、76。综合成绩是多少？","answer":"80","answerType":"multiple_choice","choices":[{"value":"76","text":"76"},{"value":"80","text":"80"},{"value":"82","text":"82"},{"value":"84","text":"84"},{"value":"246","text":"246"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_statistics_weighted_average_scores","primaryConcept":"stats_mean","concepts":["stats_mean"],"prerequisiteConcepts":["arith_percentages"],"skills":["加权平均数"],"patterns":["分项乘权重后求和"],"misconceptions":["直接求普通平均数"],"isAutoGradable":true,"solution":"90×0.2+80×0.3+76×0.5=18+24+38=80。","curriculum":{"course":"CN Junior High Math","theme":"八年级统计","chapter":"cn-grade8-auto-v1-statistics","chapterTitle":"八年级统计客观练习","sequence":29403},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade8_auto_v1_probability_001","statement":"袋中有2个红球、1个蓝球和1个白球，不放回任取2个球，取到一红一蓝的概率是多少？","answer":"1/3","answerType":"multiple_choice","choices":[{"value":"1/6","text":"1/6"},{"value":"1/4","text":"1/4"},{"value":"1/3","text":"1/3"},{"value":"1/2","text":"1/2"},{"value":"2/3","text":"2/3"}],"difficulty":3,"source":"cn_grade8_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g8_probability_tree","primaryConcept":"prob_conditional","concepts":["prob_conditional"],"prerequisiteConcepts":["arith_fractions"],"skills":["不放回概率"],"patterns":["分类或组合计数"],"misconceptions":["把两个红球视为同一个结果"],"isAutoGradable":true,"solution":"6组等可能无序球对中，有2组是一红一蓝，概率2/6=1/3。","curriculum":{"course":"CN Junior High Math","theme":"八年级概率","chapter":"cn-grade8-auto-v1-probability","chapterTitle":"八年级概率客观练习","sequence":29501},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"八年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
