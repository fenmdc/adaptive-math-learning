[
  {"id":"prealg_anchor_v1_mixed_001","statement":"Convert the mixed number 2 3/4 to an improper fraction in simplest form.","answer":"11/4","answerType":"multiple_choice","choices":[{"value":"5/4","text":"5/4"},{"value":"8/4","text":"8/4"},{"value":"10/4","text":"10/4"},{"value":"11/4","text":"11/4"},{"value":"14/4","text":"14/4"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"arith_mixed_numbers","concepts":["arith_mixed_numbers","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["convert_mixed_to_improper"],"patterns":["whole_times_denominator_plus_numerator"],"misconceptions":["adds_whole_number_to_numerator_only"],"isAutoGradable":true,"solution":"Multiply 2 by 4 and add 3: (2*4+3)/4=11/4.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-mixed-numbers","chapterTitle":"Mixed Numbers","sequence":26101},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_mixed_002","statement":"What is 5 1/6 + 2 2/3, written as a mixed number in simplest form?","answer":"7 5/6","answerType":"multiple_choice","choices":[{"value":"7 1/2","text":"7 1/2"},{"value":"7 3/6","text":"7 3/6"},{"value":"7 5/6","text":"7 5/6"},{"value":"8 1/6","text":"8 1/6"},{"value":"8 5/6","text":"8 5/6"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"arith_mixed_numbers","concepts":["arith_mixed_numbers","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["add_mixed_numbers"],"patterns":["common_denominator"],"misconceptions":["adds_denominators"],"isAutoGradable":true,"solution":"Rewrite 2/3 as 4/6, then add: 5 1/6+2 4/6=7 5/6.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-mixed-numbers","chapterTitle":"Mixed Numbers","sequence":26102},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_mixed_003","statement":"Compute 4 1/2 divided by 1 1/8 and write the result in simplest form.","answer":"4","answerType":"multiple_choice","choices":[{"value":"1/4","text":"1/4"},{"value":"2","text":"2"},{"value":"4","text":"4"},{"value":"5 1/16","text":"5 1/16"},{"value":"8","text":"8"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"arith_mixed_numbers","concepts":["arith_mixed_numbers","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["divide_mixed_numbers"],"patterns":["convert_then_multiply_reciprocal"],"misconceptions":["divides_numerators_and_denominators_without_converting"],"isAutoGradable":true,"solution":"Convert to 9/2 and 9/8. Then (9/2)*(8/9)=4.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-mixed-numbers","chapterTitle":"Mixed Numbers","sequence":26103},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_roots_001","statement":"What is the principal square root of 144?","answer":"12","answerType":"multiple_choice","choices":[{"value":"-12","text":"-12"},{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"14","text":"14"},{"value":"72","text":"72"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"arith_roots","concepts":["arith_roots"],"prerequisiteConcepts":["arith_exponents"],"skills":["evaluate_perfect_square_root"],"patterns":["inverse_of_squaring"],"misconceptions":["returns_both_positive_and_negative_values"],"isAutoGradable":true,"solution":"Because 12^2=144, the principal square root is 12.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-square-roots","chapterTitle":"Square Roots","sequence":26201},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_roots_002","statement":"Between which two consecutive integers does the square root of 70 lie?","answer":"8 and 9","answerType":"multiple_choice","choices":[{"value":"6 and 7","text":"6 and 7"},{"value":"7 and 8","text":"7 and 8"},{"value":"8 and 9","text":"8 and 9"},{"value":"9 and 10","text":"9 and 10"},{"value":"34 and 36","text":"34 and 36"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"arith_roots","concepts":["arith_roots"],"prerequisiteConcepts":["arith_exponents"],"skills":["estimate_square_root"],"patterns":["bound_by_perfect_squares"],"misconceptions":["halves_the_radicand"],"isAutoGradable":true,"solution":"Since 8^2=64 and 9^2=81, sqrt(70) lies between 8 and 9.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-square-roots","chapterTitle":"Square Roots","sequence":26202},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_roots_003","statement":"Simplify the square root of 72 by removing the greatest perfect-square factor.","answer":"6sqrt(2)","answerType":"multiple_choice","choices":[{"value":"3sqrt(2)","text":"3sqrt(2)"},{"value":"6sqrt(2)","text":"6sqrt(2)"},{"value":"6sqrt(3)","text":"6sqrt(3)"},{"value":"12sqrt(2)","text":"12sqrt(2)"},{"value":"36sqrt(2)","text":"36sqrt(2)"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"arith_roots","concepts":["arith_roots","nt_factorization"],"prerequisiteConcepts":["arith_exponents","nt_factorization"],"skills":["simplify_radical"],"patterns":["extract_perfect_square"],"misconceptions":["splits_additively_inside_radical"],"isAutoGradable":true,"solution":"Factor 72 as 36*2. Then sqrt(72)=sqrt(36)*sqrt(2)=6sqrt(2).","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-square-roots","chapterTitle":"Square Roots","sequence":26203},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_divisibility_001","statement":"Which number is divisible by 9?","answer":"4563","answerType":"multiple_choice","choices":[{"value":"4513","text":"4513"},{"value":"4523","text":"4523"},{"value":"4543","text":"4543"},{"value":"4563","text":"4563"},{"value":"4573","text":"4573"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_divisibility","concepts":["nt_divisibility"],"prerequisiteConcepts":["arith_integers"],"skills":["apply_divisibility_by_nine"],"patterns":["digit_sum_test"],"misconceptions":["checks_last_digit_only"],"isAutoGradable":true,"solution":"The digits of 4563 sum to 18, which is divisible by 9.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-divisibility","chapterTitle":"Divisibility","sequence":26301},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_divisibility_002","statement":"The three-digit number 37d has ones digit d. What is the smallest digit d that makes it divisible by 3?","answer":"2","answerType":"multiple_choice","choices":[{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"6","text":"6"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_divisibility","concepts":["nt_divisibility"],"prerequisiteConcepts":["arith_integers"],"skills":["complete_digit_for_divisibility"],"patterns":["digit_sum_congruence"],"misconceptions":["treats_placeholder_as_a_factor"],"isAutoGradable":true,"solution":"The digit sum is 10+d. The smallest digit making it a multiple of 3 is d=2, giving 12.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-divisibility","chapterTitle":"Divisibility","sequence":26302},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_divisibility_003","statement":"Which number is divisible by 6 but not divisible by 12?","answer":"414","answerType":"multiple_choice","choices":[{"value":"408","text":"408"},{"value":"414","text":"414"},{"value":"420","text":"420"},{"value":"432","text":"432"},{"value":"444","text":"444"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_divisibility","concepts":["nt_divisibility"],"prerequisiteConcepts":["arith_integers"],"skills":["combine_divisibility_tests"],"patterns":["divisible_by_two_and_three"],"misconceptions":["assumes_divisible_by_six_implies_divisible_by_twelve"],"isAutoGradable":true,"solution":"414 is even and its digits sum to 9, so it is divisible by 6. It is not divisible by 4, so it is not divisible by 12.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-divisibility","chapterTitle":"Divisibility","sequence":26303},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_primes_001","statement":"Which of the following numbers is prime?","answer":"47","answerType":"multiple_choice","choices":[{"value":"39","text":"39"},{"value":"45","text":"45"},{"value":"47","text":"47"},{"value":"49","text":"49"},{"value":"51","text":"51"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_primes","concepts":["nt_primes"],"prerequisiteConcepts":["nt_divisibility"],"skills":["identify_prime"],"patterns":["test_prime_divisors_up_to_square_root"],"misconceptions":["assumes_every_odd_number_is_prime"],"isAutoGradable":true,"solution":"47 is not divisible by any prime at or below sqrt(47): 2, 3, or 5.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-primes","chapterTitle":"Prime Numbers","sequence":26401},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_primes_002","statement":"What is the smallest prime factor of 221?","answer":"13","answerType":"multiple_choice","choices":[{"value":"7","text":"7"},{"value":"11","text":"11"},{"value":"13","text":"13"},{"value":"17","text":"17"},{"value":"221","text":"221"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_primes","concepts":["nt_primes","nt_factorization"],"prerequisiteConcepts":["nt_divisibility"],"skills":["find_smallest_prime_factor"],"patterns":["trial_division_by_primes"],"misconceptions":["stops_after_testing_small_single_digit_primes"],"isAutoGradable":true,"solution":"221 is not divisible by 2, 3, 5, 7, or 11, and 221=13*17. The smallest prime factor is 13.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-primes","chapterTitle":"Prime Numbers","sequence":26402},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_primes_003","statement":"How many prime numbers are strictly between 20 and 40?","answer":"4","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"7","text":"7"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_primes","concepts":["nt_primes"],"prerequisiteConcepts":["nt_divisibility"],"skills":["enumerate_primes_in_interval"],"patterns":["eliminate_composites_systematically"],"misconceptions":["counts_one_or_composite_odd_numbers"],"isAutoGradable":true,"solution":"The primes are 23, 29, 31, and 37, so there are 4.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-primes","chapterTitle":"Prime Numbers","sequence":26403},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_factor_001","statement":"What is the prime factorization of 84?","answer":"2^2*3*7","answerType":"multiple_choice","choices":[{"value":"2*42","text":"2*42"},{"value":"2^2*3*7","text":"2^2*3*7"},{"value":"2*3*14","text":"2*3*14"},{"value":"4*21","text":"4*21"},{"value":"6*14","text":"6*14"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_factorization","concepts":["nt_factorization","nt_primes"],"prerequisiteConcepts":["nt_primes"],"skills":["prime_factorization"],"patterns":["factor_tree_to_prime_factors"],"misconceptions":["stops_with_composite_factors"],"isAutoGradable":true,"solution":"84=2*42=2*2*21=2^2*3*7, and every factor is prime.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-factorization","chapterTitle":"Prime Factorization","sequence":26501},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_factor_002","statement":"Which number has prime factorization 2^3*3^2?","answer":"72","answerType":"multiple_choice","choices":[{"value":"36","text":"36"},{"value":"48","text":"48"},{"value":"54","text":"54"},{"value":"72","text":"72"},{"value":"108","text":"108"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_factorization","concepts":["nt_factorization","arith_exponents"],"prerequisiteConcepts":["arith_exponents"],"skills":["evaluate_prime_factorization"],"patterns":["evaluate_powers_then_multiply"],"misconceptions":["multiplies_exponents_instead_of_powers"],"isAutoGradable":true,"solution":"2^3*3^2=8*9=72.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-factorization","chapterTitle":"Prime Factorization","sequence":26502},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_factor_003","statement":"What is the greatest perfect-square factor of 180?","answer":"36","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"9","text":"9"},{"value":"18","text":"18"},{"value":"36","text":"36"},{"value":"90","text":"90"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_factorization","concepts":["nt_factorization","arith_exponents"],"prerequisiteConcepts":["nt_primes","arith_exponents"],"skills":["identify_square_factor"],"patterns":["pair_prime_exponents"],"misconceptions":["chooses_largest_factor_without_checking_square"],"isAutoGradable":true,"solution":"180=2^2*3^2*5. The paired prime factors form 2^2*3^2=36, the greatest square factor.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-factorization","chapterTitle":"Prime Factorization","sequence":26503},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_gcd_001","statement":"What is the greatest common divisor of 18 and 30?","answer":"6","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"6","text":"6"},{"value":"9","text":"9"},{"value":"90","text":"90"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_gcd","concepts":["nt_gcd","nt_factorization"],"prerequisiteConcepts":["nt_factorization"],"skills":["compute_gcd"],"patterns":["shared_prime_factors"],"misconceptions":["confuses_gcd_with_lcm"],"isAutoGradable":true,"solution":"18=2*3^2 and 30=2*3*5. Their shared prime product is 2*3=6.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-gcd","chapterTitle":"Greatest Common Divisor","sequence":26601},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_gcd_002","statement":"What is the greatest common divisor of 48 and 72?","answer":"24","answerType":"multiple_choice","choices":[{"value":"6","text":"6"},{"value":"12","text":"12"},{"value":"18","text":"18"},{"value":"24","text":"24"},{"value":"144","text":"144"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_gcd","concepts":["nt_gcd","nt_factorization"],"prerequisiteConcepts":["nt_factorization"],"skills":["compute_gcd_from_factorization"],"patterns":["minimum_shared_exponents"],"misconceptions":["uses_all_prime factors_from_both_numbers"],"isAutoGradable":true,"solution":"48=2^4*3 and 72=2^3*3^2. Use the smaller shared exponents: 2^3*3=24.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-gcd","chapterTitle":"Greatest Common Divisor","sequence":26602},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_gcd_003","statement":"An 84 cm by 126 cm rectangle is tiled with the largest possible congruent square tiles. What is each tile's side length?","answer":"42 cm","answerType":"multiple_choice","choices":[{"value":"14 cm","text":"14 cm"},{"value":"21 cm","text":"21 cm"},{"value":"36 cm","text":"36 cm"},{"value":"42 cm","text":"42 cm"},{"value":"84 cm","text":"84 cm"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_gcd","concepts":["nt_gcd","geo_area"],"prerequisiteConcepts":["nt_factorization"],"skills":["model_gcd_with_tiling"],"patterns":["largest_equal_unit_divides_both_dimensions"],"misconceptions":["uses_difference_or_smaller_dimension"],"isAutoGradable":true,"solution":"The tile side must divide both dimensions. gcd(84,126)=42, so the largest side is 42 cm.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-gcd","chapterTitle":"Greatest Common Divisor","sequence":26603},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_lcm_001","statement":"What is the least common multiple of 6 and 8?","answer":"24","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"12","text":"12"},{"value":"14","text":"14"},{"value":"24","text":"24"},{"value":"48","text":"48"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_lcm","concepts":["nt_lcm","nt_factorization"],"prerequisiteConcepts":["nt_factorization"],"skills":["compute_lcm"],"patterns":["first_shared_positive_multiple"],"misconceptions":["confuses_lcm_with_gcd"],"isAutoGradable":true,"solution":"Multiples of 6 are 6,12,18,24; multiples of 8 are 8,16,24. The first common multiple is 24.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-lcm","chapterTitle":"Least Common Multiple","sequence":26701},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_lcm_002","statement":"What is the smallest positive number divisible by both 12 and 18?","answer":"36","answerType":"multiple_choice","choices":[{"value":"6","text":"6"},{"value":"24","text":"24"},{"value":"30","text":"30"},{"value":"36","text":"36"},{"value":"216","text":"216"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_lcm","concepts":["nt_lcm","nt_factorization"],"prerequisiteConcepts":["nt_factorization"],"skills":["compute_lcm_from_factorization"],"patterns":["maximum_prime_exponents"],"misconceptions":["multiplies_numbers_without_removing_shared_factors"],"isAutoGradable":true,"solution":"12=2^2*3 and 18=2*3^2. Use the greatest exponents: 2^2*3^2=36.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-lcm","chapterTitle":"Least Common Multiple","sequence":26702},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_lcm_003","statement":"Two buses leave together at 8:00 AM. One returns every 15 minutes and the other every 20 minutes. When will they next leave together?","answer":"9:00 AM","answerType":"multiple_choice","choices":[{"value":"8:20 AM","text":"8:20 AM"},{"value":"8:30 AM","text":"8:30 AM"},{"value":"8:45 AM","text":"8:45 AM"},{"value":"9:00 AM","text":"9:00 AM"},{"value":"9:20 AM","text":"9:20 AM"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"nt_lcm","concepts":["nt_lcm"],"prerequisiteConcepts":["nt_factorization"],"skills":["model_repeating_cycles_with_lcm"],"patterns":["first_repeated_alignment"],"misconceptions":["adds_cycle_lengths"],"isAutoGradable":true,"solution":"lcm(15,20)=60 minutes. Sixty minutes after 8:00 AM is 9:00 AM.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-lcm","chapterTitle":"Least Common Multiple","sequence":26703},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_pyth_001","statement":"A right triangle has legs of length 6 and 8. What is the hypotenuse length?","answer":"10","answerType":"multiple_choice","choices":[{"value":"7","text":"7"},{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"14","text":"14"},{"value":"100","text":"100"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"geo_pythagorean","concepts":["geo_pythagorean","geo_triangles"],"prerequisiteConcepts":["arith_roots"],"skills":["find_hypotenuse"],"patterns":["a_squared_plus_b_squared_equals_c_squared"],"misconceptions":["adds_side_lengths_directly"],"isAutoGradable":true,"solution":"c^2=6^2+8^2=36+64=100, so c=10.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-pythagorean","chapterTitle":"Pythagorean Theorem","sequence":26801},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_pyth_002","statement":"A right triangle has hypotenuse 13 and one leg 5. What is the other leg?","answer":"12","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"14","text":"14"},{"value":"18","text":"18"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"geo_pythagorean","concepts":["geo_pythagorean","geo_triangles"],"prerequisiteConcepts":["arith_roots"],"skills":["find_missing_leg"],"patterns":["subtract_leg_square_from_hypotenuse_square"],"misconceptions":["treats_hypotenuse_as_a_leg"],"isAutoGradable":true,"solution":"The missing leg squared is 13^2-5^2=169-25=144, so the leg is 12.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-pythagorean","chapterTitle":"Pythagorean Theorem","sequence":26802},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_pyth_003","statement":"What is the diagonal length of a rectangle with side lengths 9 and 12?","answer":"15","answerType":"multiple_choice","choices":[{"value":"13","text":"13"},{"value":"15","text":"15"},{"value":"18","text":"18"},{"value":"21","text":"21"},{"value":"225","text":"225"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"geo_pythagorean","concepts":["geo_pythagorean","geo_perimeter"],"prerequisiteConcepts":["arith_roots"],"skills":["apply_pythagorean_to_rectangle"],"patterns":["diagonal_forms_right_triangle"],"misconceptions":["uses_perimeter_formula"],"isAutoGradable":true,"solution":"The diagonal is the hypotenuse: d^2=9^2+12^2=225, so d=15.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-pythagorean","chapterTitle":"Pythagorean Theorem","sequence":26803},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_circle_001","statement":"Using pi in the answer, what is the circumference of a circle with radius 7?","answer":"14pi","answerType":"multiple_choice","choices":[{"value":"7pi","text":"7pi"},{"value":"14pi","text":"14pi"},{"value":"28pi","text":"28pi"},{"value":"49pi","text":"49pi"},{"value":"98pi","text":"98pi"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"geo_circles","concepts":["geo_circles"],"prerequisiteConcepts":["geo_perimeter"],"skills":["circle_circumference"],"patterns":["two_pi_times_radius"],"misconceptions":["uses_area_formula"],"isAutoGradable":true,"solution":"Circumference C=2*pi*r=2*pi*7=14pi.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-circles","chapterTitle":"Circles","sequence":26901},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_circle_002","statement":"Using pi in the answer, what is the area of a circle with diameter 10?","answer":"25pi","answerType":"multiple_choice","choices":[{"value":"5pi","text":"5pi"},{"value":"10pi","text":"10pi"},{"value":"20pi","text":"20pi"},{"value":"25pi","text":"25pi"},{"value":"100pi","text":"100pi"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"geo_circles","concepts":["geo_circles","geo_area"],"prerequisiteConcepts":["geo_area"],"skills":["circle_area_from_diameter"],"patterns":["halve_diameter_then_square_radius"],"misconceptions":["uses_diameter_as_radius"],"isAutoGradable":true,"solution":"The radius is 10/2=5. Area A=pi*r^2=25pi.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-circles","chapterTitle":"Circles","sequence":26902},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_circle_003","statement":"A semicircle has radius 4. What is its perimeter, including the straight diameter?","answer":"8+4pi","answerType":"multiple_choice","choices":[{"value":"4pi","text":"4pi"},{"value":"8pi","text":"8pi"},{"value":"4+8pi","text":"4+8pi"},{"value":"8+4pi","text":"8+4pi"},{"value":"16+8pi","text":"16+8pi"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"geo_circles","concepts":["geo_circles","geo_perimeter"],"prerequisiteConcepts":["geo_perimeter"],"skills":["semicircle_perimeter"],"patterns":["half_circumference_plus_diameter"],"misconceptions":["omits_straight_diameter"],"isAutoGradable":true,"solution":"Half the circumference is pi*r=4pi, and the diameter is 8. The perimeter is 8+4pi.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-circles","chapterTitle":"Circles","sequence":26903},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v1_count_001","statement":"A student can choose 1 of 3 shirts and 1 of 4 pairs of pants. How many outfits are possible?","answer":"12","answerType":"multiple_choice","choices":[{"value":"7","text":"7"},{"value":"8","text":"8"},{"value":"12","text":"12"},{"value":"16","text":"16"},{"value":"24","text":"24"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"counting_principle","concepts":["counting_principle"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["apply_multiplication_principle"],"patterns":["independent_sequential_choices"],"misconceptions":["adds_choice_counts"],"isAutoGradable":true,"solution":"Each of 3 shirts can be paired with 4 pants, so 3*4=12 outfits.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-counting","chapterTitle":"Counting Principle","sequence":27001},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_count_002","statement":"How many three-digit codes can be made from digits 0 through 4 if repetition is allowed?","answer":"125","answerType":"multiple_choice","choices":[{"value":"15","text":"15"},{"value":"25","text":"25"},{"value":"60","text":"60"},{"value":"100","text":"100"},{"value":"125","text":"125"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"counting_principle","concepts":["counting_principle"],"prerequisiteConcepts":["arith_exponents"],"skills":["count_repeated_codes"],"patterns":["same_number_of_choices_per_position"],"misconceptions":["treats_code_as_number_and_forbids_leading_zero"],"isAutoGradable":true,"solution":"A code may begin with 0. Each of 3 positions has 5 choices, so 5^3=125.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-counting","chapterTitle":"Counting Principle","sequence":27002},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v1_count_003","statement":"There are 3 routes from A to B and 2 routes from B to C. There are also 4 direct routes from A to C. How many routes from A to C are possible?","answer":"10","answerType":"multiple_choice","choices":[{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"9","text":"9"},{"value":"10","text":"10"},{"value":"24","text":"24"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v1_original","primaryConcept":"counting_principle","concepts":["counting_principle"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["combine_product_and_sum_rules"],"patterns":["multiply_within_route_type_add_across_types"],"misconceptions":["multiplies_all_route_counts"],"isAutoGradable":true,"solution":"Routes through B total 3*2=6. Add the 4 direct routes to get 6+4=10.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors","chapter":"prealgebra-anchors-v1-counting","chapterTitle":"Counting Principle","sequence":27003},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
