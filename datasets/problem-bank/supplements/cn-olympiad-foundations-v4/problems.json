[
  {"id":"cn_oly_found_v4_nt_001","statement":"大于 50 的最小质数是多少？","answer":"53","answerType":"multiple_choice","choices":[{"label":"A","value":"51","text":"51"},{"label":"B","value":"52","text":"52"},{"label":"C","value":"53","text":"53"},{"label":"D","value":"55","text":"55"},{"label":"E","value":"57","text":"57"}],"difficulty":2,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_primes","concepts":["nt_primes","nt_divisibility"],"prerequisiteConcepts":["nt_divisibility"],"skills":["prime_testing"],"patterns":["test_small_prime_divisors"],"misconceptions":["accepts_odd_composite"],"isAutoGradable":true,"solution":"依次检查 51、52、53：51 能被 3 整除，52 是偶数；53 不被不超过其平方根的质数 2、3、5、7 整除，所以答案是 53。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"质数、因数与整除结构","sequence":23101,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Foundation","problemType":"next_prime","estimatedTimeSeconds":75},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_nt_002","statement":"正整数 2^3×3^2×5 一共有多少个正因数？","answer":"24","answerType":"multiple_choice","choices":[{"label":"A","value":"10","text":"10"},{"label":"B","value":"18","text":"18"},{"label":"C","value":"20","text":"20"},{"label":"D","value":"24","text":"24"},{"label":"E","value":"30","text":"30"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_factorization","concepts":["nt_factorization","nt_primes"],"prerequisiteConcepts":["nt_primes"],"skills":["divisor_counting"],"patterns":["exponent_choice_product"],"misconceptions":["multiplies_exponents_without_adding_one"],"isAutoGradable":true,"solution":"每个因数中 2、3、5 的指数分别可选 0 至 3、0 至 2、0 至 1，共有 (3+1)(2+1)(1+1)=24 种。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"质数、因数与整除结构","sequence":23102,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"divisor_count","estimatedTimeSeconds":100},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_nt_003","statement":"221 可以写成两个质数的乘积，其中较大的质数是多少？","answer":"17","answerType":"multiple_choice","choices":[{"label":"A","value":"11","text":"11"},{"label":"B","value":"13","text":"13"},{"label":"C","value":"17","text":"17"},{"label":"D","value":"19","text":"19"},{"label":"E","value":"221","text":"221"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_primes","concepts":["nt_primes","nt_factorization"],"prerequisiteConcepts":["nt_primes"],"skills":["prime_factorization","factor_pair_search"],"patterns":["test_primes_to_square_root"],"misconceptions":["reports_smaller_prime_factor"],"isAutoGradable":true,"solution":"尝试不超过 √221 的质数，发现 221÷13=17，所以 221=13×17；较大的质数是 17。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"质数、因数与整除结构","sequence":23103,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"semiprime_factorization","estimatedTimeSeconds":125},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_nt_004","statement":"84 和 126 的最大公因数是多少？","answer":"42","answerType":"multiple_choice","choices":[{"label":"A","value":"14","text":"14"},{"label":"B","value":"21","text":"21"},{"label":"C","value":"28","text":"28"},{"label":"D","value":"42","text":"42"},{"label":"E","value":"252","text":"252"}],"difficulty":2,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_gcd","concepts":["nt_gcd","nt_factorization"],"prerequisiteConcepts":["nt_factorization"],"skills":["greatest_common_divisor"],"patterns":["shared_prime_powers"],"misconceptions":["confuses_gcd_with_lcm"],"isAutoGradable":true,"solution":"84=2^2×3×7，126=2×3^2×7。取共同质因数的较小指数，得到 2×3×7=42。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"公因数与公倍数应用","sequence":23104,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Foundation","problemType":"gcd_by_factorization","estimatedTimeSeconds":85},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_nt_005","statement":"两盏灯同时亮起后，一盏每 12 秒亮一次，另一盏每 18 秒亮一次。至少再过多少秒它们会同时亮起？","answer":"36","answerType":"multiple_choice","choices":[{"label":"A","value":"6","text":"6"},{"label":"B","value":"18","text":"18"},{"label":"C","value":"24","text":"24"},{"label":"D","value":"30","text":"30"},{"label":"E","value":"36","text":"36"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_lcm","concepts":["nt_lcm","nt_gcd"],"prerequisiteConcepts":["nt_factorization"],"skills":["least_common_multiple","periodic_alignment"],"patterns":["first_shared_event"],"misconceptions":["uses_gcd_for_repeating_events"],"isAutoGradable":true,"solution":"再次同时亮起的时间必须同时是 12 和 18 的倍数。最小公倍数为 36，所以至少再过 36 秒。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"公因数与公倍数应用","sequence":23105,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"periodic_lcm","estimatedTimeSeconds":95},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_nt_006","statement":"正整数 n 满足 gcd(n,48)=12 且 lcm(n,48)=240。n 是多少？","answer":"60","answerType":"multiple_choice","choices":[{"label":"A","value":"12","text":"12"},{"label":"B","value":"24","text":"24"},{"label":"C","value":"48","text":"48"},{"label":"D","value":"60","text":"60"},{"label":"E","value":"120","text":"120"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_gcd","concepts":["nt_gcd","nt_lcm","nt_factorization"],"prerequisiteConcepts":["nt_gcd","nt_lcm"],"skills":["reconstruct_from_gcd_lcm"],"patterns":["gcd_times_lcm_product"],"misconceptions":["chooses_lcm_divided_by_gcd"],"isAutoGradable":true,"solution":"对两个正整数有 n×48=gcd(n,48)×lcm(n,48)=12×240，因此 n=12×240÷48=60。检验可得 gcd(60,48)=12，lcm(60,48)=240。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"公因数与公倍数应用","sequence":23106,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"recover_number_from_gcd_lcm","estimatedTimeSeconds":135},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_nt_007","statement":"四位数 347□ 能被 9 整除，方框中应填哪个数字？","answer":"4","answerType":"multiple_choice","choices":[{"label":"A","value":"2","text":"2"},{"label":"B","value":"3","text":"3"},{"label":"C","value":"4","text":"4"},{"label":"D","value":"5","text":"5"},{"label":"E","value":"9","text":"9"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_divisibility","concepts":["nt_divisibility"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["digit_sum_divisibility"],"patterns":["missing_digit"],"misconceptions":["uses_last_digit_test_for_nine"],"isAutoGradable":true,"solution":"已知数字和为 3+4+7=14。要使总和成为 9 的倍数，只能补 4，使数字和为 18。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"数字与整除结构","sequence":23107,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"missing_divisibility_digit","estimatedTimeSeconds":80},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_nt_008","statement":"至少给 2026 加上多少，所得的数才能同时被 5 和 9 整除？","answer":"44","answerType":"multiple_choice","choices":[{"label":"A","value":"4","text":"4"},{"label":"B","value":"9","text":"9"},{"label":"C","value":"19","text":"19"},{"label":"D","value":"44","text":"44"},{"label":"E","value":"45","text":"45"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_divisibility","concepts":["nt_divisibility","nt_lcm","nt_remainders"],"prerequisiteConcepts":["nt_lcm"],"skills":["next_common_multiple"],"patterns":["distance_to_next_multiple"],"misconceptions":["adds_the_lcm_instead_of_gap"],"isAutoGradable":true,"solution":"同时被 5 和 9 整除就是被 45 整除。2026=45×45+1，下一个 45 的倍数是 2070，需要加 2070-2026=44。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"数字与整除结构","sequence":23108,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"next_common_multiple","estimatedTimeSeconds":115},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_nt_009","statement":"五位回文数 3a7a3 能被 9 整除，数字 a 是多少？","answer":"7","answerType":"multiple_choice","choices":[{"label":"A","value":"2","text":"2"},{"label":"B","value":"4","text":"4"},{"label":"C","value":"5","text":"5"},{"label":"D","value":"7","text":"7"},{"label":"E","value":"9","text":"9"}],"difficulty":5,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"nt_divisibility","concepts":["nt_divisibility","nt_remainders"],"prerequisiteConcepts":["nt_divisibility"],"skills":["digit_sum_equation"],"patterns":["repeated_unknown_digit"],"misconceptions":["counts_repeated_digit_once"],"isAutoGradable":true,"solution":"数字和为 3+a+7+a+3=13+2a。a 是 0 至 9 的数字时，13+2a 在 13 至 31 之间，唯一可能的 9 的倍数是 27，所以 2a=14，a=7。","curriculum":{"course":"CN Olympiad Lite","theme":"数论启蒙","chapter":"cn-olympiad-foundations-v4-number-theory","chapterTitle":"数字与整除结构","sequence":23109,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Honors","problemType":"palindrome_divisibility","estimatedTimeSeconds":145},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_001","statement":"用数字 1、2、3、4 组成没有重复数字的两位偶数，共有多少个？","answer":"6","answerType":"multiple_choice","choices":[{"label":"A","value":"4","text":"4"},{"label":"B","value":"6","text":"6"},{"label":"C","value":"8","text":"8"},{"label":"D","value":"10","text":"10"},{"label":"E","value":"12","text":"12"}],"difficulty":2,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_casework","concepts":["counting_casework","counting_principle"],"prerequisiteConcepts":["counting_principle"],"skills":["casework","even_last_digit"],"patterns":["classify_by_units_digit"],"misconceptions":["allows_repeated_digits"],"isAutoGradable":true,"solution":"个位只能选 2 或 4，有 2 种；十位从剩余 3 个数字中选，有 3 种。因此共有 2×3=6 个。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23201,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Foundation","problemType":"two_digit_even_count","estimatedTimeSeconds":75},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_002","statement":"非负整数有序数对 (x,y) 满足 x+y=7，且 x 为偶数。这样的数对有多少个？","answer":"4","answerType":"multiple_choice","choices":[{"label":"A","value":"3","text":"3"},{"label":"B","value":"4","text":"4"},{"label":"C","value":"5","text":"5"},{"label":"D","value":"7","text":"7"},{"label":"E","value":"8","text":"8"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_casework","concepts":["counting_casework","counting_principle"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["systematic_listing","parity_filter"],"patterns":["enumerate_one_variable"],"misconceptions":["excludes_zero"],"isAutoGradable":true,"solution":"x 可取 0、2、4、6，分别唯一确定 y 为 7、5、3、1，所以共有 4 个有序数对。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23202,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"parity_restricted_solutions","estimatedTimeSeconds":90},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_003","statement":"在方格线上从 (0,0) 走到 (4,3)，每步只能向右或向上，并且必须经过 (2,1)。共有多少条不同路线？","answer":"18","answerType":"multiple_choice","choices":[{"label":"A","value":"9","text":"9"},{"label":"B","value":"12","text":"12"},{"label":"C","value":"15","text":"15"},{"label":"D","value":"18","text":"18"},{"label":"E","value":"35","text":"35"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_casework","concepts":["counting_casework","counting_combinations"],"prerequisiteConcepts":["counting_combinations"],"skills":["lattice_path_counting","split_at_required_point"],"patterns":["multiply_path_segments"],"misconceptions":["adds_segment_counts"],"isAutoGradable":true,"solution":"到 (2,1) 需 2 次向右、1 次向上，有 C(3,1)=3 条；再到 (4,3) 需 2 次向右、2 次向上，有 C(4,2)=6 条。两段独立组合，共 3×6=18 条。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23203,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"required_point_lattice_paths","estimatedTimeSeconds":135},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_004","statement":"从 1 到 30 的正整数中，能被 2 或 3 整除的数有多少个？","answer":"20","answerType":"multiple_choice","choices":[{"label":"A","value":"15","text":"15"},{"label":"B","value":"20","text":"20"},{"label":"C","value":"25","text":"25"},{"label":"D","value":"30","text":"30"},{"label":"E","value":"35","text":"35"}],"difficulty":2,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion","nt_divisibility"],"prerequisiteConcepts":["nt_divisibility"],"skills":["inclusion_exclusion"],"patterns":["two_overlapping_sets"],"misconceptions":["double_counts_common_multiples"],"isAutoGradable":true,"solution":"2 的倍数有 15 个，3 的倍数有 10 个，同时是两者倍数即 6 的倍数有 5 个。总数为 15+10-5=20。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23204,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Foundation","problemType":"basic_inclusion_exclusion","estimatedTimeSeconds":85},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_005","statement":"从包括甲、乙在内的 7 名同学中选 3 人，要求甲、乙至少有一人入选，共有多少种选法？","answer":"25","answerType":"multiple_choice","choices":[{"label":"A","value":"10","text":"10"},{"label":"B","value":"20","text":"20"},{"label":"C","value":"25","text":"25"},{"label":"D","value":"30","text":"30"},{"label":"E","value":"35","text":"35"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion","counting_combinations"],"prerequisiteConcepts":["counting_combinations"],"skills":["complement_counting"],"patterns":["at_least_one_of_two"],"misconceptions":["counts_only_exactly_one"],"isAutoGradable":true,"solution":"全部选法有 C(7,3)=35 种；甲、乙都不入选时，从其余 5 人选 3 人，有 C(5,3)=10 种。因此合格选法有 35-10=25 种。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23205,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"committee_complement","estimatedTimeSeconds":105},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_006","statement":"从 1 到 200 的正整数中，恰好能被 4、6 中的一个整除的数有多少个？","answer":"51","answerType":"multiple_choice","choices":[{"label":"A","value":"35","text":"35"},{"label":"B","value":"51","text":"51"},{"label":"C","value":"67","text":"67"},{"label":"D","value":"83","text":"83"},{"label":"E","value":"99","text":"99"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_inclusion_exclusion","concepts":["counting_inclusion_exclusion","nt_lcm","nt_divisibility"],"prerequisiteConcepts":["nt_lcm"],"skills":["exclusive_or_counting"],"patterns":["subtract_intersection_twice"],"misconceptions":["subtracts_intersection_once"],"isAutoGradable":true,"solution":"4 的倍数有 50 个，6 的倍数有 33 个，两者共有的 12 的倍数有 16 个。恰好属于一个集合需从两边都排除交集，所以有 50+33-2×16=51 个。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23206,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"exclusive_divisibility","estimatedTimeSeconds":135},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_007","statement":"一个抽屉里有红、蓝、绿三种颜色的袜子。至少任取多少只，才能保证有两只颜色相同？","answer":"4","answerType":"multiple_choice","choices":[{"label":"A","value":"2","text":"2"},{"label":"B","value":"3","text":"3"},{"label":"C","value":"4","text":"4"},{"label":"D","value":"5","text":"5"},{"label":"E","value":"6","text":"6"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_pigeonhole","concepts":["counting_pigeonhole"],"prerequisiteConcepts":["counting_principle"],"skills":["pigeonhole_principle"],"patterns":["one_more_than_categories"],"misconceptions":["uses_number_of_categories"],"isAutoGradable":true,"solution":"最不利时先取到红、蓝、绿各一只，3 只仍没有同色的一对；第 4 只必与前三只中的一种颜色相同。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23207,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"basic_pigeonhole","estimatedTimeSeconds":80},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_008","statement":"同时掷两枚公平的六面骰子，点数和为 8 的概率是多少？","answer":"5/36","answerType":"multiple_choice","choices":[{"label":"A","value":"1/6","text":"1/6"},{"label":"B","value":"5/36","text":"5/36"},{"label":"C","value":"1/4","text":"1/4"},{"label":"D","value":"7/36","text":"7/36"},{"label":"E","value":"5/12","text":"5/12"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_probability","concepts":["counting_probability","counting_casework"],"prerequisiteConcepts":["counting_principle"],"skills":["sample_space_counting","enumerate_ordered_pairs"],"patterns":["two_dice_sum"],"misconceptions":["treats_possible_sums_as_equally_likely"],"isAutoGradable":true,"solution":"两枚骰子共有 6×6=36 个等可能有序结果。和为 8 的结果是 (2,6)、(3,5)、(4,4)、(5,3)、(6,2)，共 5 个，所以概率为 5/36。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23208,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"dice_sum_probability","estimatedTimeSeconds":120},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_count_009","statement":"在一个边长为 1 的正方形内部任取 10 个点。一定能找到两点，使它们之间的距离不超过多少？","answer":"√2/3","answerType":"multiple_choice","choices":[{"label":"A","value":"1/3","text":"1/3"},{"label":"B","value":"√2/3","text":"√2/3"},{"label":"C","value":"1/2","text":"1/2"},{"label":"D","value":"√2/2","text":"√2/2"},{"label":"E","value":"1","text":"1"}],"difficulty":5,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"counting_pigeonhole","concepts":["counting_pigeonhole","geo_pythagorean"],"prerequisiteConcepts":["counting_pigeonhole","geo_pythagorean"],"skills":["geometric_pigeonhole","partition_region"],"patterns":["more_points_than_cells"],"misconceptions":["uses_cell_side_instead_of_diagonal"],"isAutoGradable":true,"solution":"把正方形分成 3×3 共 9 个边长为 1/3 的小正方形。10 个点中至少两点落在同一小正方形内；该小正方形内最远距离是对角线 √[(1/3)^2+(1/3)^2]=√2/3。","curriculum":{"course":"CN Olympiad Lite","theme":"计数启蒙","chapter":"cn-olympiad-foundations-v4-counting","chapterTitle":"分类讨论、容斥与抽屉原理","sequence":23209,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Honors","problemType":"geometric_pigeonhole","estimatedTimeSeconds":170},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_001","statement":"一个等腰三角形的顶角为 40°，每个底角是多少度？","answer":"70°","answerType":"multiple_choice","choices":[{"label":"A","value":"40°","text":"40°"},{"label":"B","value":"60°","text":"60°"},{"label":"C","value":"70°","text":"70°"},{"label":"D","value":"80°","text":"80°"},{"label":"E","value":"140°","text":"140°"}],"difficulty":2,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_angles","concepts":["geo_angles","geo_triangle_angles","geo_triangles"],"prerequisiteConcepts":["geo_triangle_angles"],"skills":["isosceles_triangle_angles"],"patterns":["equal_base_angles"],"misconceptions":["divides_vertex_angle_by_two"],"isAutoGradable":true,"solution":"三角形内角和为 180°，两个相等的底角之和为 180°-40°=140°，每个底角为 140°÷2=70°。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23301,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Foundation","problemType":"isosceles_base_angle","estimatedTimeSeconds":75},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_002","statement":"两条平行线被一条直线所截，一对同旁内角中一个角为 112°，另一个角是多少度？","answer":"68°","answerType":"multiple_choice","choices":[{"label":"A","value":"58°","text":"58°"},{"label":"B","value":"68°","text":"68°"},{"label":"C","value":"78°","text":"78°"},{"label":"D","value":"112°","text":"112°"},{"label":"E","value":"248°","text":"248°"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["parallel_line_angles"],"patterns":["same_side_interior_supplement"],"misconceptions":["treats_same_side_angles_as_equal"],"isAutoGradable":true,"solution":"平行线的同旁内角互补，所以另一个角为 180°-112°=68°。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23302,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"parallel_line_supplement","estimatedTimeSeconds":85},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_003","statement":"三角形的一个外角为 125°，与它不相邻的两个内角之比为 2:3。较大的内角是多少度？","answer":"75°","answerType":"multiple_choice","choices":[{"label":"A","value":"50°","text":"50°"},{"label":"B","value":"60°","text":"60°"},{"label":"C","value":"70°","text":"70°"},{"label":"D","value":"75°","text":"75°"},{"label":"E","value":"125°","text":"125°"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_angles","concepts":["geo_angles","geo_triangle_angles","arith_ratios"],"prerequisiteConcepts":["geo_triangle_angles","arith_ratios"],"skills":["exterior_angle_theorem","ratio_partition"],"patterns":["split_angle_sum_by_ratio"],"misconceptions":["splits_one_hundred_eighty_by_ratio"],"isAutoGradable":true,"solution":"三角形外角等于两个不相邻内角之和，所以这两个角共 125°。按 2:3 分成 5 份，每份 25°，较大角为 3×25°=75°。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23303,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"exterior_angle_ratio","estimatedTimeSeconds":120},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_004","statement":"两个相似三角形的一组对应边长分别为 6 和 9。较小三角形的另一条边长为 10，则较大三角形的对应边长是多少？","answer":"15","answerType":"multiple_choice","choices":[{"label":"A","value":"12","text":"12"},{"label":"B","value":"13","text":"13"},{"label":"C","value":"15","text":"15"},{"label":"D","value":"16","text":"16"},{"label":"E","value":"19","text":"19"}],"difficulty":2,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","arith_proportions"],"prerequisiteConcepts":["arith_proportions"],"skills":["similarity_scale_factor"],"patterns":["corresponding_side_proportion"],"misconceptions":["adds_side_difference"],"isAutoGradable":true,"solution":"较大与较小三角形的边长比为 9:6=3:2，所以对应边长为 10×3/2=15。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23304,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Foundation","problemType":"similar_side_length","estimatedTimeSeconds":80},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_005","statement":"同一时刻，一根 1.5 米高的木杆影长 2 米；一棵树的影长 8 米。树高多少米？","answer":"6","answerType":"multiple_choice","choices":[{"label":"A","value":"4","text":"4"},{"label":"B","value":"6","text":"6"},{"label":"C","value":"8","text":"8"},{"label":"D","value":"10","text":"10"},{"label":"E","value":"12","text":"12"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","arith_proportions"],"prerequisiteConcepts":["arith_proportions"],"skills":["shadow_similarity"],"patterns":["constant_height_shadow_ratio"],"misconceptions":["adds_shadow_difference"],"isAutoGradable":true,"solution":"同一时刻太阳光线方向相同，高与影长成比例。设树高为 h，则 h/8=1.5/2，所以 h=8×1.5÷2=6 米。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23305,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"shadow_similarity","estimatedTimeSeconds":95},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_006","statement":"两个相似三角形的面积比为 25:49。较小三角形的周长为 30，较大三角形的周长是多少？","answer":"42","answerType":"multiple_choice","choices":[{"label":"A","value":"35","text":"35"},{"label":"B","value":"40","text":"40"},{"label":"C","value":"42","text":"42"},{"label":"D","value":"49","text":"49"},{"label":"E","value":"58.8","text":"58.8"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","geo_area","geo_perimeter"],"prerequisiteConcepts":["geo_similarity"],"skills":["recover_scale_from_area_ratio"],"patterns":["square_root_area_ratio"],"misconceptions":["uses_area_ratio_as_length_ratio"],"isAutoGradable":true,"solution":"相似图形面积比等于边长比的平方，所以边长比和周长比为 √25:√49=5:7。较大周长为 30×7/5=42。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23306,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"perimeter_from_area_ratio","estimatedTimeSeconds":120},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_007","statement":"一个圆的直径为 14，它的周长是多少？","answer":"14π","answerType":"multiple_choice","choices":[{"label":"A","value":"7π","text":"7π"},{"label":"B","value":"14π","text":"14π"},{"label":"C","value":"28π","text":"28π"},{"label":"D","value":"49π","text":"49π"},{"label":"E","value":"196π","text":"196π"}],"difficulty":3,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_circles","concepts":["geo_circles","geo_perimeter"],"prerequisiteConcepts":["geo_perimeter"],"skills":["circle_circumference"],"patterns":["circumference_from_diameter"],"misconceptions":["uses_radius_formula_with_diameter"],"isAutoGradable":true,"solution":"圆周长 C=πd。直径 d=14，所以周长为 14π。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23307,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Bridge","problemType":"circumference_from_diameter","estimatedTimeSeconds":75},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_008","statement":"在边长为 4 的正方形内，以一个顶点为圆心、边长为半径画四分之一圆。正方形内但四分之一圆外的面积是多少？","answer":"16-4π","answerType":"multiple_choice","choices":[{"label":"A","value":"4π","text":"4π"},{"label":"B","value":"8-2π","text":"8-2π"},{"label":"C","value":"16-4π","text":"16-4π"},{"label":"D","value":"16-8π","text":"16-8π"},{"label":"E","value":"16-16π","text":"16-16π"}],"difficulty":4,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_area","concepts":["geo_area","geo_circles"],"prerequisiteConcepts":["geo_circles"],"skills":["composite_area","quarter_circle_area"],"patterns":["outer_area_minus_inner_area"],"misconceptions":["subtracts_full_circle_area"],"isAutoGradable":true,"solution":"正方形面积为 4^2=16；四分之一圆面积为 π×4^2÷4=4π。因此所求面积为 16-4π。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23308,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Transfer","problemType":"square_minus_quarter_circle","estimatedTimeSeconds":110},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_oly_found_v4_geo_009","statement":"一个运动场由长 10、宽 6 的长方形和接在两条宽边外侧的两个半圆组成。运动场外边界的周长是多少？","answer":"20+6π","answerType":"multiple_choice","choices":[{"label":"A","value":"16+6π","text":"16+6π"},{"label":"B","value":"20+3π","text":"20+3π"},{"label":"C","value":"20+6π","text":"20+6π"},{"label":"D","value":"32+6π","text":"32+6π"},{"label":"E","value":"20+12π","text":"20+12π"}],"difficulty":5,"source":"cn_olympiad_foundations_v4_original","primaryConcept":"geo_circles","concepts":["geo_circles","geo_perimeter"],"prerequisiteConcepts":["geo_circles","geo_perimeter"],"skills":["stadium_perimeter","combine_semicircles"],"patterns":["two_semicircles_make_circle"],"misconceptions":["includes_internal_diameters"],"isAutoGradable":true,"solution":"外边界的直线部分只有两条长边，共 2×10=20。两个直径为 6 的半圆合成一个整圆，弧长共 6π，所以总周长为 20+6π。","curriculum":{"course":"CN Olympiad Lite","theme":"几何思维","chapter":"cn-olympiad-foundations-v4-geometry","chapterTitle":"角度、相似与组合图形","sequence":23309,"sourceCollection":"cn_olympiad_foundations_v4"},"taxonomy":{"version":"v4","layer":"Honors","problemType":"stadium_perimeter","estimatedTimeSeconds":135},"locale":{"language":"zh-CN","curriculumSystem":"Olympiad","region":"CN","displayTrack":"中文奥数 Lite","gradeBand":"小学-初中","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
]
