  {"id":"cn_senior_gap_v1_exp_001","statement":"指数函数 f(x)=2^x 的图像必定经过下列哪个点？","answer":"(0,1)","answerType":"multiple_choice","choices":[{"value":"(-1,0)","text":"(-1,0)"},{"value":"(0,0)","text":"(0,0)"},{"value":"(0,1)","text":"(0,1)"},{"value":"(1,1)","text":"(1,1)"},{"value":"(2,1)","text":"(2,1)"}],"difficulty":3,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_exponential_functions","concepts":["alg_exponential_functions","alg_functions"],"prerequisiteConcepts":["arith_exponents"],"skills":["指数函数定点"],"patterns":["零指数"],"misconceptions":["把零指数误认为零"],"isAutoGradable":true,"solution":"令x=0，得到f(0)=2^0=1，因此图像经过(0,1)。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-exponential","chapterTitle":"指数函数","sequence":30101},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_exp_002","statement":"若指数函数 f(x)=a^x（a>0且a≠1）在实数范围内单调递减，则a的取值范围是？","answer":"0<a<1","answerType":"multiple_choice","choices":[{"value":"a<0","text":"a<0"},{"value":"0<a<1","text":"0<a<1"},{"value":"a=1","text":"a=1"},{"value":"a>1","text":"a>1"},{"value":"a≥1","text":"a≥1"}],"difficulty":4,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_exponential_functions","concepts":["alg_exponential_functions","alg_functions"],"prerequisiteConcepts":["alg_functions"],"skills":["指数函数单调性"],"patterns":["底数区间判定"],"misconceptions":["混淆增长与衰减"],"isAutoGradable":true,"solution":"指数函数在0<a<1时单调递减，在a>1时单调递增。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-exponential","chapterTitle":"指数函数","sequence":30102},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_exp_003","statement":"方程 4^x-5·2^x+4=0 的所有实数解是？","answer":"x=0或x=2","answerType":"multiple_choice","choices":[{"value":"x=0","text":"x=0"},{"value":"x=1或x=2","text":"x=1或x=2"},{"value":"x=0或x=2","text":"x=0或x=2"},{"value":"x=-1或x=2","text":"x=-1或x=2"},{"value":"x=1或x=4","text":"x=1或x=4"}],"difficulty":5,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_exponential_functions","concepts":["alg_exponential_functions","alg_quadratics"],"prerequisiteConcepts":["alg_quadratics"],"skills":["指数换元方程"],"patterns":["令t等于指数式"],"misconceptions":["直接把指数当未知数因式分解"],"isAutoGradable":true,"solution":"令t=2^x>0，则t²-5t+4=0，得t=1或4，所以x=0或2。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-exponential","chapterTitle":"指数函数","sequence":30103},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"cn_senior_gap_v1_log_001","statement":"log₂8 的值是多少？","answer":"3","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"6","text":"6"},{"value":"8","text":"8"}],"difficulty":3,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_logarithms","concepts":["alg_logarithms","arith_exponents"],"prerequisiteConcepts":["arith_exponents"],"skills":["对数定义"],"patterns":["对数指数互化"],"misconceptions":["把底数与真数相除"],"isAutoGradable":true,"solution":"因为2³=8，所以log₂8=3。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-logarithms","chapterTitle":"对数","sequence":30201},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_log_002","statement":"化简 log₃9+log₃(1/3)，结果是？","answer":"1","answerType":"multiple_choice","choices":[{"value":"-1","text":"-1"},{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"2","text":"2"},{"value":"3","text":"3"}],"difficulty":4,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_logarithms","concepts":["alg_logarithms"],"prerequisiteConcepts":["arith_exponents"],"skills":["对数运算法则"],"patterns":["同底对数相加"],"misconceptions":["忽略负指数"],"isAutoGradable":true,"solution":"log₃9=2，log₃(1/3)=-1，相加得1。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-logarithms","chapterTitle":"对数","sequence":30202},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_log_003","statement":"方程 log₂(x-1)+log₂(x-3)=3 的实数解是？","answer":"x=5","answerType":"multiple_choice","choices":[{"value":"x=-1","text":"x=-1"},{"value":"x=3","text":"x=3"},{"value":"x=4","text":"x=4"},{"value":"x=5","text":"x=5"},{"value":"x=-1或x=5","text":"x=-1或x=5"}],"difficulty":5,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_logarithms","concepts":["alg_logarithms","alg_quadratics"],"prerequisiteConcepts":["alg_quadratics"],"skills":["对数方程"],"patterns":["合并对数并验定义域"],"misconceptions":["保留不满足定义域的根"],"isAutoGradable":true,"solution":"定义域要求x>3。合并得(x-1)(x-3)=8，即x²-4x-5=0，根为5和-1，仅x=5符合定义域。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-logarithms","chapterTitle":"对数","sequence":30203},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"cn_senior_gap_v1_inverse_001","statement":"函数 f(x)=2x+3 的反函数是？","answer":"f⁻¹(x)=(x-3)/2","answerType":"multiple_choice","choices":[{"value":"f⁻¹(x)=2x-3","text":"f⁻¹(x)=2x-3"},{"value":"f⁻¹(x)=(x+3)/2","text":"f⁻¹(x)=(x+3)/2"},{"value":"f⁻¹(x)=(x-3)/2","text":"f⁻¹(x)=(x-3)/2"},{"value":"f⁻¹(x)=1/(2x+3)","text":"f⁻¹(x)=1/(2x+3)"},{"value":"f⁻¹(x)=3-2x","text":"f⁻¹(x)=3-2x"}],"difficulty":3,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_inverse_functions","concepts":["alg_inverse_functions","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["求一次函数反函数"],"patterns":["交换自变量因变量并解出"],"misconceptions":["把反函数误认为倒数"],"isAutoGradable":true,"solution":"由y=2x+3解得x=(y-3)/2，交换变量后f⁻¹(x)=(x-3)/2。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-inverse","chapterTitle":"反函数","sequence":30301},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_inverse_002","statement":"若 f(x)=x³+1，则 f⁻¹(9) 的值是多少？","answer":"2","answerType":"multiple_choice","choices":[{"value":"1","text":"1"},{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"8","text":"8"},{"value":"10","text":"10"}],"difficulty":4,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_inverse_functions","concepts":["alg_inverse_functions","alg_functions"],"prerequisiteConcepts":["alg_functions"],"skills":["反函数函数值"],"patterns":["由输出反求输入"],"misconceptions":["直接代入原函数"],"isAutoGradable":true,"solution":"f⁻¹(9)是满足f(x)=9的x。由x³+1=9得x³=8，所以x=2。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-inverse","chapterTitle":"反函数","sequence":30302},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_inverse_003","statement":"函数 f(x)=(x-1)/(x+2)（x≠-2）的反函数是？","answer":"f⁻¹(x)=(1+2x)/(1-x)","answerType":"multiple_choice","choices":[{"value":"f⁻¹(x)=(1-2x)/(1+x)","text":"f⁻¹(x)=(1-2x)/(1+x)"},{"value":"f⁻¹(x)=(1+2x)/(1-x)","text":"f⁻¹(x)=(1+2x)/(1-x)"},{"value":"f⁻¹(x)=(x+2)/(x-1)","text":"f⁻¹(x)=(x+2)/(x-1)"},{"value":"f⁻¹(x)=(x-1)/(x+2)","text":"f⁻¹(x)=(x-1)/(x+2)"},{"value":"f⁻¹(x)=(2-x)/(1+x)","text":"f⁻¹(x)=(2-x)/(1+x)"}],"difficulty":5,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_inverse_functions","concepts":["alg_inverse_functions","alg_rational_expressions"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["求分式函数反函数"],"patterns":["交叉相乘后解出自变量"],"misconceptions":["把分式整体取倒数"],"isAutoGradable":true,"solution":"由y=(x-1)/(x+2)，得yx+2y=x-1，所以x(y-1)=-(1+2y)，即x=(1+2y)/(1-y)。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-inverse","chapterTitle":"反函数","sequence":30303},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"cn_senior_gap_v1_vieta_001","statement":"方程 x²-7x+10=0 的两根之和是多少？","answer":"7","answerType":"multiple_choice","choices":[{"value":"-10","text":"-10"},{"value":"-7","text":"-7"},{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"10","text":"10"}],"difficulty":3,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_vieta","concepts":["alg_vieta","alg_quadratics"],"prerequisiteConcepts":["alg_quadratics"],"skills":["韦达定理根和"],"patterns":["根和等于负一次项系数"],"misconceptions":["漏掉负号"],"isAutoGradable":true,"solution":"对x²+bx+c=0，两根和为-b。本题b=-7，所以根和为7。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-vieta","chapterTitle":"韦达定理","sequence":30401},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_vieta_002","statement":"若方程 x²-5x+k=0 的两根为2和3，则k等于多少？","answer":"6","answerType":"multiple_choice","choices":[{"value":"-6","text":"-6"},{"value":"1","text":"1"},{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"10","text":"10"}],"difficulty":4,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_vieta","concepts":["alg_vieta","alg_quadratics"],"prerequisiteConcepts":["alg_quadratics"],"skills":["韦达定理根积"],"patterns":["常数项等于根积"],"misconceptions":["用根和代替根积"],"isAutoGradable":true,"solution":"首项系数为1时，两根之积等于常数项k，因此k=2×3=6。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-vieta","chapterTitle":"韦达定理","sequence":30402},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_vieta_003","statement":"方程 x²-4x+1=0 的两根为α、β，则 α²+β² 的值是？","answer":"14","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"8","text":"8"},{"value":"12","text":"12"},{"value":"14","text":"14"},{"value":"18","text":"18"}],"difficulty":5,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_vieta","concepts":["alg_vieta","alg_quadratics"],"prerequisiteConcepts":["alg_quadratics"],"skills":["韦达定理对称式"],"patterns":["平方和转化"],"misconceptions":["把平方和误作根和平方"],"isAutoGradable":true,"solution":"α+β=4，αβ=1，所以α²+β²=(α+β)²-2αβ=16-2=14。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-vieta","chapterTitle":"韦达定理","sequence":30403},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"cn_senior_gap_v1_poly_001","statement":"多项式函数 f(x)=3x⁴-2x²+x-7 的次数是多少？","answer":"4","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"7","text":"7"}],"difficulty":3,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_polynomial_functions","concepts":["alg_polynomial_functions","alg_functions"],"prerequisiteConcepts":["prealg_expressions"],"skills":["判断多项式次数"],"patterns":["最高非零幂"],"misconceptions":["按项数判断次数"],"isAutoGradable":true,"solution":"最高次数非零项是3x⁴，因此多项式次数为4。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-polynomial","chapterTitle":"多项式函数","sequence":30501},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_poly_002","statement":"若多项式 P(x)=x³-2x²-5x+6，则P(1)的值是？","answer":"0","answerType":"multiple_choice","choices":[{"value":"-2","text":"-2"},{"value":"-1","text":"-1"},{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"6","text":"6"}],"difficulty":4,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_polynomial_functions","concepts":["alg_polynomial_functions","prealg_substitution"],"prerequisiteConcepts":["prealg_substitution"],"skills":["多项式求值"],"patterns":["代入并按次计算"],"misconceptions":["遗漏常数项"],"isAutoGradable":true,"solution":"P(1)=1-2-5+6=0。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-polynomial","chapterTitle":"多项式函数","sequence":30502},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_poly_003","statement":"已知多项式 P(x)=x³+ax²+bx+6 可被(x-1)和(x-2)整除，则a+b等于多少？","answer":"-7","answerType":"multiple_choice","choices":[{"value":"-9","text":"-9"},{"value":"-7","text":"-7"},{"value":"-5","text":"-5"},{"value":"5","text":"5"},{"value":"7","text":"7"}],"difficulty":5,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"alg_polynomial_functions","concepts":["alg_polynomial_functions","alg_systems"],"prerequisiteConcepts":["alg_systems"],"skills":["因式定理"],"patterns":["由零点建立方程组"],"misconceptions":["把整除条件只用一次"],"isAutoGradable":true,"solution":"P(1)=0得a+b=-7；P(2)=0可验证2a+b=-7，故a=0、b=-7，所求为-7。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-polynomial","chapterTitle":"多项式函数","sequence":30503},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"cn_senior_gap_v1_cosine_001","statement":"在△ABC中，a=3，b=4，夹角C=90°，则边c等于多少？","answer":"5","answerType":"multiple_choice","choices":[{"value":"1","text":"1"},{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"7","text":"7"}],"difficulty":3,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"trig_law_of_sines_cosines","concepts":["trig_law_of_sines_cosines","geo_pythagorean"],"prerequisiteConcepts":["geo_pythagorean"],"skills":["余弦定理直角特例"],"patterns":["夹角对应边"],"misconceptions":["直接相加两边"],"isAutoGradable":true,"solution":"由余弦定理c²=a²+b²-2ab cosC=9+16=25，所以c=5。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-sine-cosine-law","chapterTitle":"正弦定理与余弦定理","sequence":30601},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_cosine_002","statement":"在△ABC中，a=6，A=30°，B=45°，则边b等于多少？","answer":"6√2","answerType":"multiple_choice","choices":[{"value":"2√3","text":"2√3"},{"value":"3","text":"3"},{"value":"3√2","text":"3√2"},{"value":"6√2","text":"6√2"},{"value":"6√3","text":"6√3"}],"difficulty":4,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"trig_law_of_sines_cosines","concepts":["trig_law_of_sines_cosines","trig_functions"],"prerequisiteConcepts":["trig_functions"],"skills":["正弦定理解边"],"patterns":["边与对角对应"],"misconceptions":["交换角的对应边"],"isAutoGradable":true,"solution":"由a/sinA=b/sinB，b=6·sin45°/sin30°=6·(√2/2)/(1/2)=6√2。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-sine-cosine-law","chapterTitle":"正弦定理与余弦定理","sequence":30602},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_cosine_003","statement":"三角形三边长分别为5、7、8，则长度为8的边所对角的余弦值是？","answer":"1/7","answerType":"multiple_choice","choices":[{"value":"-1/7","text":"-1/7"},{"value":"1/8","text":"1/8"},{"value":"1/7","text":"1/7"},{"value":"2/7","text":"2/7"},{"value":"1/2","text":"1/2"}],"difficulty":5,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"trig_law_of_sines_cosines","concepts":["trig_law_of_sines_cosines","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["余弦定理求角"],"patterns":["最长边置于公式左侧"],"misconceptions":["分子符号次序错误"],"isAutoGradable":true,"solution":"设该角为C，则cosC=(5²+7²-8²)/(2·5·7)=(25+49-64)/70=1/7。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-sine-cosine-law","chapterTitle":"正弦定理与余弦定理","sequence":30603},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"cn_senior_gap_v1_transform_001","statement":"点P(2,-3)关于x轴对称后的坐标是？","answer":"(2,3)","answerType":"multiple_choice","choices":[{"value":"(-2,-3)","text":"(-2,-3)"},{"value":"(-2,3)","text":"(-2,3)"},{"value":"(2,-3)","text":"(2,-3)"},{"value":"(2,3)","text":"(2,3)"},{"value":"(3,2)","text":"(3,2)"}],"difficulty":3,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"geo_transformations","concepts":["geo_transformations","geo_coordinate_geometry"],"prerequisiteConcepts":["geo_coordinate_geometry"],"skills":["坐标轴对称"],"patterns":["横坐标不变纵坐标变号"],"misconceptions":["两个坐标同时变号"],"isAutoGradable":true,"solution":"关于x轴对称时横坐标不变，纵坐标变号，所以得到(2,3)。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-transformations","chapterTitle":"坐标变换","sequence":30701},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_transform_002","statement":"将点A(-1,4)按向量(3,-2)平移后得到的点坐标是？","answer":"(2,2)","answerType":"multiple_choice","choices":[{"value":"(-4,6)","text":"(-4,6)"},{"value":"(-2,2)","text":"(-2,2)"},{"value":"(2,2)","text":"(2,2)"},{"value":"(2,6)","text":"(2,6)"},{"value":"(4,-2)","text":"(4,-2)"}],"difficulty":4,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"geo_transformations","concepts":["geo_transformations","geo_coordinate_geometry"],"prerequisiteConcepts":["arith_integers"],"skills":["向量平移坐标"],"patterns":["对应坐标相加"],"misconceptions":["反向使用平移向量"],"isAutoGradable":true,"solution":"对应坐标相加：(-1+3,4-2)=(2,2)。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-transformations","chapterTitle":"坐标变换","sequence":30702},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_transform_003","statement":"直线 y=2x+1 向右平移3个单位后所得直线方程是？","answer":"y=2x-5","answerType":"multiple_choice","choices":[{"value":"y=2x+4","text":"y=2x+4"},{"value":"y=2x-2","text":"y=2x-2"},{"value":"y=2x-5","text":"y=2x-5"},{"value":"y=2x+7","text":"y=2x+7"},{"value":"y=2x-6","text":"y=2x-6"}],"difficulty":5,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"geo_transformations","concepts":["geo_transformations","alg_graphing"],"prerequisiteConcepts":["alg_graphing"],"skills":["函数图像水平平移"],"patterns":["自变量替换为x减平移量"],"misconceptions":["直接给常数项加3"],"isAutoGradable":true,"solution":"向右平移3单位需把原式中的x替换为x-3，得y=2(x-3)+1=2x-5。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-transformations","chapterTitle":"坐标变换","sequence":30703},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"cn_senior_gap_v1_mean_001","statement":"数据2、5、7、10的平均数是多少？","answer":"6","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"7","text":"7"},{"value":"8","text":"8"},{"value":"24","text":"24"}],"difficulty":3,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"stats_mean","concepts":["stats_mean","arith_natural_numbers"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["计算算术平均数"],"patterns":["总和除以个数"],"misconceptions":["只求数据总和"],"isAutoGradable":true,"solution":"平均数为(2+5+7+10)/4=24/4=6。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-mean","chapterTitle":"统计均值","sequence":30801},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_mean_002","statement":"某班男生20人，平均分80；女生30人，平均分90。全班平均分是多少？","answer":"86","answerType":"multiple_choice","choices":[{"value":"84","text":"84"},{"value":"85","text":"85"},{"value":"86","text":"86"},{"value":"87","text":"87"},{"value":"90","text":"90"}],"difficulty":4,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"stats_mean","concepts":["stats_mean","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["加权平均数"],"patterns":["按人数加权"],"misconceptions":["直接平均两个组均值"],"isAutoGradable":true,"solution":"总分为20×80+30×90=4300，总人数50，所以平均分为4300/50=86。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-mean","chapterTitle":"统计均值","sequence":30802},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_gap_v1_mean_003","statement":"五个数的平均数为12。去掉其中一个数后，剩余四个数的平均数为10。被去掉的数是多少？","answer":"20","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"18","text":"18"},{"value":"20","text":"20"}],"difficulty":5,"source":"cn_senior_curriculum_gaps_v1_original","primaryConcept":"stats_mean","concepts":["stats_mean","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["由平均数反求数据"],"patterns":["原总和减新总和"],"misconceptions":["直接相减两个平均数"],"isAutoGradable":true,"solution":"原五数总和为5×12=60，剩余四数总和为4×10=40，被去掉的数为60-40=20。","curriculum":{"course":"CN Senior High Math","theme":"高中课程缺口专项","chapter":"cn-senior-gap-v1-mean","chapterTitle":"统计均值","sequence":30803},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
