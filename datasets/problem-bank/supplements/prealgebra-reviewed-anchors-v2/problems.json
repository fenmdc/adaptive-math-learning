[
  {"id":"prealg_anchor_v2_prob_001","statement":"A bag contains 4 red marbles and 6 blue marbles. What is the probability of drawing a red marble?","answer":"2/5","answerType":"multiple_choice","choices":[{"value":"1/5","text":"1/5"},{"value":"2/5","text":"2/5"},{"value":"1/2","text":"1/2"},{"value":"3/5","text":"3/5"},{"value":"2/3","text":"2/3"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"counting_probability","concepts":["counting_probability","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["simple_probability"],"patterns":["favorable_over_total"],"misconceptions":["uses_unfavorable_over_total"],"isAutoGradable":true,"solution":"There are 4 favorable outcomes among 10 marbles, so 4/10=2/5.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-probability","chapterTitle":"Probability","sequence":29101},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_prob_002","statement":"A fair coin is flipped twice. What is the probability of getting at least one head?","answer":"3/4","answerType":"multiple_choice","choices":[{"value":"1/4","text":"1/4"},{"value":"1/3","text":"1/3"},{"value":"1/2","text":"1/2"},{"value":"3/4","text":"3/4"},{"value":"1","text":"1"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"counting_probability","concepts":["counting_probability","counting_principle"],"prerequisiteConcepts":["arith_fractions"],"skills":["compound_probability"],"patterns":["complement_or_outcome_list"],"misconceptions":["counts_only_two_heads"],"isAutoGradable":true,"solution":"The outcomes HH, HT, and TH have at least one head, so the probability is 3/4.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-probability","chapterTitle":"Probability","sequence":29102},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_prob_003","statement":"Two fair six-sided dice are rolled. What is the probability that their sum is 8?","answer":"5/36","answerType":"multiple_choice","choices":[{"value":"1/12","text":"1/12"},{"value":"1/9","text":"1/9"},{"value":"5/36","text":"5/36"},{"value":"1/6","text":"1/6"},{"value":"5/12","text":"5/12"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"counting_probability","concepts":["counting_probability","counting_principle"],"prerequisiteConcepts":["arith_fractions"],"skills":["two_dice_probability"],"patterns":["ordered_pair_sample_space"],"misconceptions":["treats_sums_as_equally_likely"],"isAutoGradable":true,"solution":"The favorable ordered pairs are (2,6),(3,5),(4,4),(5,3),(6,2), giving 5 of 36 outcomes.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-probability","chapterTitle":"Probability","sequence":29103},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v2_sim_001","statement":"Two similar triangles have corresponding sides 4 and 10. If another side of the smaller triangle is 6, what is the corresponding larger side?","answer":"15","answerType":"multiple_choice","choices":[{"value":"9","text":"9"},{"value":"12","text":"12"},{"value":"15","text":"15"},{"value":"16","text":"16"},{"value":"24","text":"24"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","arith_proportions"],"prerequisiteConcepts":["arith_proportions"],"skills":["similarity_scale_factor"],"patterns":["multiply_by_common_scale"],"misconceptions":["adds_side_difference"],"isAutoGradable":true,"solution":"The scale factor is 10/4=2.5, so the corresponding side is 6*2.5=15.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-similarity","chapterTitle":"Similarity","sequence":29201},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_sim_002","statement":"A rectangle is enlarged by a scale factor of 3. If its original area is 20 square units, what is the new area?","answer":"180 square units","answerType":"multiple_choice","choices":[{"value":"60 square units","text":"60 square units"},{"value":"120 square units","text":"120 square units"},{"value":"180 square units","text":"180 square units"},{"value":"240 square units","text":"240 square units"},{"value":"540 square units","text":"540 square units"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","geo_area"],"prerequisiteConcepts":["geo_area"],"skills":["area_scale_factor"],"patterns":["square_linear_scale"],"misconceptions":["uses_linear_scale_for_area"],"isAutoGradable":true,"solution":"Area scales by the square of 3, so the new area is 20*9=180 square units.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-similarity","chapterTitle":"Similarity","sequence":29202},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_sim_003","statement":"A 5-foot post casts a 4-foot shadow. At the same time, a tree casts a 14-foot shadow. How tall is the tree?","answer":"17.5 feet","answerType":"multiple_choice","choices":[{"value":"11.2 feet","text":"11.2 feet"},{"value":"15 feet","text":"15 feet"},{"value":"17.5 feet","text":"17.5 feet"},{"value":"18 feet","text":"18 feet"},{"value":"23 feet","text":"23 feet"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","arith_proportions"],"prerequisiteConcepts":["arith_proportions"],"skills":["indirect_measurement"],"patterns":["equal_height_shadow_ratios"],"misconceptions":["adds_shadow_difference"],"isAutoGradable":true,"solution":"Using equal height-to-shadow ratios, 5/4=h/14, so h=70/4=17.5 feet.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-similarity","chapterTitle":"Similarity","sequence":29203},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v2_sub_001","statement":"Evaluate 2x+3 when x=5.","answer":"13","answerType":"multiple_choice","choices":[{"value":"7","text":"7"},{"value":"10","text":"10"},{"value":"13","text":"13"},{"value":"16","text":"16"},{"value":"25","text":"25"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"prealg_substitution","concepts":["prealg_substitution","prealg_expressions"],"prerequisiteConcepts":["prealg_expressions"],"skills":["substitute_single_variable"],"patterns":["replace_then_evaluate"],"misconceptions":["concatenates_coefficient_and_value"],"isAutoGradable":true,"solution":"Substitute 5 for x: 2(5)+3=10+3=13.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-substitution","chapterTitle":"Substitution","sequence":29301},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_sub_002","statement":"Evaluate a^2-2b when a=-3 and b=4.","answer":"1","answerType":"multiple_choice","choices":[{"value":"-17","text":"-17"},{"value":"-1","text":"-1"},{"value":"1","text":"1"},{"value":"7","text":"7"},{"value":"17","text":"17"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"prealg_substitution","concepts":["prealg_substitution","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["substitute_signed_values"],"patterns":["parenthesize_negative_value"],"misconceptions":["squares_without_parentheses"],"isAutoGradable":true,"solution":"Substitute with parentheses: (-3)^2-2(4)=9-8=1.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-substitution","chapterTitle":"Substitution","sequence":29302},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_sub_003","statement":"The formula C=5(F-32)/9 converts Fahrenheit to Celsius. What is C when F=68?","answer":"20","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"18","text":"18"},{"value":"20","text":"20"},{"value":"36","text":"36"},{"value":"100","text":"100"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"prealg_substitution","concepts":["prealg_substitution","arith_fractions"],"prerequisiteConcepts":["arith_integers"],"skills":["evaluate_formula"],"patterns":["substitute_then_order_operations"],"misconceptions":["divides_before_subtracting"],"isAutoGradable":true,"solution":"C=5(68-32)/9=5*36/9=20.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-substitution","chapterTitle":"Substitution","sequence":29303},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v2_func_001","statement":"For the function f(x)=3x-1, what is f(4)?","answer":"11","answerType":"multiple_choice","choices":[{"value":"7","text":"7"},{"value":"10","text":"10"},{"value":"11","text":"11"},{"value":"12","text":"12"},{"value":"15","text":"15"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"alg_functions","concepts":["alg_functions","prealg_substitution"],"prerequisiteConcepts":["prealg_substitution"],"skills":["evaluate_function"],"patterns":["function_input_substitution"],"misconceptions":["multiplies_function_name"],"isAutoGradable":true,"solution":"Replace x with 4: f(4)=3(4)-1=11.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-functions","chapterTitle":"Functions","sequence":29401},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_func_002","statement":"Which ordered pair lies on the graph of y=2x+3?","answer":"(2,7)","answerType":"multiple_choice","choices":[{"value":"(0,2)","text":"(0,2)"},{"value":"(1,4)","text":"(1,4)"},{"value":"(2,5)","text":"(2,5)"},{"value":"(2,7)","text":"(2,7)"},{"value":"(3,8)","text":"(3,8)"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"alg_functions","concepts":["alg_functions","geo_coordinate_geometry"],"prerequisiteConcepts":["prealg_substitution"],"skills":["test_ordered_pair"],"patterns":["input_output_rule"],"misconceptions":["swaps_coordinates"],"isAutoGradable":true,"solution":"For x=2, y=2(2)+3=7, so (2,7) lies on the graph.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-functions","chapterTitle":"Functions","sequence":29402},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_func_003","statement":"A function follows the rule f(x)=x^2-2. If f(x)=47 and x is positive, what is x?","answer":"7","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"7","text":"7"},{"value":"8","text":"8"},{"value":"49","text":"49"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"alg_functions","concepts":["alg_functions","arith_roots"],"prerequisiteConcepts":["arith_roots"],"skills":["find_function_input"],"patterns":["reverse_function_rule"],"misconceptions":["forgets_to_undo_constant"],"isAutoGradable":true,"solution":"x^2-2=47 gives x^2=49; because x is positive, x=7.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-functions","chapterTitle":"Functions","sequence":29403},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v2_rem_001","statement":"What is the remainder when 73 is divided by 8?","answer":"1","answerType":"multiple_choice","choices":[{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"7","text":"7"},{"value":"8","text":"8"},{"value":"9","text":"9"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"nt_remainders","concepts":["nt_remainders","nt_divisibility"],"prerequisiteConcepts":["nt_divisibility"],"skills":["compute_remainder"],"patterns":["multiple_plus_remainder"],"misconceptions":["uses_quotient_as_remainder"],"isAutoGradable":true,"solution":"Since 73=8*9+1, the remainder is 1.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-remainders","chapterTitle":"Remainders","sequence":29501},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_rem_002","statement":"A number leaves remainder 3 when divided by 5. What remainder does twice the number leave when divided by 5?","answer":"1","answerType":"multiple_choice","choices":[{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"6","text":"6"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"nt_remainders","concepts":["nt_remainders","nt_modular"],"prerequisiteConcepts":["nt_divisibility"],"skills":["scale_remainder"],"patterns":["reduce_after_multiplication"],"misconceptions":["keeps_unreduced_product"],"isAutoGradable":true,"solution":"Twice the remainder is 2*3=6, and 6 leaves remainder 1 when divided by 5.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-remainders","chapterTitle":"Remainders","sequence":29502},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_rem_003","statement":"What is the remainder when 2^5+7 is divided by 6?","answer":"3","answerType":"multiple_choice","choices":[{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"5","text":"5"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"nt_remainders","concepts":["nt_remainders","arith_exponents"],"prerequisiteConcepts":["arith_exponents"],"skills":["remainder_of_expression"],"patterns":["evaluate_then_reduce"],"misconceptions":["divides_terms_without_recombining"],"isAutoGradable":true,"solution":"2^5+7=32+7=39, and 39=6*6+3, so the remainder is 3.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-remainders","chapterTitle":"Remainders","sequence":29503},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v2_nat_001","statement":"What is the value of 48/6+7?","answer":"15","answerType":"multiple_choice","choices":[{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"13","text":"13"},{"value":"15","text":"15"},{"value":"55","text":"55"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"arith_natural_numbers","concepts":["arith_natural_numbers"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["natural_number_operations"],"patterns":["division_before_addition"],"misconceptions":["adds_before_dividing"],"isAutoGradable":true,"solution":"Perform division first: 48/6=8, then 8+7=15.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-natural-numbers","chapterTitle":"Natural Numbers","sequence":29601},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_nat_002","statement":"The product of two consecutive positive integers is 72. What is the larger integer?","answer":"9","answerType":"multiple_choice","choices":[{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"9","text":"9"},{"value":"12","text":"12"},{"value":"36","text":"36"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"arith_natural_numbers","concepts":["arith_natural_numbers","nt_factorization"],"prerequisiteConcepts":["nt_factorization"],"skills":["consecutive_integer_product"],"patterns":["nearby_factor_pair"],"misconceptions":["chooses_nonconsecutive_factors"],"isAutoGradable":true,"solution":"The consecutive factor pair of 72 is 8*9, so the larger integer is 9.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-natural-numbers","chapterTitle":"Natural Numbers","sequence":29602},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_nat_003","statement":"What is the smallest positive integer that is divisible by 4 and 6 but not divisible by 5?","answer":"12","answerType":"multiple_choice","choices":[{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"20","text":"20"},{"value":"24","text":"24"},{"value":"60","text":"60"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"arith_natural_numbers","concepts":["arith_natural_numbers","nt_lcm"],"prerequisiteConcepts":["nt_lcm"],"skills":["apply_multiple_conditions"],"patterns":["least_common_multiple_then_check"],"misconceptions":["uses_product_instead_of_lcm"],"isAutoGradable":true,"solution":"lcm(4,6)=12, and 12 is not divisible by 5, so it is the smallest such integer.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-natural-numbers","chapterTitle":"Natural Numbers","sequence":29603},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

