  {"id":"prealg_anchor_v2_med_002","statement":"What is the median of 4, 9, 2, 11, 7, and 5?","answer":"6","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"5.5","text":"5.5"},{"value":"6","text":"6"},{"value":"7","text":"7"},{"value":"7.5","text":"7.5"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"stats_median","concepts":["stats_median","arith_decimals"],"prerequisiteConcepts":["arith_fractions"],"skills":["median_even_count"],"patterns":["sort_then_average_middle_pair"],"misconceptions":["uses_unsorted_middle_values"],"isAutoGradable":true,"solution":"Order the data as 2,4,5,7,9,11; the median is (5+7)/2=6.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-median","chapterTitle":"Median","sequence":29702},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_med_003","statement":"The median of the five numbers 4, 9, 12, 15, and x is 10. If x is an integer, what is x?","answer":"10","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"9","text":"9"},{"value":"10","text":"10"},{"value":"11","text":"11"},{"value":"14","text":"14"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"stats_median","concepts":["stats_median","arith_natural_numbers"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["find_value_from_median"],"patterns":["place_value_in_ordered_position"],"misconceptions":["sets_mean_to_target"],"isAutoGradable":true,"solution":"With five values, the middle ordered value must be 10. Since the other values bracket 10 as 9 and 12, x=10.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-median","chapterTitle":"Median","sequence":29703},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"prealg_anchor_v2_range_001","statement":"What is the range of the data set 6, 12, 9, 20, and 15?","answer":"14","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"9","text":"9"},{"value":"14","text":"14"},{"value":"15","text":"15"},{"value":"20","text":"20"}],"difficulty":2,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"stats_range","concepts":["stats_range"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["compute_range"],"patterns":["maximum_minus_minimum"],"misconceptions":["reports_maximum"],"isAutoGradable":true,"solution":"The maximum is 20 and the minimum is 6, so the range is 20-6=14.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-range","chapterTitle":"Range","sequence":29801},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_range_002","statement":"A data set has minimum 18 and range 27. What is its maximum?","answer":"45","answerType":"multiple_choice","choices":[{"value":"9","text":"9"},{"value":"27","text":"27"},{"value":"35","text":"35"},{"value":"45","text":"45"},{"value":"486","text":"486"}],"difficulty":3,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"stats_range","concepts":["stats_range","arith_natural_numbers"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["recover_maximum_from_range"],"patterns":["maximum_equals_minimum_plus_range"],"misconceptions":["subtracts_range_from_minimum"],"isAutoGradable":true,"solution":"Since range=maximum-minimum, maximum=18+27=45.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-range","chapterTitle":"Range","sequence":29802},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"prealg_anchor_v2_range_003","statement":"The data set 5, 8, 12, and 17 has a new value x added. If the new range is 20 and x is less than 5, what is x?","answer":"-3","answerType":"multiple_choice","choices":[{"value":"-15","text":"-15"},{"value":"-3","text":"-3"},{"value":"0","text":"0"},{"value":"3","text":"3"},{"value":"37","text":"37"}],"difficulty":4,"source":"prealgebra_reviewed_anchors_v2_original","primaryConcept":"stats_range","concepts":["stats_range","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["find_endpoint_from_range"],"patterns":["new_minimum_from_fixed_maximum"],"misconceptions":["adds_range_to_maximum"],"isAutoGradable":true,"solution":"Because x is the new minimum and 17 remains the maximum, 17-x=20, so x=-3.","curriculum":{"course":"Pre-Algebra","theme":"Reviewed Concept Anchors II","chapter":"prealgebra-anchors-v2-range","chapterTitle":"Range","sequence":29803},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
