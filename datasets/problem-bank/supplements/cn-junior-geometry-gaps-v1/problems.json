  {"id":"cn_junior_geo_gap_v1_g7_001","statement":"两条直线相交，一组对顶角的度数分别为(2x+10)°和(3x-15)°，则x的值是？","answer":"25","answerType":"multiple_choice","choices":[{"value":"15","text":"15"},{"value":"20","text":"20"},{"value":"25","text":"25"},{"value":"30","text":"30"},{"value":"35","text":"35"}],"difficulty":2,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["对顶角列方程"],"patterns":["对顶角相等"],"misconceptions":["把对顶角误作互补角"],"isAutoGradable":true,"solution":"对顶角相等，所以2x+10=3x-15，解得x=25。","curriculum":{"course":"CN Junior High Math","theme":"七年级相交线与角","chapter":"cn-junior-geometry-gaps-v1-g7-angles","chapterTitle":"七年级相交线与角专项","sequence":30701},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-lines-angles-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_g7_002","statement":"两个邻补角的度数分别为(4x+8)°和(2x+28)°，则x的值是？","answer":"24","answerType":"multiple_choice","choices":[{"value":"18","text":"18"},{"value":"22","text":"22"},{"value":"24","text":"24"},{"value":"28","text":"28"},{"value":"36","text":"36"}],"difficulty":3,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["邻补角列方程"],"patterns":["邻补角和为180度"],"misconceptions":["把邻补角误作相等"],"isAutoGradable":true,"solution":"邻补角之和为180°，所以4x+8+2x+28=180，解得x=24。","curriculum":{"course":"CN Junior High Math","theme":"七年级相交线与角","chapter":"cn-junior-geometry-gaps-v1-g7-angles","chapterTitle":"七年级相交线与角专项","sequence":30702},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-lines-angles-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_g7_003","statement":"直线AB与CD相交于点O，∠AOC=96°，射线OE平分∠AOC，则∠EOC的度数是？","answer":"48°","answerType":"multiple_choice","choices":[{"value":"42°","text":"42°"},{"value":"48°","text":"48°"},{"value":"84°","text":"84°"},{"value":"96°","text":"96°"},{"value":"192°","text":"192°"}],"difficulty":3,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["角平分线求角"],"patterns":["已知整角求半角"],"misconceptions":["把平分后的两个角相加"],"isAutoGradable":true,"solution":"OE平分∠AOC，所以∠EOC=96°÷2=48°。","curriculum":{"course":"CN Junior High Math","theme":"七年级相交线与角","chapter":"cn-junior-geometry-gaps-v1-g7-angles","chapterTitle":"七年级相交线与角专项","sequence":30703},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-lines-angles-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_g7_004","statement":"一条直线上的两个相邻角之比为2:3，则其中较小角的度数是？","answer":"72°","answerType":"multiple_choice","choices":[{"value":"36°","text":"36°"},{"value":"60°","text":"60°"},{"value":"72°","text":"72°"},{"value":"108°","text":"108°"},{"value":"120°","text":"120°"}],"difficulty":4,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["按比例分配邻补角"],"patterns":["总角度按份数分配"],"misconceptions":["用90度作为两角之和"],"isAutoGradable":true,"solution":"两角和为180°，共2+3=5份，每份36°，较小角为2×36°=72°。","curriculum":{"course":"CN Junior High Math","theme":"七年级相交线与角","chapter":"cn-junior-geometry-gaps-v1-g7-angles","chapterTitle":"七年级相交线与角专项","sequence":30704},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-lines-angles-p0","reviewStatus":"reviewed"},

  {"id":"cn_junior_geo_gap_v1_parallel_001","statement":"直线l、m被直线n所截，一对同位角分别为(3x+5)°和(5x-35)°。若l∥m，则x的值是？","answer":"20","answerType":"multiple_choice","choices":[{"value":"15","text":"15"},{"value":"18","text":"18"},{"value":"20","text":"20"},{"value":"25","text":"25"},{"value":"30","text":"30"}],"difficulty":2,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["平行线同位角列方程"],"patterns":["两直线平行同位角相等"],"misconceptions":["把同位角相加等于180度"],"isAutoGradable":true,"solution":"两直线平行时同位角相等，所以3x+5=5x-35，解得x=20。","curriculum":{"course":"CN Junior High Math","theme":"八年级平行线","chapter":"cn-junior-geometry-gaps-v1-g8-parallel","chapterTitle":"八年级平行线专项","sequence":30801},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-lines-angles-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_parallel_002","statement":"两条平行线被一条截线所截，其中一个同旁内角为115°，则另一个同旁内角为？","answer":"65°","answerType":"multiple_choice","choices":[{"value":"55°","text":"55°"},{"value":"65°","text":"65°"},{"value":"75°","text":"75°"},{"value":"115°","text":"115°"},{"value":"245°","text":"245°"}],"difficulty":3,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["平行线同旁内角求角"],"patterns":["同旁内角互补"],"misconceptions":["认为同旁内角相等"],"isAutoGradable":true,"solution":"两直线平行时同旁内角互补，所以另一个角为180°-115°=65°。","curriculum":{"course":"CN Junior High Math","theme":"八年级平行线","chapter":"cn-junior-geometry-gaps-v1-g8-parallel","chapterTitle":"八年级平行线专项","sequence":30802},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-lines-angles-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_parallel_003","statement":"直线a、b被直线c所截。要判定a∥b，下列条件中可以直接作为判定依据的是？","answer":"一对内错角相等","answerType":"multiple_choice","choices":[{"value":"一对邻补角相等","text":"一对邻补角相等"},{"value":"一对内错角相等","text":"一对内错角相等"},{"value":"一对对顶角相等","text":"一对对顶角相等"},{"value":"任意两个角互补","text":"任意两个角互补"},{"value":"一对同旁内角相等","text":"一对同旁内角相等"}],"difficulty":3,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["平行线判定"],"patterns":["内错角相等判平行"],"misconceptions":["用恒成立的对顶角关系判平行"],"isAutoGradable":true,"solution":"内错角相等可以判定两直线平行；对顶角相等与两直线是否平行无关。","curriculum":{"course":"CN Junior High Math","theme":"八年级平行线","chapter":"cn-junior-geometry-gaps-v1-g8-parallel","chapterTitle":"八年级平行线专项","sequence":30803},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-lines-angles-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_parallel_004","statement":"直线a∥b，一条截线与a所成的一个锐角为68°，则与它相邻的钝角度数是？","answer":"112°","answerType":"multiple_choice","choices":[{"value":"22°","text":"22°"},{"value":"68°","text":"68°"},{"value":"90°","text":"90°"},{"value":"112°","text":"112°"},{"value":"136°","text":"136°"}],"difficulty":4,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["平行线角关系综合"],"patterns":["先找等角再用邻补角"],"misconceptions":["把所有角都视为相等"],"isAutoGradable":true,"solution":"相邻的锐角与钝角组成邻补角，所以钝角为180°-68°=112°。","curriculum":{"course":"CN Junior High Math","theme":"八年级平行线","chapter":"cn-junior-geometry-gaps-v1-g8-parallel","chapterTitle":"八年级平行线专项","sequence":30804},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-lines-angles-p0","reviewStatus":"reviewed"},

  {"id":"cn_junior_geo_gap_v1_proof_001","statement":"要用SSS判定△ABC与△DEF全等，已知AB=DE、BC=EF，还需要补充的条件是？","answer":"AC=DF","answerType":"multiple_choice","choices":[{"value":"AC=DF","text":"AC=DF"},{"value":"∠A=∠D","text":"∠A=∠D"},{"value":"∠B=∠E","text":"∠B=∠E"},{"value":"∠C=∠F","text":"∠C=∠F"},{"value":"△ABC与△DEF面积相等","text":"△ABC与△DEF面积相等"}],"difficulty":2,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_congruence","concepts":["geo_congruence","geo_triangles"],"prerequisiteConcepts":["geo_triangles"],"skills":["补全SSS全等条件"],"patterns":["三组对应边相等"],"misconceptions":["把两边一角误作SSS"],"isAutoGradable":true,"solution":"SSS要求三组对应边分别相等，已有两组边，还需AC=DF。","curriculum":{"course":"CN Junior High Math","theme":"八年级几何证明","chapter":"cn-junior-geometry-gaps-v1-g8-proof","chapterTitle":"八年级几何证明专项","sequence":30901},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-geometry-proof-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_proof_002","statement":"在△ABC中，D、E分别是AB、AC的中点，且BC=18厘米。由三角形中位线定理可得DE的长度是？","answer":"9厘米","answerType":"multiple_choice","choices":[{"value":"4.5厘米","text":"4.5厘米"},{"value":"9厘米","text":"9厘米"},{"value":"12厘米","text":"12厘米"},{"value":"18厘米","text":"18厘米"},{"value":"36厘米","text":"36厘米"}],"difficulty":3,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_similarity","concepts":["geo_similarity","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["三角形中位线定理"],"patterns":["中位线等于第三边一半"],"misconceptions":["把中位线当作与第三边等长"],"isAutoGradable":true,"solution":"三角形中位线平行于第三边且等于第三边的一半，所以DE=18÷2=9厘米。","curriculum":{"course":"CN Junior High Math","theme":"八年级几何证明","chapter":"cn-junior-geometry-gaps-v1-g8-proof","chapterTitle":"八年级几何证明专项","sequence":30902},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-geometry-proof-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_proof_003","statement":"在等腰三角形ABC中，AB=AC。为证明∠B=∠C，作AD平分∠A并交BC于D。证明△ABD≌△ACD最适合使用的判定是？","answer":"SAS","answerType":"multiple_choice","choices":[{"value":"SSS","text":"SSS"},{"value":"SAS","text":"SAS"},{"value":"ASA","text":"ASA"},{"value":"AAS","text":"AAS"},{"value":"HL","text":"HL"}],"difficulty":4,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_congruence","concepts":["geo_congruence","geo_triangle_angles"],"prerequisiteConcepts":["geo_triangles"],"skills":["选择全等判定完成证明"],"patterns":["两边及其夹角"],"misconceptions":["忽略角必须是两已知边的夹角"],"isAutoGradable":true,"solution":"AB=AC，AD为公共边，且∠BAD=∠CAD，因此用SAS可证两三角形全等。","curriculum":{"course":"CN Junior High Math","theme":"八年级几何证明","chapter":"cn-junior-geometry-gaps-v1-g8-proof","chapterTitle":"八年级几何证明专项","sequence":30903},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-geometry-proof-p0","reviewStatus":"reviewed"},
  {"id":"cn_junior_geo_gap_v1_proof_004","statement":"四边形ABCD中，AB∥CD且AD∥BC。要证明∠A=∠C，下列推理链正确的是？","answer":"∠A与∠B互补，∠C与∠B互补，所以∠A=∠C","answerType":"multiple_choice","choices":[{"value":"∠A与∠B互补，∠C与∠B互补，所以∠A=∠C","text":"∠A与∠B互补，∠C与∠B互补，所以∠A=∠C"},{"value":"∠A与∠B相等，∠C与∠B相等，所以∠A=∠C","text":"∠A与∠B相等，∠C与∠B相等，所以∠A=∠C"},{"value":"∠A与∠C是对顶角，所以∠A=∠C","text":"∠A与∠C是对顶角，所以∠A=∠C"},{"value":"四边形内角和为180°，所以∠A=∠C","text":"四边形内角和为180°，所以∠A=∠C"},{"value":"AB=CD，所以∠A=∠C","text":"AB=CD，所以∠A=∠C"}],"difficulty":4,"source":"cn_junior_geometry_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles","geo_triangle_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["选择平行四边形角证明链"],"patterns":["同角的补角相等"],"misconceptions":["把对角误作对顶角"],"isAutoGradable":true,"solution":"由AD∥BC可得∠A与∠B互补；由AB∥CD可得∠C与∠B互补。同一个角的补角相等，所以∠A=∠C。","curriculum":{"course":"CN Junior High Math","theme":"八年级几何证明","chapter":"cn-junior-geometry-gaps-v1-g8-proof","chapterTitle":"八年级几何证明专项","sequence":30904},"locale":{"language":"zh-CN","displayTrack":"中文校内","contentStatus":"reviewed"},"remediationTargetId":"cn-junior-geometry-proof-p0","reviewStatus":"reviewed"}
