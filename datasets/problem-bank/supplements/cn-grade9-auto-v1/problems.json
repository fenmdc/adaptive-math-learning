  {"id":"cn_grade9_auto_v1_probability_001","statement":"袋中有3个红球、2个白球，不放回任取2个球，两个都是红球的概率是多少？","answer":"3/10","answerType":"multiple_choice","choices":[{"value":"1/5","text":"1/5"},{"value":"3/10","text":"3/10"},{"value":"2/5","text":"2/5"},{"value":"1/2","text":"1/2"},{"value":"3/5","text":"3/5"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_probability_explanation","primaryConcept":"prob_conditional","concepts":["prob_conditional"],"prerequisiteConcepts":["arith_fractions"],"skills":["不放回概率"],"patterns":["连续概率相乘"],"misconceptions":["第二次仍用3/5"],"isAutoGradable":true,"solution":"概率为(3/5)×(2/4)=3/10。","curriculum":{"course":"CN Junior High Math","theme":"九年级概率","chapter":"cn-grade9-auto-v1-probability","chapterTitle":"九年级概率客观练习","sequence":30301},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_probability_002","statement":"从编号1、2、3、4的卡片中不放回抽两张，两数之和为奇数的概率是多少？","answer":"2/3","answerType":"multiple_choice","choices":[{"value":"1/3","text":"1/3"},{"value":"1/2","text":"1/2"},{"value":"2/3","text":"2/3"},{"value":"3/4","text":"3/4"},{"value":"5/6","text":"5/6"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_probability_two_step","primaryConcept":"prob_conditional","concepts":["prob_conditional"],"prerequisiteConcepts":["arith_fractions"],"skills":["两步随机计数"],"patterns":["一奇一偶时和为奇数"],"misconceptions":["只计算一种抽取顺序"],"isAutoGradable":true,"solution":"6组无序卡片对中，一奇一偶有4组，概率4/6=2/3。","curriculum":{"course":"CN Junior High Math","theme":"九年级概率","chapter":"cn-grade9-auto-v1-probability","chapterTitle":"九年级概率客观练习","sequence":30302},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
