  {"id":"cn_grade9_auto_v1_quadratic_func_001","statement":"投篮轨迹满足 y=-0.2x²+1.2x+1.6，球达到的最大高度是多少米？","answer":"3.4","answerType":"multiple_choice","choices":[{"value":"1.6","text":"1.6"},{"value":"2.8","text":"2.8"},{"value":"3.0","text":"3.0"},{"value":"3.4","text":"3.4"},{"value":"4.0","text":"4.0"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_vertex_application","primaryConcept":"alg_quadratics","concepts":["alg_quadratics"],"prerequisiteConcepts":["prealg_substitution"],"skills":["二次函数实际最值"],"patterns":["开口向下抛物线顶点"],"misconceptions":["把初始高度当最大高度"],"isAutoGradable":true,"solution":"顶点横坐标x=-1.2/(2×-0.2)=3，代入得y=3.4。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次函数","chapter":"cn-grade9-auto-v1-quadratic-functions","chapterTitle":"九年级二次函数客观练习","sequence":29601},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_quadratic_func_002","statement":"二次函数 y=x²-4x+3 与x轴的交点横坐标分别是什么？","answer":"1,3","answerType":"multiple_choice","choices":[{"value":"-3,-1","text":"-3，-1"},{"value":"-1,3","text":"-1，3"},{"value":"1,3","text":"1，3"},{"value":"2,3","text":"2，3"},{"value":"3,4","text":"3，4"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_function_intercepts","primaryConcept":"alg_quadratics","concepts":["alg_quadratics"],"prerequisiteConcepts":["alg_factoring"],"skills":["二次函数零点"],"patterns":["令函数值为零"],"misconceptions":["把顶点横坐标当两个交点"],"isAutoGradable":true,"solution":"令y=0，x²-4x+3=(x-1)(x-3)=0，得x=1或3。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次函数","chapter":"cn-grade9-auto-v1-quadratic-functions","chapterTitle":"九年级二次函数客观练习","sequence":29602},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_quadratic_func_003","statement":"函数 P=-2x²+80x-600 的最大值是多少？","answer":"200","answerType":"multiple_choice","choices":[{"value":"40","text":"40"},{"value":"100","text":"100"},{"value":"200","text":"200"},{"value":"600","text":"600"},{"value":"800","text":"800"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_revenue_max","primaryConcept":"alg_quadratics","concepts":["alg_quadratics"],"prerequisiteConcepts":["prealg_substitution"],"skills":["二次函数最大值"],"patterns":["顶点公式"],"misconceptions":["忽略二次项系数为负"],"isAutoGradable":true,"solution":"顶点横坐标x=-80/(2×-2)=20，P(20)=200。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次函数","chapter":"cn-grade9-auto-v1-quadratic-functions","chapterTitle":"九年级二次函数客观练习","sequence":29603},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_quadratic_eq_001","statement":"方程 x²-5x+6=0 的两个根是？","answer":"2,3","answerType":"multiple_choice","choices":[{"value":"-3,-2","text":"-3，-2"},{"value":"-2,3","text":"-2，3"},{"value":"1,6","text":"1，6"},{"value":"2,3","text":"2，3"},{"value":"3,5","text":"3，5"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_factoring_roots","primaryConcept":"alg_quadratics","concepts":["alg_quadratics","alg_factoring"],"prerequisiteConcepts":["alg_factoring"],"skills":["因式分解解方程"],"patterns":["零乘积性质"],"misconceptions":["因式符号与根符号混淆"],"isAutoGradable":true,"solution":"(x-2)(x-3)=0，所以x=2或3。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次方程","chapter":"cn-grade9-auto-v1-quadratic-equations","chapterTitle":"九年级二次方程客观练习","sequence":29701},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_quadratic_eq_002","statement":"方程 x²-2kx+k²-4=0 有几个不相等的实数根？","answer":"2个","answerType":"multiple_choice","choices":[{"value":"0个","text":"0个"},{"value":"1个","text":"1个"},{"value":"2个","text":"2个"},{"value":"取决于k","text":"取决于k"},{"value":"无穷多个","text":"无穷多个"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_discriminant_parameter","primaryConcept":"alg_quadratics","concepts":["alg_quadratics"],"prerequisiteConcepts":["prealg_simplification"],"skills":["判别式"],"patterns":["参数消去"],"misconceptions":["认为根数必随参数变化"],"isAutoGradable":true,"solution":"判别式Δ=(-2k)²-4(k²-4)=16>0，因此始终有2个不相等实根。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次方程","chapter":"cn-grade9-auto-v1-quadratic-equations","chapterTitle":"九年级二次方程客观练习","sequence":29702},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_quadratic_eq_003","statement":"已知x=2是方程 x²+ax-6=0 的一个根，a等于多少？","answer":"1","answerType":"multiple_choice","choices":[{"value":"-5","text":"-5"},{"value":"-1","text":"-1"},{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"5","text":"5"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_parameter_one_root","primaryConcept":"alg_quadratics","concepts":["alg_quadratics"],"prerequisiteConcepts":["prealg_substitution"],"skills":["已知根求参数"],"patterns":["将根代入方程"],"misconceptions":["未令代入结果为零"],"isAutoGradable":true,"solution":"代入x=2得4+2a-6=0，所以2a=2，a=1。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次方程","chapter":"cn-grade9-auto-v1-quadratic-equations","chapterTitle":"九年级二次方程客观练习","sequence":29703},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_quadratic_app_001","statement":"长方形的长比宽多3米，面积为40平方米。它的宽是多少米？","answer":"5","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"10","text":"10"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_area_application","primaryConcept":"alg_quadratics","concepts":["alg_quadratics","geo_area"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["面积建模"],"patterns":["宽乘长等于面积"],"misconceptions":["保留负长度"],"isAutoGradable":true,"solution":"设宽x，则x(x+3)=40，解得x=5或-8，宽取5。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次方程应用","chapter":"cn-grade9-auto-v1-quadratic-applications","chapterTitle":"九年级二次方程应用客观练习","sequence":29801},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_quadratic_app_002","statement":"物体高度 h=-5t²+20t+1，它达到的最大高度是多少米？","answer":"21","answerType":"multiple_choice","choices":[{"value":"16","text":"16"},{"value":"20","text":"20"},{"value":"21","text":"21"},{"value":"25","text":"25"},{"value":"41","text":"41"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_projectile_height","primaryConcept":"alg_quadratics","concepts":["alg_quadratics"],"prerequisiteConcepts":["prealg_substitution"],"skills":["抛物线实际最值"],"patterns":["时间取顶点横坐标"],"misconceptions":["把一次项系数当最大高度"],"isAutoGradable":true,"solution":"顶点时刻t=-20/(2×-5)=2，h(2)=-20+40+1=21。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次方程应用","chapter":"cn-grade9-auto-v1-quadratic-applications","chapterTitle":"九年级二次方程应用客观练习","sequence":29802},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_quadratic_app_003","statement":"两个连续正整数的积为156，较小的整数是多少？","answer":"12","answerType":"multiple_choice","choices":[{"value":"10","text":"10"},{"value":"11","text":"11"},{"value":"12","text":"12"},{"value":"13","text":"13"},{"value":"14","text":"14"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_quadratic_consecutive_integers","primaryConcept":"alg_quadratics","concepts":["alg_quadratics"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["连续整数建模"],"patterns":["相邻整数乘积"],"misconceptions":["保留负数解"],"isAutoGradable":true,"solution":"设较小数x，x(x+1)=156，因12×13=156，所以较小数为12。","curriculum":{"course":"CN Junior High Math","theme":"九年级二次方程应用","chapter":"cn-grade9-auto-v1-quadratic-applications","chapterTitle":"九年级二次方程应用客观练习","sequence":29803},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_similarity_001","statement":"同一时刻，1.8米竹竿影长2.4米，一棵树影长8米。树高是多少米？","answer":"6","answerType":"multiple_choice","choices":[{"value":"4.8","text":"4.8"},{"value":"6","text":"6"},{"value":"7.2","text":"7.2"},{"value":"8","text":"8"},{"value":"10.8","text":"10.8"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_similarity_shadow_application","primaryConcept":"geo_similarity","concepts":["geo_similarity"],"prerequisiteConcepts":["arith_ratios"],"skills":["相似三角形测高"],"patterns":["高度与影长成比例"],"misconceptions":["影长差等于高度差"],"isAutoGradable":true,"solution":"h/8=1.8/2.4=3/4，所以h=6米。","curriculum":{"course":"CN Junior High Math","theme":"九年级相似应用","chapter":"cn-grade9-auto-v1-similarity","chapterTitle":"九年级相似应用客观练习","sequence":29901},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_similarity_002","statement":"镜子离观察者1.5米、离旗杆9米，观察者眼高1.6米。旗杆高度是多少米？","answer":"9.6","answerType":"multiple_choice","choices":[{"value":"2.4","text":"2.4"},{"value":"6","text":"6"},{"value":"8.1","text":"8.1"},{"value":"9.6","text":"9.6"},{"value":"10.6","text":"10.6"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_similarity_indirect_measure","primaryConcept":"geo_similarity","concepts":["geo_similarity"],"prerequisiteConcepts":["arith_ratios"],"skills":["镜面反射相似测高"],"patterns":["对应高度与水平距离成比例"],"misconceptions":["把两段水平距离相加作比例"],"isAutoGradable":true,"solution":"H/9=1.6/1.5，所以H=9.6米。","curriculum":{"course":"CN Junior High Math","theme":"九年级相似应用","chapter":"cn-grade9-auto-v1-similarity","chapterTitle":"九年级相似应用客观练习","sequence":29902},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_similarity_003","statement":"地图比例尺为1:50000，图上距离3.6 cm，实际距离是多少千米？","answer":"1.8","answerType":"multiple_choice","choices":[{"value":"0.18","text":"0.18"},{"value":"1.8","text":"1.8"},{"value":"18","text":"18"},{"value":"180","text":"180"},{"value":"1800","text":"1800"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_similarity_scale_model","primaryConcept":"geo_similarity","concepts":["geo_similarity"],"prerequisiteConcepts":["arith_ratios"],"skills":["比例尺与单位换算"],"patterns":["图上距离乘比例尺分母"],"misconceptions":["厘米转千米位数错误"],"isAutoGradable":true,"solution":"3.6×50000=180000 cm=1.8 km。","curriculum":{"course":"CN Junior High Math","theme":"九年级相似应用","chapter":"cn-grade9-auto-v1-similarity","chapterTitle":"九年级相似应用客观练习","sequence":29903},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_trig_001","statement":"斜坡与水平面夹角30°，斜坡长20米。斜坡升高多少米？","answer":"10","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"10","text":"10"},{"value":"10√3","text":"10√3"},{"value":"20","text":"20"},{"value":"20√3","text":"20√3"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_trig_height_application","primaryConcept":"trig_functions","concepts":["trig_functions"],"prerequisiteConcepts":["geo_triangles"],"skills":["正弦实际应用"],"patterns":["对边等于斜边乘正弦"],"misconceptions":["使用余弦求对边"],"isAutoGradable":true,"solution":"高度=20×sin30°=20×1/2=10米。","curriculum":{"course":"CN Junior High Math","theme":"九年级锐角三角函数","chapter":"cn-grade9-auto-v1-trigonometry","chapterTitle":"九年级锐角三角函数客观练习","sequence":30001},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_trig_002","statement":"观测楼顶的仰角为45°，观测点到楼底水平距离30米。楼高是多少米？","answer":"30","answerType":"multiple_choice","choices":[{"value":"15","text":"15"},{"value":"15√2","text":"15√2"},{"value":"30","text":"30"},{"value":"30√2","text":"30√2"},{"value":"60","text":"60"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_trig_distance_application","primaryConcept":"trig_functions","concepts":["trig_functions"],"prerequisiteConcepts":["geo_triangles"],"skills":["正切测高"],"patterns":["对边等于邻边乘正切"],"misconceptions":["把水平距离当斜边"],"isAutoGradable":true,"solution":"tan45°=楼高/30=1，所以楼高30米。","curriculum":{"course":"CN Junior High Math","theme":"九年级锐角三角函数","chapter":"cn-grade9-auto-v1-trigonometry","chapterTitle":"九年级锐角三角函数客观练习","sequence":30002},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_trig_003","statement":"直角三角形中某锐角的对边和邻边都长7，这个锐角是多少度？","answer":"45°","answerType":"multiple_choice","choices":[{"value":"30°","text":"30°"},{"value":"45°","text":"45°"},{"value":"60°","text":"60°"},{"value":"75°","text":"75°"},{"value":"90°","text":"90°"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_trig_find_angle_tangent","primaryConcept":"trig_functions","concepts":["trig_functions"],"prerequisiteConcepts":["geo_triangles"],"skills":["由正切值求锐角"],"patterns":["tanθ=1"],"misconceptions":["把直角作为锐角答案"],"isAutoGradable":true,"solution":"tanθ=7/7=1，因此θ=45°。","curriculum":{"course":"CN Junior High Math","theme":"九年级锐角三角函数","chapter":"cn-grade9-auto-v1-trigonometry","chapterTitle":"九年级锐角三角函数客观练习","sequence":30003},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_circle_001","statement":"圆心角AOC和圆周角ABC同对弧AC，若∠AOC=100°，则∠ABC是多少度？","answer":"50°","answerType":"multiple_choice","choices":[{"value":"25°","text":"25°"},{"value":"50°","text":"50°"},{"value":"80°","text":"80°"},{"value":"100°","text":"100°"},{"value":"200°","text":"200°"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_circle_inscribed_angle_explain","primaryConcept":"geo_circles","concepts":["geo_circles","geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["圆周角定理"],"patterns":["同弧圆周角为圆心角一半"],"misconceptions":["把两个角判为相等"],"isAutoGradable":true,"solution":"同弧所对圆周角等于圆心角的一半，所以∠ABC=50°。","curriculum":{"course":"CN Junior High Math","theme":"九年级圆","chapter":"cn-grade9-auto-v1-circles","chapterTitle":"九年级圆客观练习","sequence":30101},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_circle_002","statement":"从圆外一点P引两条切线PA、PB，若PA=7 cm，则PB等于多少厘米？","answer":"7","answerType":"multiple_choice","choices":[{"value":"3.5","text":"3.5"},{"value":"7","text":"7"},{"value":"14","text":"14"},{"value":"21","text":"21"},{"value":"无法确定","text":"无法确定"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_circle_tangent_length_application","primaryConcept":"geo_circles","concepts":["geo_circles"],"prerequisiteConcepts":["geo_congruence"],"skills":["切线长定理"],"patterns":["同一点引圆的两条切线等长"],"misconceptions":["认为缺少半径无法求"],"isAutoGradable":true,"solution":"从同一圆外点引圆的两条切线段相等，所以PB=PA=7。","curriculum":{"course":"CN Junior High Math","theme":"九年级圆","chapter":"cn-grade9-auto-v1-circles","chapterTitle":"九年级圆客观练习","sequence":30102},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_circle_003","statement":"圆心角AOB=120°，圆周长为18π cm，它所对弧AB长多少厘米？","answer":"6π","answerType":"multiple_choice","choices":[{"value":"3π","text":"3π"},{"value":"6π","text":"6π"},{"value":"9π","text":"9π"},{"value":"12π","text":"12π"},{"value":"18π","text":"18π"}],"difficulty":3,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_circle_central_angle_arc","primaryConcept":"geo_arc_length","concepts":["geo_arc_length","geo_circles"],"prerequisiteConcepts":["arith_fractions"],"skills":["弧长"],"patterns":["圆心角占周角比例"],"misconceptions":["用120除以180"],"isAutoGradable":true,"solution":"120°占360°的1/3，弧长为18π×1/3=6π。","curriculum":{"course":"CN Junior High Math","theme":"九年级圆","chapter":"cn-grade9-auto-v1-circles","chapterTitle":"九年级圆客观练习","sequence":30103},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_stats_001","statement":"平时成绩占40%、期末成绩占60%，两项成绩分别为85和75。综合成绩是多少？","answer":"79","answerType":"multiple_choice","choices":[{"value":"75","text":"75"},{"value":"79","text":"79"},{"value":"80","text":"80"},{"value":"81","text":"81"},{"value":"85","text":"85"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_statistics_weighted_mean","primaryConcept":"stats_mean","concepts":["stats_mean"],"prerequisiteConcepts":["arith_percentages"],"skills":["加权平均数"],"patterns":["分项乘权重后求和"],"misconceptions":["直接求普通平均数"],"isAutoGradable":true,"solution":"85×0.4+75×0.6=34+45=79。","curriculum":{"course":"CN Junior High Math","theme":"九年级统计","chapter":"cn-grade9-auto-v1-statistics","chapterTitle":"九年级统计客观练习","sequence":30201},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_grade9_auto_v1_stats_002","statement":"从每个年级随机抽取40人调查运动时间，三个年级的样本容量是多少？","answer":"120","answerType":"multiple_choice","choices":[{"value":"40","text":"40"},{"value":"80","text":"80"},{"value":"120","text":"120"},{"value":"160","text":"160"},{"value":"无法确定","text":"无法确定"}],"difficulty":2,"source":"cn_grade9_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g9_statistics_sample_survey","primaryConcept":"stats_mean","concepts":["stats_mean"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["分层抽样样本容量"],"patterns":["各层样本数求和"],"misconceptions":["只取一个年级人数"],"isAutoGradable":true,"solution":"三个年级各40人，总样本容量为3×40=120。","curriculum":{"course":"CN Junior High Math","theme":"九年级统计","chapter":"cn-grade9-auto-v1-statistics","chapterTitle":"九年级统计客观练习","sequence":30202},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"九年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
