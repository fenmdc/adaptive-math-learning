[
  {"id":"amc8_anchor_v2_pct_001","statement":"What is 25% of 80?","answer":"20","answerType":"multiple_choice","choices":[{"value":"16","text":"16"},{"value":"20","text":"20"},{"value":"25","text":"25"},{"value":"40","text":"40"},{"value":"60","text":"60"}],"difficulty":2,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"arith_percentages","concepts":["arith_percentages","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["find_percent_of_quantity"],"patterns":["percent_as_fraction"],"misconceptions":["uses_percent_as_whole_number"],"isAutoGradable":true,"solution":"Since 25%=1/4, one fourth of 80 is 20.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-percentages","chapterTitle":"Percent Reasoning","sequence":28101},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_pct_002","statement":"A $60 jacket increases in price by 15%. What is the new price?","answer":"$69","answerType":"multiple_choice","choices":[{"value":"$63","text":"$63"},{"value":"$69","text":"$69"},{"value":"$72","text":"$72"},{"value":"$75","text":"$75"},{"value":"$90","text":"$90"}],"difficulty":3,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"arith_percentages","concepts":["arith_percentages"],"prerequisiteConcepts":["arith_decimals"],"skills":["percent_increase"],"patterns":["original_plus_percent_change"],"misconceptions":["adds_percent_number_directly"],"isAutoGradable":true,"solution":"The increase is 0.15*60=$9, so the new price is $69.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-percentages","chapterTitle":"Percent Reasoning","sequence":28102},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_pct_003","statement":"A $50 item is discounted 20%, then 10% sales tax is applied to the discounted price. What is the final price?","answer":"$44","answerType":"multiple_choice","choices":[{"value":"$35","text":"$35"},{"value":"$40","text":"$40"},{"value":"$44","text":"$44"},{"value":"$45","text":"$45"},{"value":"$49","text":"$49"}],"difficulty":4,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"arith_percentages","concepts":["arith_percentages","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["successive_percent_changes"],"patterns":["multiply_successive_factors"],"misconceptions":["combines_percent_changes_additively"],"isAutoGradable":true,"solution":"After the discount the price is 50*0.80=$40; tax makes it 40*1.10=$44.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-percentages","chapterTitle":"Percent Reasoning","sequence":28103},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"amc8_anchor_v2_prob_001","statement":"A fair six-sided die is rolled. What is the probability of rolling a number greater than 4?","answer":"1/3","answerType":"multiple_choice","choices":[{"value":"1/6","text":"1/6"},{"value":"1/3","text":"1/3"},{"value":"1/2","text":"1/2"},{"value":"2/3","text":"2/3"},{"value":"5/6","text":"5/6"}],"difficulty":2,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"counting_probability","concepts":["counting_probability"],"prerequisiteConcepts":["arith_fractions"],"skills":["equally_likely_probability"],"patterns":["favorable_over_total"],"misconceptions":["counts_boundary_as_favorable"],"isAutoGradable":true,"solution":"The favorable outcomes are 5 and 6, so the probability is 2/6=1/3.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-probability","chapterTitle":"Probability","sequence":28201},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_prob_002","statement":"A bag contains 3 red and 2 blue marbles. Two marbles are drawn without replacement. What is the probability that both are red?","answer":"3/10","answerType":"multiple_choice","choices":[{"value":"1/5","text":"1/5"},{"value":"3/10","text":"3/10"},{"value":"2/5","text":"2/5"},{"value":"1/2","text":"1/2"},{"value":"3/5","text":"3/5"}],"difficulty":3,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"counting_probability","concepts":["counting_probability","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["probability_without_replacement"],"patterns":["multiply_conditional_probabilities"],"misconceptions":["does_not_update_total"],"isAutoGradable":true,"solution":"The probability is (3/5)*(2/4)=6/20=3/10.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-probability","chapterTitle":"Probability","sequence":28202},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_prob_003","statement":"A fair coin is flipped three times. What is the probability of getting exactly one head?","answer":"3/8","answerType":"multiple_choice","choices":[{"value":"1/8","text":"1/8"},{"value":"1/4","text":"1/4"},{"value":"3/8","text":"3/8"},{"value":"1/2","text":"1/2"},{"value":"5/8","text":"5/8"}],"difficulty":4,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"counting_probability","concepts":["counting_probability","counting_combinations"],"prerequisiteConcepts":["counting_principle"],"skills":["count_exact_outcomes"],"patterns":["count_outcomes_then_divide"],"misconceptions":["counts_only_one_order"],"isAutoGradable":true,"solution":"There are 8 equally likely outcomes and H can occur in any one of 3 positions, giving 3/8.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-probability","chapterTitle":"Probability","sequence":28203},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"amc8_anchor_v2_perm_001","statement":"In how many different orders can 3 distinct books be arranged on a shelf?","answer":"6","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"9","text":"9"}],"difficulty":2,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"counting_permutations","concepts":["counting_permutations","counting_principle"],"prerequisiteConcepts":["counting_principle"],"skills":["arrange_distinct_objects"],"patterns":["factorial_arrangement"],"misconceptions":["multiplies_object_count_by_two"],"isAutoGradable":true,"solution":"There are 3 choices, then 2, then 1, for 3*2*1=6 orders.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-permutations","chapterTitle":"Permutations","sequence":28301},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_perm_002","statement":"How many 3-letter arrangements can be made from A, B, C, and D if no letter is repeated?","answer":"24","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"12","text":"12"},{"value":"16","text":"16"},{"value":"24","text":"24"},{"value":"64","text":"64"}],"difficulty":3,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"counting_permutations","concepts":["counting_permutations","counting_principle"],"prerequisiteConcepts":["counting_principle"],"skills":["partial_permutation"],"patterns":["decreasing_choices"],"misconceptions":["allows_repetition"],"isAutoGradable":true,"solution":"The three positions have 4, 3, and 2 choices, so there are 4*3*2=24 arrangements.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-permutations","chapterTitle":"Permutations","sequence":28302},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_perm_003","statement":"How many distinct arrangements of the letters in LEVEL are possible?","answer":"30","answerType":"multiple_choice","choices":[{"value":"10","text":"10"},{"value":"20","text":"20"},{"value":"30","text":"30"},{"value":"60","text":"60"},{"value":"120","text":"120"}],"difficulty":4,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"counting_permutations","concepts":["counting_permutations"],"prerequisiteConcepts":["counting_principle"],"skills":["permutations_with_repetition"],"patterns":["divide_for_identical_objects"],"misconceptions":["treats_repeated_letters_as_distinct"],"isAutoGradable":true,"solution":"There are 5! arrangements before accounting for two Ls and two Es, so 5!/(2!*2!)=30.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-permutations","chapterTitle":"Permutations","sequence":28303},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"amc8_anchor_v2_gcd_001","statement":"What is the greatest common divisor of 18 and 30?","answer":"6","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"6","text":"6"},{"value":"9","text":"9"},{"value":"12","text":"12"}],"difficulty":2,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"nt_gcd","concepts":["nt_gcd","nt_factorization"],"prerequisiteConcepts":["nt_factorization"],"skills":["find_gcd"],"patterns":["largest_shared_factor"],"misconceptions":["selects_noncommon_factor"],"isAutoGradable":true,"solution":"The common factors are 1, 2, 3, and 6, so the greatest is 6.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-gcd","chapterTitle":"Greatest Common Divisor","sequence":28401},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_gcd_002","statement":"An 84-by-126 rectangle is tiled by congruent squares of the largest possible integer side length. What is that side length?","answer":"42","answerType":"multiple_choice","choices":[{"value":"6","text":"6"},{"value":"14","text":"14"},{"value":"21","text":"21"},{"value":"42","text":"42"},{"value":"63","text":"63"}],"difficulty":3,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"nt_gcd","concepts":["nt_gcd","geo_area"],"prerequisiteConcepts":["nt_factorization"],"skills":["apply_gcd_to_tiling"],"patterns":["largest_equal_unit"],"misconceptions":["uses_smaller_common_factor"],"isAutoGradable":true,"solution":"The square side must divide both dimensions, and gcd(84,126)=42.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-gcd","chapterTitle":"Greatest Common Divisor","sequence":28402},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_gcd_003","statement":"What is the greatest positive integer that divides both 187 and 323?","answer":"17","answerType":"multiple_choice","choices":[{"value":"11","text":"11"},{"value":"17","text":"17"},{"value":"19","text":"19"},{"value":"34","text":"34"},{"value":"51","text":"51"}],"difficulty":4,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"nt_gcd","concepts":["nt_gcd","nt_factorization"],"prerequisiteConcepts":["nt_divisibility"],"skills":["euclidean_algorithm"],"patterns":["gcd_by_remainders"],"misconceptions":["chooses_common_multiple"],"isAutoGradable":true,"solution":"The Euclidean algorithm gives gcd(323,187)=gcd(187,136)=gcd(136,51)=gcd(51,34)=17.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-gcd","chapterTitle":"Greatest Common Divisor","sequence":28403},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"amc8_anchor_v2_rem_001","statement":"What is the remainder when 47 is divided by 6?","answer":"5","answerType":"multiple_choice","choices":[{"value":"1","text":"1"},{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"7","text":"7"}],"difficulty":2,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"nt_remainders","concepts":["nt_remainders","nt_divisibility"],"prerequisiteConcepts":["nt_divisibility"],"skills":["compute_remainder"],"patterns":["multiple_plus_remainder"],"misconceptions":["uses_quotient_as_remainder"],"isAutoGradable":true,"solution":"Since 47=6*7+5, the remainder is 5.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-remainders","chapterTitle":"Remainders","sequence":28501},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_rem_002","statement":"An integer n leaves remainder 4 when divided by 7. What remainder does 3n leave when divided by 7?","answer":"5","answerType":"multiple_choice","choices":[{"value":"1","text":"1"},{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"6","text":"6"}],"difficulty":3,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"nt_remainders","concepts":["nt_remainders","nt_modular"],"prerequisiteConcepts":["nt_divisibility"],"skills":["scale_remainders"],"patterns":["reduce_after_operation"],"misconceptions":["does_not_reduce_product"],"isAutoGradable":true,"solution":"Since n has the same remainder as 4, 3n has the same remainder as 12, which is 5 modulo 7.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-remainders","chapterTitle":"Remainders","sequence":28502},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_rem_003","statement":"What is the smallest integer greater than 100 that leaves remainder 3 when divided by 8 and remainder 5 when divided by 6?","answer":"107","answerType":"multiple_choice","choices":[{"value":"103","text":"103"},{"value":"107","text":"107"},{"value":"115","text":"115"},{"value":"123","text":"123"},{"value":"131","text":"131"}],"difficulty":4,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"nt_remainders","concepts":["nt_remainders","nt_lcm"],"prerequisiteConcepts":["nt_lcm"],"skills":["simultaneous_remainders"],"patterns":["test_arithmetic_progression"],"misconceptions":["satisfies_only_one_remainder"],"isAutoGradable":true,"solution":"Numbers above 100 that are 3 modulo 8 begin 107,115,123; 107 is also 5 modulo 6, so it is the smallest.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-remainders","chapterTitle":"Remainders","sequence":28503},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"amc8_anchor_v2_tri_001","statement":"The angles of a triangle measure 2x, 3x, and 4x degrees. What is the largest angle?","answer":"80 degrees","answerType":"multiple_choice","choices":[{"value":"40 degrees","text":"40 degrees"},{"value":"60 degrees","text":"60 degrees"},{"value":"70 degrees","text":"70 degrees"},{"value":"80 degrees","text":"80 degrees"},{"value":"90 degrees","text":"90 degrees"}],"difficulty":2,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["triangle_angle_sum"],"patterns":["parts_sum_to_180"],"misconceptions":["uses_360_degree_sum"],"isAutoGradable":true,"solution":"Since 2x+3x+4x=180, x=20 and the largest angle is 4x=80 degrees.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-triangle-angles","chapterTitle":"Triangle Angles","sequence":28601},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_tri_002","statement":"An exterior angle of a triangle is 125 degrees. One remote interior angle is 48 degrees. What is the other remote interior angle?","answer":"77 degrees","answerType":"multiple_choice","choices":[{"value":"55 degrees","text":"55 degrees"},{"value":"67 degrees","text":"67 degrees"},{"value":"77 degrees","text":"77 degrees"},{"value":"83 degrees","text":"83 degrees"},{"value":"173 degrees","text":"173 degrees"}],"difficulty":3,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["exterior_angle_theorem"],"patterns":["exterior_equals_remote_sum"],"misconceptions":["subtracts_from_180_first"],"isAutoGradable":true,"solution":"The two remote interior angles sum to 125 degrees, so the missing angle is 125-48=77 degrees.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-triangle-angles","chapterTitle":"Triangle Angles","sequence":28602},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_tri_003","statement":"An isosceles triangle has a vertex angle of 40 degrees. What is the exterior angle adjacent to either base angle?","answer":"110 degrees","answerType":"multiple_choice","choices":[{"value":"70 degrees","text":"70 degrees"},{"value":"90 degrees","text":"90 degrees"},{"value":"100 degrees","text":"100 degrees"},{"value":"110 degrees","text":"110 degrees"},{"value":"140 degrees","text":"140 degrees"}],"difficulty":4,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["isosceles_and_exterior_angles"],"patterns":["equal_base_angles_then_supplement"],"misconceptions":["reports_base_angle"],"isAutoGradable":true,"solution":"Each base angle is (180-40)/2=70 degrees, so its adjacent exterior angle is 180-70=110 degrees.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-triangle-angles","chapterTitle":"Triangle Angles","sequence":28603},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"amc8_anchor_v2_coord_001","statement":"What is the distance between (-3,4) and (5,4) in the coordinate plane?","answer":"8","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"4","text":"4"},{"value":"8","text":"8"},{"value":"9","text":"9"},{"value":"12","text":"12"}],"difficulty":2,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry","arith_absolute_value"],"prerequisiteConcepts":["arith_integers"],"skills":["horizontal_coordinate_distance"],"patterns":["absolute_difference"],"misconceptions":["adds_signed_coordinates"],"isAutoGradable":true,"solution":"The y-coordinates match, so the distance is |5-(-3)|=8.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-coordinate-geometry","chapterTitle":"Coordinate Geometry","sequence":28701},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_coord_002","statement":"What is the midpoint of the segment joining (-2,5) and (6,-1)?","answer":"(2,2)","answerType":"multiple_choice","choices":[{"value":"(2,-2)","text":"(2,-2)"},{"value":"(2,2)","text":"(2,2)"},{"value":"(4,2)","text":"(4,2)"},{"value":"(4,4)","text":"(4,4)"},{"value":"(8,4)","text":"(8,4)"}],"difficulty":3,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["coordinate_midpoint"],"patterns":["average_coordinates_separately"],"misconceptions":["adds_without_dividing"],"isAutoGradable":true,"solution":"Average the x-coordinates and y-coordinates separately: ((-2+6)/2,(5-1)/2)=(2,2).","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-coordinate-geometry","chapterTitle":"Coordinate Geometry","sequence":28702},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_coord_003","statement":"Points A=(1,1), B=(5,1), and C=(7,4) are consecutive vertices of parallelogram ABCD. What are the coordinates of D?","answer":"(3,4)","answerType":"multiple_choice","choices":[{"value":"(2,3)","text":"(2,3)"},{"value":"(3,4)","text":"(3,4)"},{"value":"(4,3)","text":"(4,3)"},{"value":"(6,4)","text":"(6,4)"},{"value":"(11,4)","text":"(11,4)"}],"difficulty":4,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry"],"prerequisiteConcepts":["arith_integers"],"skills":["translate_parallel_vector"],"patterns":["opposite_sides_same_vector"],"misconceptions":["adds_vector_in_wrong_direction"],"isAutoGradable":true,"solution":"Vector BC is (2,3), so AD must also be (2,3); adding it to A gives D=(3,4).","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-coordinate-geometry","chapterTitle":"Coordinate Geometry","sequence":28703},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"amc8_anchor_v2_cong_001","statement":"One triangle has side lengths 5, 7, and 8. A second triangle has side lengths 5, 7, and x. If the triangles are congruent by SSS, what is x?","answer":"8","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"8","text":"8"},{"value":"12","text":"12"}],"difficulty":2,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_congruence","concepts":["geo_congruence","geo_triangles"],"prerequisiteConcepts":["geo_triangles"],"skills":["apply_sss_congruence"],"patterns":["match_corresponding_sides"],"misconceptions":["adds_known_sides"],"isAutoGradable":true,"solution":"Congruent triangles have the same three side lengths, so the remaining side must be 8.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-congruence","chapterTitle":"Triangle Congruence","sequence":28801},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_cong_002","statement":"In triangles ABC and DEF, AB=DE and BC=EF. Which additional fact proves the triangles congruent by SAS?","answer":"angle B = angle E","answerType":"multiple_choice","choices":[{"value":"angle A = angle D","text":"angle A = angle D"},{"value":"angle B = angle E","text":"angle B = angle E"},{"value":"angle C = angle F","text":"angle C = angle F"},{"value":"AC = DF","text":"AC = DF"},{"value":"the perimeters are equal","text":"the perimeters are equal"}],"difficulty":3,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_congruence","concepts":["geo_congruence","geo_angles"],"prerequisiteConcepts":["geo_triangles"],"skills":["identify_included_angle"],"patterns":["side_angle_side"],"misconceptions":["uses_nonincluded_angle"],"isAutoGradable":true,"solution":"The included angles between AB and BC and between DE and EF are angle B and angle E.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-congruence","chapterTitle":"Triangle Congruence","sequence":28802},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"amc8_anchor_v2_cong_003","statement":"Two right triangles each have hypotenuse 13 and one corresponding leg 5. If one triangle's other leg is 12, what is the other triangle's remaining leg?","answer":"12","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"8","text":"8"},{"value":"12","text":"12"},{"value":"13","text":"13"},{"value":"18","text":"18"}],"difficulty":4,"source":"amc8_reviewed_anchors_v2_original","primaryConcept":"geo_congruence","concepts":["geo_congruence","geo_pythagorean"],"prerequisiteConcepts":["geo_pythagorean"],"skills":["hypotenuse_leg_congruence"],"patterns":["corresponding_parts_of_congruent_triangles"],"misconceptions":["adds_hypotenuse_and_leg"],"isAutoGradable":true,"solution":"Hypotenuse-leg congruence makes the right triangles congruent, so corresponding remaining legs are both 12.","curriculum":{"course":"AMC8","theme":"Reviewed Concept Anchors","chapter":"amc8-anchors-v2-congruence","chapterTitle":"Triangle Congruence","sequence":28803},"locale":{"language":"en-US","displayTrack":"AMC","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
