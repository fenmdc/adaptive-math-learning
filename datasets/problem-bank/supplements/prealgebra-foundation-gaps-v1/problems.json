  {"id":"prealg_gap_v1_simp_002","statement":"Simplify 4(2y-3).","answer":"8y-12","answerType":"multiple_choice","choices":[{"value":"6y-3","text":"6y-3"},{"value":"8y-3","text":"8y-3"},{"value":"8y-7","text":"8y-7"},{"value":"8y-12","text":"8y-12"},{"value":"8y+12","text":"8y+12"}],"difficulty":2,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_simplification","concepts":["prealg_simplification","prealg_expressions"],"prerequisiteConcepts":["arith_integers"],"skills":["distribute_positive_factor"],"patterns":["multiply_each_parenthesis_term"],"misconceptions":["distributes_to_first_term_only"],"isAutoGradable":true,"solution":"Multiply both terms by 4: 4(2y)-4(3)=8y-12.","curriculum":{"course":"Pre-Algebra","theme":"Simplification and Distribution","chapter":"prealgebra-foundation-gaps-v1-simplification","chapterTitle":"Simplification and Distribution Reviewed Practice","sequence":30202},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-simplification-p0","reviewStatus":"reviewed"},
