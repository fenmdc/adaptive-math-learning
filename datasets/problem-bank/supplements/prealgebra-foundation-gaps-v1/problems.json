  {"id":"prealg_gap_v1_eq_003","statement":"Solve 3x-4=20.","answer":"8","answerType":"multiple_choice","choices":[{"value":"16/3","text":"16/3"},{"value":"6","text":"6"},{"value":"8","text":"8"},{"value":"12","text":"12"},{"value":"24","text":"24"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations"],"prerequisiteConcepts":["arith_integers"],"skills":["solve_two_step_equation"],"patterns":["undo_constant_then_coefficient"],"misconceptions":["divides_before_removing_constant"],"isAutoGradable":true,"solution":"Add 4 to get 3x=24, then divide by 3 to get x=8.","curriculum":{"course":"Pre-Algebra","theme":"Linear Equations","chapter":"prealgebra-foundation-gaps-v1-equations","chapterTitle":"Linear Equations Reviewed Practice","sequence":30303},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-linear-equations-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_eq_004","statement":"Solve 4(x-2)=2x+10.","answer":"9","answerType":"multiple_choice","choices":[{"value":"1","text":"1"},{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"9","text":"9"},{"value":"18","text":"18"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","prealg_simplification"],"prerequisiteConcepts":["prealg_simplification"],"skills":["solve_variables_on_both_sides"],"patterns":["distribute_then_collect_variables"],"misconceptions":["fails_to_distribute_left_side"],"isAutoGradable":true,"solution":"Expand to 4x-8=2x+10. Then 2x=18, so x=9.","curriculum":{"course":"Pre-Algebra","theme":"Linear Equations","chapter":"prealgebra-foundation-gaps-v1-equations","chapterTitle":"Linear Equations Reviewed Practice","sequence":30304},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-linear-equations-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_eq_005","statement":"Solve (x-3)/4+2=5.","answer":"15","answerType":"multiple_choice","choices":[{"value":"9","text":"9"},{"value":"11","text":"11"},{"value":"12","text":"12"},{"value":"15","text":"15"},{"value":"31","text":"31"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["solve_fractional_linear_equation"],"patterns":["clear_outer_operations_in_reverse"],"misconceptions":["multiplies_before_subtracting_outside_constant"],"isAutoGradable":true,"solution":"Subtract 2: (x-3)/4=3. Multiply by 4: x-3=12, so x=15.","curriculum":{"course":"Pre-Algebra","theme":"Linear Equations","chapter":"prealgebra-foundation-gaps-v1-equations","chapterTitle":"Linear Equations Reviewed Practice","sequence":30305},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-linear-equations-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_eq_006","statement":"Solve 0.3x+4=0.1x+12.","answer":"40","answerType":"multiple_choice","choices":[{"value":"20","text":"20"},{"value":"30","text":"30"},{"value":"40","text":"40"},{"value":"60","text":"60"},{"value":"80","text":"80"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["solve_decimal_equation"],"patterns":["collect_decimal_coefficients"],"misconceptions":["subtracts_decimal_coefficients_in_wrong_order"],"isAutoGradable":true,"solution":"Subtract 0.1x and 4 to get 0.2x=8. Dividing by 0.2 gives x=40.","curriculum":{"course":"Pre-Algebra","theme":"Linear Equations","chapter":"prealgebra-foundation-gaps-v1-equations","chapterTitle":"Linear Equations Reviewed Practice","sequence":30306},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-linear-equations-p0","reviewStatus":"reviewed"},

  {"id":"prealg_gap_v1_ratio_001","statement":"The ratio of red beads to blue beads is 3:5. If there are 40 beads total, how many are red?","answer":"15","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"15","text":"15"},{"value":"20","text":"20"},{"value":"24","text":"24"},{"value":"25","text":"25"}],"difficulty":2,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"arith_ratios","concepts":["arith_ratios","arith_proportions"],"prerequisiteConcepts":["arith_fractions"],"skills":["partition_total_by_ratio"],"patterns":["ratio_parts_to_total"],"misconceptions":["uses_one_ratio_number_as_denominator"],"isAutoGradable":true,"solution":"There are 3+5=8 equal parts. Red beads use 3 parts, so 40(3/8)=15.","curriculum":{"course":"Pre-Algebra","theme":"Ratios Percent and Proportion","chapter":"prealgebra-foundation-gaps-v1-ratios","chapterTitle":"Ratios Percent and Proportion Reviewed Practice","sequence":30401},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-ratio-percent-proportion-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_ratio_002","statement":"What is 25% of 64?","answer":"16","answerType":"multiple_choice","choices":[{"value":"12","text":"12"},{"value":"16","text":"16"},{"value":"21","text":"21"},{"value":"25","text":"25"},{"value":"39","text":"39"}],"difficulty":2,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"arith_percentages","concepts":["arith_percentages","arith_fractions"],"prerequisiteConcepts":["arith_fractions"],"skills":["find_percent_of_quantity"],"patterns":["convert_percent_to_fraction"],"misconceptions":["subtracts_percent_number"],"isAutoGradable":true,"solution":"25%=1/4, and one fourth of 64 is 16.","curriculum":{"course":"Pre-Algebra","theme":"Ratios Percent and Proportion","chapter":"prealgebra-foundation-gaps-v1-ratios","chapterTitle":"Ratios Percent and Proportion Reviewed Practice","sequence":30402},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-ratio-percent-proportion-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_ratio_003","statement":"Seven notebooks cost $10.50 at a constant unit price. What do twelve notebooks cost?","answer":"$18.00","answerType":"multiple_choice","choices":[{"value":"$15.00","text":"$15.00"},{"value":"$16.50","text":"$16.50"},{"value":"$18.00","text":"$18.00"},{"value":"$18.50","text":"$18.50"},{"value":"$21.00","text":"$21.00"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["constant_unit_rate"],"patterns":["find_unit_rate_then_scale"],"misconceptions":["adds_quantity_difference_to_cost"],"isAutoGradable":true,"solution":"Each notebook costs $10.50/7=$1.50, so twelve cost 12($1.50)=$18.00.","curriculum":{"course":"Pre-Algebra","theme":"Ratios Percent and Proportion","chapter":"prealgebra-foundation-gaps-v1-ratios","chapterTitle":"Ratios Percent and Proportion Reviewed Practice","sequence":30403},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-ratio-percent-proportion-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_ratio_004","statement":"A jacket priced at $80 is discounted by 15%. What is the sale price?","answer":"$68","answerType":"multiple_choice","choices":[{"value":"$12","text":"$12"},{"value":"$65","text":"$65"},{"value":"$68","text":"$68"},{"value":"$72","text":"$72"},{"value":"$92","text":"$92"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"arith_percentages","concepts":["arith_percentages","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["percent_discount"],"patterns":["original_minus_discount_amount"],"misconceptions":["reports_discount_amount_as_sale_price"],"isAutoGradable":true,"solution":"The discount is 0.15(80)=$12, so the sale price is $80-$12=$68.","curriculum":{"course":"Pre-Algebra","theme":"Ratios Percent and Proportion","chapter":"prealgebra-foundation-gaps-v1-ratios","chapterTitle":"Ratios Percent and Proportion Reviewed Practice","sequence":30404},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-ratio-percent-proportion-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_ratio_005","statement":"A drink mixes water and concentrate in the ratio 5:2. If 28 cups of drink are made, how many cups are concentrate?","answer":"8","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"7","text":"7"},{"value":"8","text":"8"},{"value":"10","text":"10"},{"value":"20","text":"20"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"arith_ratios","concepts":["arith_ratios","arith_proportions"],"prerequisiteConcepts":["arith_fractions"],"skills":["ratio_mixture_partition"],"patterns":["target_parts_over_total_parts"],"misconceptions":["uses_water_parts_for_concentrate"],"isAutoGradable":true,"solution":"The ratio has 7 total parts and concentrate uses 2, so 28(2/7)=8 cups.","curriculum":{"course":"Pre-Algebra","theme":"Ratios Percent and Proportion","chapter":"prealgebra-foundation-gaps-v1-ratios","chapterTitle":"Ratios Percent and Proportion Reviewed Practice","sequence":30405},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-ratio-percent-proportion-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_ratio_006","statement":"A quantity of 120 increases by 20% and then decreases by 20%. What is the final quantity?","answer":"115.2","answerType":"multiple_choice","choices":[{"value":"96","text":"96"},{"value":"115.2","text":"115.2"},{"value":"120","text":"120"},{"value":"124.8","text":"124.8"},{"value":"144","text":"144"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"arith_percentages","concepts":["arith_percentages","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["successive_percent_change"],"patterns":["multiply_by_successive_factors"],"misconceptions":["cancels_equal_percent_changes"],"isAutoGradable":true,"solution":"After the increase the quantity is 120(1.2)=144. Then 144(0.8)=115.2.","curriculum":{"course":"Pre-Algebra","theme":"Ratios Percent and Proportion","chapter":"prealgebra-foundation-gaps-v1-ratios","chapterTitle":"Ratios Percent and Proportion Reviewed Practice","sequence":30406},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-ratio-percent-proportion-p0","reviewStatus":"reviewed"},

  {"id":"prealg_gap_v1_geo_001","statement":"What is the measure of an angle supplementary to 68°?","answer":"112°","answerType":"multiple_choice","choices":[{"value":"22°","text":"22°"},{"value":"68°","text":"68°"},{"value":"90°","text":"90°"},{"value":"112°","text":"112°"},{"value":"292°","text":"292°"}],"difficulty":2,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["supplementary_angles"],"patterns":["sum_to_180"],"misconceptions":["uses_complementary_sum"],"isAutoGradable":true,"solution":"Supplementary angles sum to 180°, so the angle is 180°-68°=112°.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30501},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_002","statement":"Two angles of a triangle measure 45° and 65°. What is the third angle?","answer":"70°","answerType":"multiple_choice","choices":[{"value":"55°","text":"55°"},{"value":"65°","text":"65°"},{"value":"70°","text":"70°"},{"value":"80°","text":"80°"},{"value":"110°","text":"110°"}],"difficulty":2,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_triangles"],"prerequisiteConcepts":["geo_angles"],"skills":["triangle_angle_sum"],"patterns":["subtract_known_angles_from_180"],"misconceptions":["subtracts_one_known_angle_only"],"isAutoGradable":true,"solution":"Triangle angles sum to 180°, so the third angle is 180°-45°-65°=70°.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30502},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_003","statement":"Two vertical angles measure (3x+10)° and (5x-30)°. What is x?","answer":"20","answerType":"multiple_choice","choices":[{"value":"10","text":"10"},{"value":"15","text":"15"},{"value":"20","text":"20"},{"value":"25","text":"25"},{"value":"40","text":"40"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["vertical_angle_equation"],"patterns":["set_vertical_angles_equal"],"misconceptions":["sets_vertical_angles_to_sum_180"],"isAutoGradable":true,"solution":"Vertical angles are equal, so 3x+10=5x-30. Thus 40=2x and x=20.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30503},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_004","statement":"A transversal crosses two parallel lines. If one corresponding angle measures 128°, what is the measure of the other corresponding angle?","answer":"128°","answerType":"multiple_choice","choices":[{"value":"38°","text":"38°"},{"value":"52°","text":"52°"},{"value":"90°","text":"90°"},{"value":"128°","text":"128°"},{"value":"232°","text":"232°"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["corresponding_angles_parallel_lines"],"patterns":["corresponding_angles_equal"],"misconceptions":["uses_supplement_instead_of_corresponding_angle"],"isAutoGradable":true,"solution":"When lines are parallel, corresponding angles are equal, so the other angle is 128°.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30504},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_005","statement":"An exterior angle of a triangle measures 125°. One remote interior angle measures 48°. What is the other remote interior angle?","answer":"77°","answerType":"multiple_choice","choices":[{"value":"55°","text":"55°"},{"value":"67°","text":"67°"},{"value":"77°","text":"77°"},{"value":"83°","text":"83°"},{"value":"173°","text":"173°"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["exterior_angle_theorem"],"patterns":["exterior_equals_remote_sum"],"misconceptions":["subtracts_from_180_instead_of_exterior_angle"],"isAutoGradable":true,"solution":"The exterior angle equals the sum of the remote interior angles, so 48°+x=125° and x=77°.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30505},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_006","statement":"An isosceles triangle has a vertex angle of 38°. What is the measure of each base angle?","answer":"71°","answerType":"multiple_choice","choices":[{"value":"38°","text":"38°"},{"value":"52°","text":"52°"},{"value":"71°","text":"71°"},{"value":"76°","text":"76°"},{"value":"142°","text":"142°"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_triangles"],"prerequisiteConcepts":["geo_angles"],"skills":["isosceles_base_angles"],"patterns":["split_remaining_angle_sum_equally"],"misconceptions":["divides_vertex_angle_in_half"],"isAutoGradable":true,"solution":"The two equal base angles share 180°-38°=142°, so each is 142°/2=71°.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30506},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_007","statement":"Two adjacent angles form a straight line. One angle measures 47°. What is the measure of the other angle?","answer":"133°","answerType":"multiple_choice","choices":[{"value":"43°","text":"43°"},{"value":"47°","text":"47°"},{"value":"90°","text":"90°"},{"value":"133°","text":"133°"},{"value":"227°","text":"227°"}],"difficulty":2,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["linear_pair_angles"],"patterns":["adjacent_angles_sum_to_180"],"misconceptions":["uses_complementary_sum"],"isAutoGradable":true,"solution":"Angles in a linear pair sum to 180°, so the other angle is 180°-47°=133°.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30507},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_008","statement":"Two parallel lines are cut by a transversal. A pair of same-side interior angles measure (2x+20)° and (4x+10)°. What is x?","answer":"25","answerType":"multiple_choice","choices":[{"value":"15","text":"15"},{"value":"20","text":"20"},{"value":"25","text":"25"},{"value":"30","text":"30"},{"value":"75","text":"75"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["same_side_interior_angle_equation"],"patterns":["supplementary_angles_on_parallel_lines"],"misconceptions":["sets_same_side_angles_equal"],"isAutoGradable":true,"solution":"Same-side interior angles are supplementary, so (2x+20)+(4x+10)=180. Thus 6x=150 and x=25.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30508},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_009","statement":"An exterior angle of a triangle measures (5x+15)°. Its two remote interior angles measure 2x° and (x+35)°. What is x?","answer":"10","answerType":"multiple_choice","choices":[{"value":"5","text":"5"},{"value":"10","text":"10"},{"value":"15","text":"15"},{"value":"20","text":"20"},{"value":"25","text":"25"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","alg_linear_equations"],"prerequisiteConcepts":["geo_angles","alg_linear_equations"],"skills":["exterior_angle_equation"],"patterns":["exterior_equals_remote_angle_sum"],"misconceptions":["adds_exterior_angle_to_remote_angles"],"isAutoGradable":true,"solution":"The exterior angle equals the sum of the remote interior angles: 5x+15=2x+x+35. Thus 2x=20 and x=10.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30509},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_geo_010","statement":"In an isosceles triangle, the vertex angle is 24° less than each base angle. What is the measure of the vertex angle?","answer":"44°","answerType":"multiple_choice","choices":[{"value":"24°","text":"24°"},{"value":"44°","text":"44°"},{"value":"52°","text":"52°"},{"value":"68°","text":"68°"},{"value":"78°","text":"78°"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_triangles","alg_linear_equations"],"prerequisiteConcepts":["geo_angles","alg_linear_equations"],"skills":["model_isosceles_angle_relationship"],"patterns":["two_equal_base_angles_and_vertex_difference"],"misconceptions":["subtracts_difference_after_dividing_180_by_three"],"isAutoGradable":true,"solution":"Let each base angle be b°. The vertex angle is b-24, so 2b+(b-24)=180. Then b=68 and the vertex angle is 44°.","curriculum":{"course":"Pre-Algebra","theme":"Geometry","chapter":"prealgebra-foundation-gaps-v1-geometry","chapterTitle":"Geometry Reviewed Practice","sequence":30510},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-geometry-p0","reviewStatus":"reviewed"}
]
