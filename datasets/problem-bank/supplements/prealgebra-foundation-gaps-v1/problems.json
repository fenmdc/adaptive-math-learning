  {"id":"prealg_gap_v1_simp_004","statement":"Simplify 3(2x-5)-2(x+1).","answer":"4x-17","answerType":"multiple_choice","choices":[{"value":"4x-17","text":"4x-17"},{"value":"4x-13","text":"4x-13"},{"value":"4x-7","text":"4x-7"},{"value":"8x-17","text":"8x-17"},{"value":"8x-13","text":"8x-13"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_simplification","concepts":["prealg_simplification","prealg_expressions"],"prerequisiteConcepts":["arith_integers"],"skills":["distribute_then_combine"],"patterns":["negative_factor_distribution"],"misconceptions":["fails_to_distribute_negative_factor"],"isAutoGradable":true,"solution":"Expand to 6x-15-2x-2, then combine to get 4x-17.","curriculum":{"course":"Pre-Algebra","theme":"Simplification and Distribution","chapter":"prealgebra-foundation-gaps-v1-simplification","chapterTitle":"Simplification and Distribution Reviewed Practice","sequence":30204},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-simplification-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_simp_005","statement":"Simplify 2(3x-4)-3(x-2).","answer":"3x-2","answerType":"multiple_choice","choices":[{"value":"3x-14","text":"3x-14"},{"value":"3x-2","text":"3x-2"},{"value":"3x+2","text":"3x+2"},{"value":"9x-10","text":"9x-10"},{"value":"9x-2","text":"9x-2"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_simplification","concepts":["prealg_simplification","prealg_expressions"],"prerequisiteConcepts":["arith_integers"],"skills":["simplify_nested_distribution"],"patterns":["subtract_parenthesized_expression"],"misconceptions":["keeps_both_inner_signs_after_subtraction"],"isAutoGradable":true,"solution":"2(3x-4)=6x-8 and -3(x-2)=-3x+6, so the result is 3x-2.","curriculum":{"course":"Pre-Algebra","theme":"Simplification and Distribution","chapter":"prealgebra-foundation-gaps-v1-simplification","chapterTitle":"Simplification and Distribution Reviewed Practice","sequence":30205},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-simplification-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_simp_006","statement":"Simplify (x+2)+(2x-5)-(x-4).","answer":"2x+1","answerType":"multiple_choice","choices":[{"value":"2x-7","text":"2x-7"},{"value":"2x+1","text":"2x+1"},{"value":"2x+9","text":"2x+9"},{"value":"4x-7","text":"4x-7"},{"value":"4x+1","text":"4x+1"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_simplification","concepts":["prealg_simplification","prealg_expressions"],"prerequisiteConcepts":["arith_integers"],"skills":["remove_parentheses_and_combine"],"patterns":["change_signs_after_subtraction"],"misconceptions":["does_not_change_sign_of_negative_group"],"isAutoGradable":true,"solution":"Remove parentheses: x+2+2x-5-x+4. Combining gives 2x+1.","curriculum":{"course":"Pre-Algebra","theme":"Simplification and Distribution","chapter":"prealgebra-foundation-gaps-v1-simplification","chapterTitle":"Simplification and Distribution Reviewed Practice","sequence":30206},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-simplification-p0","reviewStatus":"reviewed"},

