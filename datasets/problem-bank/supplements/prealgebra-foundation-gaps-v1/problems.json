  {"id":"prealg_gap_v1_expr_001","statement":"Evaluate 5a-2 when a=4.","answer":"18","answerType":"multiple_choice","choices":[{"value":"12","text":"12"},{"value":"18","text":"18"},{"value":"20","text":"20"},{"value":"22","text":"22"},{"value":"28","text":"28"}],"difficulty":2,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_substitution","concepts":["prealg_substitution","prealg_expressions"],"prerequisiteConcepts":["arith_integers"],"skills":["substitute_single_variable"],"patterns":["replace_then_evaluate"],"misconceptions":["subtracts_before_multiplying"],"isAutoGradable":true,"solution":"Substitute 4 for a: 5(4)-2=20-2=18.","curriculum":{"course":"Pre-Algebra","theme":"Expressions and Variables","chapter":"prealgebra-foundation-gaps-v1-expressions","chapterTitle":"Expressions and Variables Reviewed Practice","sequence":30101},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-expressions-variables-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_expr_002","statement":"Which expression means seven less than three times n?","answer":"3n-7","answerType":"multiple_choice","choices":[{"value":"3n-7","text":"3n-7"},{"value":"3(n-7)","text":"3(n-7)"},{"value":"7-3n","text":"7-3n"},{"value":"7n-3","text":"7n-3"},{"value":"3n+7","text":"3n+7"}],"difficulty":2,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","prealg_expressions"],"prerequisiteConcepts":["prealg_expressions"],"skills":["translate_phrase_to_expression"],"patterns":["quantity_less_than_product"],"misconceptions":["reverses_subtraction_order"],"isAutoGradable":true,"solution":"Three times n is 3n, and seven less than that is 3n-7.","curriculum":{"course":"Pre-Algebra","theme":"Expressions and Variables","chapter":"prealgebra-foundation-gaps-v1-expressions","chapterTitle":"Expressions and Variables Reviewed Practice","sequence":30102},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-expressions-variables-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_expr_003","statement":"Evaluate 2x+3y when x=-2 and y=5.","answer":"11","answerType":"multiple_choice","choices":[{"value":"-19","text":"-19"},{"value":"-11","text":"-11"},{"value":"7","text":"7"},{"value":"11","text":"11"},{"value":"19","text":"19"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_substitution","concepts":["prealg_substitution","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["substitute_two_variables"],"patterns":["evaluate_each_term_then_combine"],"misconceptions":["drops_negative_sign"],"isAutoGradable":true,"solution":"2(-2)+3(5)=-4+15=11.","curriculum":{"course":"Pre-Algebra","theme":"Expressions and Variables","chapter":"prealgebra-foundation-gaps-v1-expressions","chapterTitle":"Expressions and Variables Reviewed Practice","sequence":30103},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-expressions-variables-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_expr_004","statement":"A taxi ride costs $4 plus $2.50 per mile. If the total cost is $19, how many miles was the ride?","answer":"6","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"7.6","text":"7.6"},{"value":"9.2","text":"9.2"}],"difficulty":3,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","alg_linear_equations"],"prerequisiteConcepts":["arith_decimals"],"skills":["model_fixed_and_variable_cost"],"patterns":["fixed_fee_plus_rate"],"misconceptions":["divides_total_before_removing_fee"],"isAutoGradable":true,"solution":"Let m be the miles. Then 4+2.5m=19, so 2.5m=15 and m=6.","curriculum":{"course":"Pre-Algebra","theme":"Expressions and Variables","chapter":"prealgebra-foundation-gaps-v1-expressions","chapterTitle":"Expressions and Variables Reviewed Practice","sequence":30104},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-expressions-variables-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_expr_005","statement":"A rectangle has width w and length 2w+3. Its perimeter is 30. What is w?","answer":"4","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"4","text":"4"},{"value":"5","text":"5"},{"value":"6","text":"6"},{"value":"9","text":"9"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","geo_perimeter","alg_linear_equations"],"prerequisiteConcepts":["prealg_expressions"],"skills":["model_rectangle_perimeter"],"patterns":["twice_length_plus_width"],"misconceptions":["uses_length_plus_width_only"],"isAutoGradable":true,"solution":"2[w+(2w+3)]=30 gives 6w+6=30, so w=4.","curriculum":{"course":"Pre-Algebra","theme":"Expressions and Variables","chapter":"prealgebra-foundation-gaps-v1-expressions","chapterTitle":"Expressions and Variables Reviewed Practice","sequence":30105},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-expressions-variables-p0","reviewStatus":"reviewed"},
  {"id":"prealg_gap_v1_expr_006","statement":"Two positive integers have sum 42. The larger integer is 6 more than twice the smaller integer. What is the smaller integer?","answer":"12","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"14","text":"14"},{"value":"18","text":"18"}],"difficulty":4,"source":"prealgebra_foundation_gaps_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","alg_linear_equations"],"prerequisiteConcepts":["prealg_expressions"],"skills":["model_number_relationship"],"patterns":["sum_with_dependent_quantity"],"misconceptions":["uses_twice_sum_instead_of_twice_number"],"isAutoGradable":true,"solution":"Let x be the smaller integer. Then x+(2x+6)=42, so 3x=36 and x=12.","curriculum":{"course":"Pre-Algebra","theme":"Expressions and Variables","chapter":"prealgebra-foundation-gaps-v1-expressions","chapterTitle":"Expressions and Variables Reviewed Practice","sequence":30106},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"remediationTargetId":"prealgebra-expressions-variables-p0","reviewStatus":"reviewed"},

