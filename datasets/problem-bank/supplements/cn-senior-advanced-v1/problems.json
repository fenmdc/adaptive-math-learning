  {"id":"cn_senior_advanced_v1_piecewise_001","statement":"已知 f(x)=x²（x<0），f(x)=2x+1（x≥0），则 f(-2) 与 f(3) 依次是多少？","answer":"4,7","answerType":"multiple_choice","choices":[{"value":"-4,6","text":"-4，6"},{"value":"4,6","text":"4，6"},{"value":"4,7","text":"4，7"},{"value":"5,7","text":"5，7"},{"value":"-2,3","text":"-2，3"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g10_function_value_piecewise","primaryConcept":"alg_functions","concepts":["alg_functions"],"prerequisiteConcepts":["prealg_substitution"],"skills":["分段函数求值"],"patterns":["先判断自变量所在区间"],"misconceptions":["两个自变量使用同一段表达式"],"isAutoGradable":true,"solution":"-2<0，用x²得4；3≥0，用2x+1得7。","curriculum":{"course":"CN Senior High Math","theme":"高一函数基础","chapter":"cn-senior-advanced-v1-piecewise","chapterTitle":"分段与复合函数进阶练习","sequence":30401},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_piecewise_002","statement":"已知 f(x)=x+2（x<1），f(x)=ax+1（x≥1）。若两段在x=1处函数值相同，a等于多少？","answer":"2","answerType":"multiple_choice","choices":[{"value":"-2","text":"-2"},{"value":"0","text":"0"},{"value":"1","text":"1"},{"value":"2","text":"2"},{"value":"3","text":"3"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g10_function_piecewise_continuity_value","primaryConcept":"alg_functions","concepts":["alg_functions"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["分段函数衔接"],"patterns":["分界点两侧表达式值相等"],"misconceptions":["只代入包含等号的一段"],"isAutoGradable":true,"solution":"左段在x=1处对应值为3，右段为a+1，令a+1=3得a=2。","curriculum":{"course":"CN Senior High Math","theme":"高一函数基础","chapter":"cn-senior-advanced-v1-piecewise","chapterTitle":"分段与复合函数进阶练习","sequence":30402},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_piecewise_003","statement":"已知 f(x)=√x，g(x)=x-5，则复合函数 f(g(x)) 的定义域是？","answer":"x≥5","answerType":"multiple_choice","choices":[{"value":"x>0","text":"x>0"},{"value":"x≥0","text":"x≥0"},{"value":"x>5","text":"x>5"},{"value":"x≥5","text":"x≥5"},{"value":"全体实数","text":"全体实数"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g10_function_composite_domain","primaryConcept":"alg_functions","concepts":["alg_functions","alg_radicals"],"prerequisiteConcepts":["alg_linear_inequalities"],"skills":["复合函数定义域"],"patterns":["内层输出满足外层输入限制"],"misconceptions":["只使用f或g单独的定义域"],"isAutoGradable":true,"solution":"f(g(x))=√(x-5)，根号内需x-5≥0，所以x≥5。","curriculum":{"course":"CN Senior High Math","theme":"高一函数基础","chapter":"cn-senior-advanced-v1-piecewise","chapterTitle":"分段与复合函数进阶练习","sequence":30403},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_trig_001","statement":"化简 sin²x+cos²x+2sin²x，结果是？","answer":"1+2sin²x","answerType":"multiple_choice","choices":[{"value":"1","text":"1"},{"value":"1+sin²x","text":"1+sin²x"},{"value":"1+2sin²x","text":"1+2sin²x"},{"value":"2+sin²x","text":"2+sin²x"},{"value":"3sin²x","text":"3sin²x"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g10_trig_identity_simplify","primaryConcept":"trig_identities","concepts":["trig_identities"],"prerequisiteConcepts":["trig_functions"],"skills":["同角三角恒等式"],"patterns":["sin²x+cos²x=1"],"misconceptions":["把全部三项直接合并"],"isAutoGradable":true,"solution":"由sin²x+cos²x=1，原式=1+2sin²x。","curriculum":{"course":"CN Senior High Math","theme":"高一三角函数","chapter":"cn-senior-advanced-v1-trig","chapterTitle":"三角恒等式与方程进阶练习","sequence":30501},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_trig_002","statement":"在[0,2π]上，方程 sin x=1/2 的解是？","answer":"π/6,5π/6","answerType":"multiple_choice","choices":[{"value":"π/6","text":"π/6"},{"value":"π/6,5π/6","text":"π/6，5π/6"},{"value":"π/3,2π/3","text":"π/3，2π/3"},{"value":"5π/6,7π/6","text":"5π/6，7π/6"},{"value":"π/6,11π/6","text":"π/6，11π/6"}],"difficulty":4,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g10_trig_equation_basic","primaryConcept":"trig_equations","concepts":["trig_equations","trig_unit_circle"],"prerequisiteConcepts":["trig_functions"],"skills":["正弦方程"],"patterns":["第一与第二象限同正弦值"],"misconceptions":["只写一个解或象限判断错误"],"isAutoGradable":true,"solution":"参考角为π/6，正弦在第一、第二象限为正，解为π/6和5π/6。","curriculum":{"course":"CN Senior High Math","theme":"高一三角函数","chapter":"cn-senior-advanced-v1-trig","chapterTitle":"三角恒等式与方程进阶练习","sequence":30502},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_trig_003","statement":"已知 sin x=3/5，且x为第一象限角，则 cos x 与 tan x 依次为？","answer":"4/5,3/4","answerType":"multiple_choice","choices":[{"value":"3/5,4/3","text":"3/5，4/3"},{"value":"4/5,3/4","text":"4/5，3/4"},{"value":"-4/5,-3/4","text":"-4/5，-3/4"},{"value":"4/5,4/3","text":"4/5，4/3"},{"value":"2/5,3/2","text":"2/5，3/2"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g10_trig_identity_tangent","primaryConcept":"trig_identities","concepts":["trig_identities","trig_functions"],"prerequisiteConcepts":["geo_pythagorean"],"skills":["平方关系与商数关系"],"patterns":["三四五直角三角形"],"misconceptions":["正切分子分母颠倒"],"isAutoGradable":true,"solution":"第一象限cos x=√(1-9/25)=4/5，tan x=(3/5)/(4/5)=3/4。","curriculum":{"course":"CN Senior High Math","theme":"高一三角函数","chapter":"cn-senior-advanced-v1-trig","chapterTitle":"三角恒等式与方程进阶练习","sequence":30503},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_sequence_001","statement":"数列满足a₁=2，aₙ₊₁=aₙ+3n，则a₄等于多少？","answer":"20","answerType":"multiple_choice","choices":[{"value":"11","text":"11"},{"value":"14","text":"14"},{"value":"17","text":"17"},{"value":"20","text":"20"},{"value":"23","text":"23"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g11_sequence_recursive","primaryConcept":"alg_sequences_series","concepts":["alg_sequences_series"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["递推数列逐项计算"],"patterns":["每步增量随n变化"],"misconceptions":["把3n当作固定公差"],"isAutoGradable":true,"solution":"a₂=5，a₃=11，a₄=11+3×3=20。","curriculum":{"course":"CN Senior High Math","theme":"高二数列","chapter":"cn-senior-advanced-v1-sequences","chapterTitle":"数列递推进阶练习","sequence":30601},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_sequence_002","statement":"数列满足a₁=5，aₙ₊₁=aₙ+2，它的通项公式是？","answer":"aₙ=2n+3","answerType":"multiple_choice","choices":[{"value":"aₙ=2n+1","text":"aₙ=2n+1"},{"value":"aₙ=2n+3","text":"aₙ=2n+3"},{"value":"aₙ=2n+5","text":"aₙ=2n+5"},{"value":"aₙ=5n+2","text":"aₙ=5n+2"},{"value":"aₙ=5×2ⁿ⁻¹","text":"aₙ=5×2ⁿ⁻¹"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g11_sequence_recursive_to_formula","primaryConcept":"alg_sequences_series","concepts":["alg_sequences_series"],"prerequisiteConcepts":["alg_functions"],"skills":["递推式转通项"],"patterns":["等差数列通项"],"misconceptions":["误把加2当作乘2"],"isAutoGradable":true,"solution":"这是首项5、公差2的等差数列，aₙ=5+2(n-1)=2n+3。","curriculum":{"course":"CN Senior High Math","theme":"高二数列","chapter":"cn-senior-advanced-v1-sequences","chapterTitle":"数列递推进阶练习","sequence":30602},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_sequence_003","statement":"等比数列中a₂=6、a₅=48，且公比为正，则首项与公比分别是？","answer":"3,2","answerType":"multiple_choice","choices":[{"value":"2,3","text":"2，3"},{"value":"3,2","text":"3，2"},{"value":"6,2","text":"6，2"},{"value":"3,4","text":"3，4"},{"value":"6,8","text":"6，8"}],"difficulty":4,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g11_sequence_geometric_ratio_from_terms","primaryConcept":"alg_sequences_series","concepts":["alg_sequences_series"],"prerequisiteConcepts":["arith_exponents"],"skills":["由项求等比参数"],"patterns":["两项相除消去首项"],"misconceptions":["指数差计算错误"],"isAutoGradable":true,"solution":"a₅/a₂=q³=48/6=8，正公比q=2；a₁=6/2=3。","curriculum":{"course":"CN Senior High Math","theme":"高二数列","chapter":"cn-senior-advanced-v1-sequences","chapterTitle":"数列递推进阶练习","sequence":30603},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_conics_001","statement":"焦点为F(0,2)、准线为y=-2的抛物线标准方程是？","answer":"x²=8y","answerType":"multiple_choice","choices":[{"value":"x²=4y","text":"x²=4y"},{"value":"x²=8y","text":"x²=8y"},{"value":"y²=8x","text":"y²=8x"},{"value":"x²=-8y","text":"x²=-8y"},{"value":"y²=-8x","text":"y²=-8x"}],"difficulty":4,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g11_parabola_focus_directrix","primaryConcept":"geo_conics","concepts":["geo_conics"],"prerequisiteConcepts":["geo_coordinate_geometry"],"skills":["抛物线定义与标准方程"],"patterns":["焦点(0,p)对应x²=4py"],"misconceptions":["把p或方向写错"],"isAutoGradable":true,"solution":"焦点(0,p)中p=2，开口向上，标准方程x²=4py=8y。","curriculum":{"course":"CN Senior High Math","theme":"高二解析几何","chapter":"cn-senior-advanced-v1-conics","chapterTitle":"圆锥曲线进阶练习","sequence":30701},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_conics_002","statement":"椭圆x²/25+y²/9=1的长轴长、短轴长和焦距依次是？","answer":"10,6,8","answerType":"multiple_choice","choices":[{"value":"5,3,4","text":"5，3，4"},{"value":"10,6,4","text":"10，6，4"},{"value":"10,6,8","text":"10，6，8"},{"value":"25,9,16","text":"25，9，16"},{"value":"10,8,6","text":"10，8，6"}],"difficulty":4,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g11_ellipse_basic_quantities","primaryConcept":"geo_conics","concepts":["geo_conics"],"prerequisiteConcepts":["geo_pythagorean"],"skills":["椭圆基本量"],"patterns":["c²=a²-b²与轴长为二倍"],"misconceptions":["把a、b、c当作完整轴长和焦距"],"isAutoGradable":true,"solution":"a=5、b=3、c=4，长轴2a=10、短轴2b=6、焦距2c=8。","curriculum":{"course":"CN Senior High Math","theme":"高二解析几何","chapter":"cn-senior-advanced-v1-conics","chapterTitle":"圆锥曲线进阶练习","sequence":30702},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_conics_003","statement":"直线y=x与圆x²+y²=8的交点是？","answer":"(-2,-2),(2,2)","answerType":"multiple_choice","choices":[{"value":"(-4,-4),(4,4)","text":"(-4,-4)，(4,4)"},{"value":"(-2,2),(2,-2)","text":"(-2,2)，(2,-2)"},{"value":"(-2,-2),(2,2)","text":"(-2,-2)，(2,2)"},{"value":"(-√2,-√2),(√2,√2)","text":"(-√2,-√2)，(√2,√2)"},{"value":"(0,0)","text":"(0,0)"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g11_line_circle_intersection","primaryConcept":"geo_conics","concepts":["geo_conics","geo_circles"],"prerequisiteConcepts":["alg_quadratics"],"skills":["直线与圆联立"],"patterns":["代入消元"],"misconceptions":["开平方或坐标符号错误"],"isAutoGradable":true,"solution":"代入y=x得2x²=8，x=±2；y=x，所以交点为(-2,-2)、(2,2)。","curriculum":{"course":"CN Senior High Math","theme":"高二解析几何","chapter":"cn-senior-advanced-v1-conics","chapterTitle":"圆锥曲线进阶练习","sequence":30703},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_derivative_001","statement":"函数f(x)=x³-3x的单调递增区间是？","answer":"(-∞,-1),(1,+∞)","answerType":"multiple_choice","choices":[{"value":"(-1,1)","text":"(-1,1)"},{"value":"(-∞,1)","text":"(-∞,1)"},{"value":"(-∞,-1),(1,+∞)","text":"(-∞,-1)，(1,+∞)"},{"value":"(-∞,-1),(-1,1)","text":"(-∞,-1)，(-1,1)"},{"value":"全体实数","text":"全体实数"}],"difficulty":4,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g12_derivative_monotonic_interval","primaryConcept":"alg_functions","concepts":["alg_functions","alg_quadratics"],"prerequisiteConcepts":["alg_linear_inequalities"],"skills":["导数符号判断单调性"],"patterns":["解f'(x)>0"],"misconceptions":["把导数为负区间当递增区间"],"isAutoGradable":true,"solution":"f'(x)=3(x²-1)，当x<-1或x>1时导数为正，所以函数递增。","curriculum":{"course":"CN Senior High Math","theme":"高三导数","chapter":"cn-senior-advanced-v1-derivatives","chapterTitle":"导数单调性进阶练习","sequence":30801},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_derivative_002","statement":"函数f(x)=x³-3x²+4的极大点和极小点依次是？","answer":"(0,4),(2,0)","answerType":"multiple_choice","choices":[{"value":"(0,0),(2,4)","text":"(0,0)，(2,4)"},{"value":"(0,4),(2,0)","text":"(0,4)，(2,0)"},{"value":"(-2,0),(0,4)","text":"(-2,0)，(0,4)"},{"value":"(1,2),(2,0)","text":"(1,2)，(2,0)"},{"value":"(0,4),(3,4)","text":"(0,4)，(3,4)"}],"difficulty":4,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g12_derivative_extreme_value","primaryConcept":"alg_functions","concepts":["alg_functions","alg_quadratics"],"prerequisiteConcepts":["alg_factoring"],"skills":["导数求极值点"],"patterns":["临界点两侧导数变号"],"misconceptions":["只求临界横坐标或颠倒极大极小"],"isAutoGradable":true,"solution":"f'=3x(x-2)，在x=0由正变负取极大值4，在x=2由负变正取极小值0。","curriculum":{"course":"CN Senior High Math","theme":"高三导数","chapter":"cn-senior-advanced-v1-derivatives","chapterTitle":"导数单调性进阶练习","sequence":30802},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_derivative_003","statement":"函数f(x)=x³-3kx在[1,+∞)上单调递增，k的取值范围是？","answer":"k≤1","answerType":"multiple_choice","choices":[{"value":"k<0","text":"k<0"},{"value":"k≤1","text":"k≤1"},{"value":"k<1","text":"k<1"},{"value":"k≥1","text":"k≥1"},{"value":"k>1","text":"k>1"}],"difficulty":5,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g12_derivative_increasing_parameter","primaryConcept":"alg_functions","concepts":["alg_functions","alg_quadratics"],"prerequisiteConcepts":["alg_linear_inequalities"],"skills":["含参函数单调性"],"patterns":["导数在区间恒非负"],"misconceptions":["只代入任意一点或误用严格不等号"],"isAutoGradable":true,"solution":"f'(x)=3(x²-k)。在x≥1时x²最小为1，恒有f'≥0要求k≤1。","curriculum":{"course":"CN Senior High Math","theme":"高三导数","chapter":"cn-senior-advanced-v1-derivatives","chapterTitle":"导数单调性进阶练习","sequence":30803},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_expectation_001","statement":"随机变量X取0、1、2的概率分别为0.2、0.5、0.3，则E(X)等于？","answer":"1.1","answerType":"multiple_choice","choices":[{"value":"0.8","text":"0.8"},{"value":"1","text":"1"},{"value":"1.1","text":"1.1"},{"value":"1.3","text":"1.3"},{"value":"1.5","text":"1.5"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g12_probability_expectation","primaryConcept":"prob_expected_value","concepts":["prob_expected_value"],"prerequisiteConcepts":["arith_decimals"],"skills":["离散随机变量期望"],"patterns":["取值乘概率后求和"],"misconceptions":["直接平均三个取值"],"isAutoGradable":true,"solution":"E(X)=0×0.2+1×0.5+2×0.3=1.1。","curriculum":{"course":"CN Senior High Math","theme":"高三概率统计","chapter":"cn-senior-advanced-v1-expectation","chapterTitle":"概率期望进阶练习","sequence":30901},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_expectation_002","statement":"某题答对概率为0.7，独立作答3次，恰好答对2次的概率是？","answer":"0.441","answerType":"multiple_choice","choices":[{"value":"0.147","text":"0.147"},{"value":"0.343","text":"0.343"},{"value":"0.441","text":"0.441"},{"value":"0.49","text":"0.49"},{"value":"0.7","text":"0.7"}],"difficulty":4,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g12_probability_binomial","primaryConcept":"prob_conditional","concepts":["prob_conditional"],"prerequisiteConcepts":["arith_decimals"],"skills":["二项分布概率"],"patterns":["组合数乘成功与失败概率"],"misconceptions":["遗漏三种成功位置"],"isAutoGradable":true,"solution":"概率为C(3,2)×0.7²×0.3=3×0.49×0.3=0.441。","curriculum":{"course":"CN Senior High Math","theme":"高三概率统计","chapter":"cn-senior-advanced-v1-expectation","chapterTitle":"概率期望进阶练习","sequence":30902},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_senior_advanced_v1_expectation_003","statement":"抽奖一次，得20元、5元、0元的概率分别为0.1、0.3、0.6，期望收益是多少元？","answer":"3.5","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"3.5","text":"3.5"},{"value":"5","text":"5"},{"value":"8.3","text":"8.3"}],"difficulty":3,"source":"cn_senior_advanced_v1_adaptation","sourceProblemId":"subjective_v0_zh_g12_probability_expectation_ticket","primaryConcept":"prob_expected_value","concepts":["prob_expected_value"],"prerequisiteConcepts":["arith_decimals"],"skills":["情境中的期望收益"],"patterns":["收益乘概率后求和"],"misconceptions":["只看最高奖金或忽略零收益概率"],"isAutoGradable":true,"solution":"期望收益=20×0.1+5×0.3+0×0.6=2+1.5=3.5元。","curriculum":{"course":"CN Senior High Math","theme":"高三概率统计","chapter":"cn-senior-advanced-v1-expectation","chapterTitle":"概率期望进阶练习","sequence":30903},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"高中","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
