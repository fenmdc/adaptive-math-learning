  {"id":"cn_junior_auto_v1_integer_003","statement":"数轴上点 A 表示 -4，点 B 表示 3。线段 AB 的长度是多少？","answer":"7","answerType":"multiple_choice","choices":[{"value":"-7","text":"-7"},{"value":"1","text":"1"},{"value":"3","text":"3"},{"value":"7","text":"7"},{"value":"12","text":"12"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_integer_absolute_value_explain","primaryConcept":"arith_absolute_value","concepts":["arith_absolute_value","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["数轴距离"],"patterns":["坐标差的绝对值"],"misconceptions":["距离取负数"],"isAutoGradable":true,"solution":"AB=|3-(-4)|=|7|=7。","curriculum":{"course":"CN Junior High Math","theme":"七年级有理数","chapter":"cn-junior-auto-v1-integers","chapterTitle":"有理数客观练习","sequence":27103},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_expr_001","statement":"长方形的长为 3x+2，宽为 x-1。它的周长化简后是多少？","answer":"8x+2","answerType":"multiple_choice","choices":[{"value":"4x+1","text":"4x+1"},{"value":"6x+2","text":"6x+2"},{"value":"8x+1","text":"8x+1"},{"value":"8x+2","text":"8x+2"},{"value":"3x^2-x-2","text":"3x^2-x-2"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_expression_simplify_area","primaryConcept":"prealg_simplification","concepts":["prealg_simplification","geo_perimeter"],"prerequisiteConcepts":["prealg_expressions"],"skills":["整式化简"],"patterns":["代入周长公式"],"misconceptions":["只计算一组长宽"],"isAutoGradable":true,"solution":"周长为 2(3x+2)+2(x-1)=6x+4+2x-2=8x+2。","curriculum":{"course":"CN Junior High Math","theme":"七年级整式初步","chapter":"cn-junior-auto-v1-expressions","chapterTitle":"整式客观练习","sequence":27201},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_expr_002","statement":"一列图形中第 1 个有 4 个小正方形，以后每增加一个图形就多 3 个。第 n 个图形有多少个小正方形？","answer":"3n+1","answerType":"multiple_choice","choices":[{"value":"3n","text":"3n"},{"value":"3n+1","text":"3n+1"},{"value":"4n","text":"4n"},{"value":"4n-1","text":"4n-1"},{"value":"n+3","text":"n+3"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_expression_sequence_rule","primaryConcept":"prealg_expressions","concepts":["prealg_expressions","alg_functions"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["规律列式"],"patterns":["首项加公差倍数"],"misconceptions":["把第一项写成四n"],"isAutoGradable":true,"solution":"第 n 个比第 1 个增加 n-1 次，每次加 3，所以 4+3(n-1)=3n+1。","curriculum":{"course":"CN Junior High Math","theme":"七年级整式初步","chapter":"cn-junior-auto-v1-expressions","chapterTitle":"整式客观练习","sequence":27202},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_expr_003","statement":"当 a=2、b=3 时，代数式 3a+7b-(6a+4b) 的值是多少？","answer":"3","answerType":"multiple_choice","choices":[{"value":"-9","text":"-9"},{"value":"-3","text":"-3"},{"value":"0","text":"0"},{"value":"3","text":"3"},{"value":"9","text":"9"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_expression_value_context","primaryConcept":"prealg_substitution","concepts":["prealg_substitution","prealg_simplification"],"prerequisiteConcepts":["prealg_expressions"],"skills":["代数式求值"],"patterns":["先代入再比较"],"misconceptions":["减号未分配到括号"],"isAutoGradable":true,"solution":"3×2+7×3=27，6×2+4×3=24，相减为 3。","curriculum":{"course":"CN Junior High Math","theme":"七年级整式初步","chapter":"cn-junior-auto-v1-expressions","chapterTitle":"整式客观练习","sequence":27203},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_equation_001","statement":"练习本和笔记本共 48 本，单价分别为 3 元和 5 元，总价 176 元。笔记本买了多少本？","answer":"16","answerType":"multiple_choice","choices":[{"value":"12","text":"12"},{"value":"16","text":"16"},{"value":"20","text":"20"},{"value":"24","text":"24"},{"value":"32","text":"32"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_linear_equation_application","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","prealg_word_to_equation"],"prerequisiteConcepts":["prealg_word_to_equation"],"skills":["总量总价建模"],"patterns":["一种数量表示另一种"],"misconceptions":["只使用总本数条件"],"isAutoGradable":true,"solution":"设笔记本 x 本，则 5x+3(48-x)=176，解得 2x=32，x=16。","curriculum":{"course":"CN Junior High Math","theme":"七年级方程应用","chapter":"cn-junior-auto-v1-equations","chapterTitle":"方程应用客观练习","sequence":27301},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_equation_002","statement":"三年后哥哥的年龄是妹妹年龄的 2 倍。哥哥现在 15 岁，妹妹现在多少岁？","answer":"6","answerType":"multiple_choice","choices":[{"value":"3","text":"3"},{"value":"6","text":"6"},{"value":"7.5","text":"7.5"},{"value":"9","text":"9"},{"value":"12","text":"12"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_equation_age_problem","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","prealg_word_to_equation"],"prerequisiteConcepts":["prealg_word_to_equation"],"skills":["年龄问题"],"patterns":["同时增加相同年数"],"misconceptions":["只给妹妹年龄加三"],"isAutoGradable":true,"solution":"设妹妹现在 x 岁，三年后有 15+3=2(x+3)，解得 x=6。","curriculum":{"course":"CN Junior High Math","theme":"七年级方程应用","chapter":"cn-junior-auto-v1-equations","chapterTitle":"方程应用客观练习","sequence":27302},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_equation_003","statement":"一本书打八折后再减 6 元，售价为 34 元。这本书的原价是多少元？","answer":"50","answerType":"multiple_choice","choices":[{"value":"32","text":"32"},{"value":"40","text":"40"},{"value":"42.5","text":"42.5"},{"value":"50","text":"50"},{"value":"56","text":"56"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_equation_discount_application","primaryConcept":"alg_linear_equations","concepts":["alg_linear_equations","arith_percentages"],"prerequisiteConcepts":["arith_percentages"],"skills":["折扣问题"],"patterns":["八折等于原价的零点八倍"],"misconceptions":["把八折理解为减八元"],"isAutoGradable":true,"solution":"设原价为 x 元，八折后为 0.8x，列方程 0.8x-6=34，解得 x=50。","curriculum":{"course":"CN Junior High Math","theme":"七年级方程应用","chapter":"cn-junior-auto-v1-equations","chapterTitle":"方程应用客观练习","sequence":27303},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_ineq_001","statement":"跳绳每根 18 元，另付运费 26 元，预算不超过 260 元。最多可以买多少根？","answer":"13","answerType":"multiple_choice","choices":[{"value":"12","text":"12"},{"value":"13","text":"13"},{"value":"14","text":"14"},{"value":"15","text":"15"},{"value":"18","text":"18"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_inequality_context","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities","prealg_word_to_equation"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["预算不等式"],"patterns":["向下取整"],"misconceptions":["忽略固定运费"],"isAutoGradable":true,"solution":"18x+26≤260，得 x≤13，所以最多 13 根。","curriculum":{"course":"CN Junior High Math","theme":"七年级不等式","chapter":"cn-junior-auto-v1-inequalities","chapterTitle":"不等式客观练习","sequence":27401},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_ineq_002","statement":"解不等式 3(x-2)+5>2x+7。","answer":"x>8","answerType":"multiple_choice","choices":[{"value":"x>2","text":"x>2"},{"value":"x<8","text":"x<8"},{"value":"x>8","text":"x>8"},{"value":"x≥8","text":"x≥8"},{"value":"x>12","text":"x>12"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_inequality_solution_set_explain","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities","prealg_simplification"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["一元一次不等式"],"patterns":["去括号合并同类项"],"misconceptions":["把严格不等号改成含等号"],"isAutoGradable":true,"solution":"化简得 3x-1>2x+7，两边减 2x 再加 1，得 x>8。","curriculum":{"course":"CN Junior High Math","theme":"七年级不等式","chapter":"cn-junior-auto-v1-inequalities","chapterTitle":"不等式客观练习","sequence":27402},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_ineq_003","statement":"门票每人 28 元，交通总费用 180 元，预算不超过 1000 元。最多可安排多少名学生？","answer":"29","answerType":"multiple_choice","choices":[{"value":"28","text":"28"},{"value":"29","text":"29"},{"value":"30","text":"30"},{"value":"35","text":"35"},{"value":"36","text":"36"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_inequality_ticket_budget","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["整数解"],"patterns":["预算上界"],"misconceptions":["把小数上界向上取整"],"isAutoGradable":true,"solution":"28x+180≤1000，得 x≤820/28≈29.29，因此最多 29 人。","curriculum":{"course":"CN Junior High Math","theme":"七年级不等式","chapter":"cn-junior-auto-v1-inequalities","chapterTitle":"不等式客观练习","sequence":27403},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_triangle_001","statement":"三角形 ABC 中，∠A 比 ∠B 大 20°，∠C 是 ∠B 的 2 倍。∠C 等于多少度？","answer":"80°","answerType":"multiple_choice","choices":[{"value":"40°","text":"40°"},{"value":"60°","text":"60°"},{"value":"70°","text":"70°"},{"value":"80°","text":"80°"},{"value":"100°","text":"100°"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_triangle_angle_application","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","alg_linear_equations"],"prerequisiteConcepts":["geo_triangle_angles"],"skills":["角度方程"],"patterns":["内角和建模"],"misconceptions":["忽略三角形内角和"],"isAutoGradable":true,"solution":"设 ∠B=x，则 (x+20)+x+2x=180，得 x=40，所以 ∠C=80°。","curriculum":{"course":"CN Junior High Math","theme":"七年级三角形","chapter":"cn-junior-auto-v1-triangles","chapterTitle":"三角形客观练习","sequence":27501},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_triangle_002","statement":"三角形 ABC 中，∠A=70°，∠B=50°，AD 平分 ∠A。∠CAD 等于多少度？","answer":"35°","answerType":"multiple_choice","choices":[{"value":"20°","text":"20°"},{"value":"30°","text":"30°"},{"value":"35°","text":"35°"},{"value":"50°","text":"50°"},{"value":"60°","text":"60°"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_triangle_angle_bisector_application","primaryConcept":"geo_angles","concepts":["geo_angles","geo_triangles"],"prerequisiteConcepts":["geo_angles"],"skills":["角平分线"],"patterns":["角度二等分"],"misconceptions":["用另一内角的一半"],"isAutoGradable":true,"solution":"AD 平分 70° 的 ∠A，因此 ∠CAD=70°÷2=35°。","curriculum":{"course":"CN Junior High Math","theme":"七年级三角形","chapter":"cn-junior-auto-v1-triangles","chapterTitle":"三角形客观练习","sequence":27502},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_triangle_003","statement":"三角形的两个内角分别为 48° 和 67°，与第三个内角相邻的外角是多少度？","answer":"115°","answerType":"multiple_choice","choices":[{"value":"65°","text":"65°"},{"value":"67°","text":"67°"},{"value":"105°","text":"105°"},{"value":"115°","text":"115°"},{"value":"180°","text":"180°"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_triangle_exterior_angle_proof","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_angles"],"prerequisiteConcepts":["geo_triangle_angles"],"skills":["三角形外角"],"patterns":["外角等于两远内角和"],"misconceptions":["用一百八十减两远内角和"],"isAutoGradable":true,"solution":"三角形外角等于两个不相邻内角之和，所以为 48°+67°=115°。","curriculum":{"course":"CN Junior High Math","theme":"七年级三角形","chapter":"cn-junior-auto-v1-triangles","chapterTitle":"三角形客观练习","sequence":27503},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_geometry_001","statement":"长方形的长比宽多 5 cm，周长为 38 cm。它的面积是多少平方厘米？","answer":"84","answerType":"multiple_choice","choices":[{"value":"38","text":"38"},{"value":"60","text":"60"},{"value":"72","text":"72"},{"value":"84","text":"84"},{"value":"144","text":"144"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_geometry_area_modeling","primaryConcept":"geo_area","concepts":["geo_area","geo_perimeter","alg_linear_equations"],"prerequisiteConcepts":["geo_perimeter"],"skills":["长方形建模"],"patterns":["先由周长求边长"],"misconceptions":["直接用周长乘边长差"],"isAutoGradable":true,"solution":"设宽 x，则 2[x+(x+5)]=38，得 x=7，长 12，面积 7×12=84。","curriculum":{"course":"CN Junior High Math","theme":"七年级几何应用","chapter":"cn-junior-auto-v1-geometry","chapterTitle":"几何应用客观练习","sequence":27601},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_geometry_002","statement":"从长 10 cm、宽 6 cm 的长方形中去掉一个边长 2 cm 的正方形，剩余面积是多少平方厘米？","answer":"56","answerType":"multiple_choice","choices":[{"value":"48","text":"48"},{"value":"52","text":"52"},{"value":"56","text":"56"},{"value":"58","text":"58"},{"value":"60","text":"60"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_geometry_composite_area","primaryConcept":"geo_area","concepts":["geo_area"],"prerequisiteConcepts":["geo_area"],"skills":["组合图形面积"],"patterns":["整体减去部分"],"misconceptions":["只减去边长二"],"isAutoGradable":true,"solution":"长方形面积为 60，去掉的正方形面积为 4，剩余 60-4=56。","curriculum":{"course":"CN Junior High Math","theme":"七年级几何应用","chapter":"cn-junior-auto-v1-geometry","chapterTitle":"几何应用客观练习","sequence":27602},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_geometry_003","statement":"一个长方体长 8 cm、宽 5 cm、高 3 cm，它的体积是多少立方厘米？","answer":"120","answerType":"multiple_choice","choices":[{"value":"16","text":"16"},{"value":"40","text":"40"},{"value":"80","text":"80"},{"value":"120","text":"120"},{"value":"240","text":"240"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_geometry_volume_units","primaryConcept":"geo_area","concepts":["geo_area"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["长方体体积"],"patterns":["长乘宽乘高"],"misconceptions":["只计算底面积"],"isAutoGradable":true,"solution":"体积为长×宽×高=8×5×3=120 立方厘米。","curriculum":{"course":"CN Junior High Math","theme":"七年级几何应用","chapter":"cn-junior-auto-v1-geometry","chapterTitle":"几何应用客观练习","sequence":27603},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_basicgeo_001","statement":"两条直线相交形成一对对顶角，其中一个角为 68°，另一个角是多少度？","answer":"68°","answerType":"multiple_choice","choices":[{"value":"22°","text":"22°"},{"value":"68°","text":"68°"},{"value":"90°","text":"90°"},{"value":"112°","text":"112°"},{"value":"136°","text":"136°"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_vertical_angles_supplementary_proof","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["对顶角"],"patterns":["对顶角相等"],"misconceptions":["把对顶角当邻补角"],"isAutoGradable":true,"solution":"两条直线相交所成的对顶角相等，因此另一个角也是 68°。","curriculum":{"course":"CN Junior High Math","theme":"七年级基础几何","chapter":"cn-junior-auto-v1-basic-geometry","chapterTitle":"基础几何客观练习","sequence":27701},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_basicgeo_002","statement":"两条平行线被一条直线所截，一个内错角为 124°，与它对应的另一个内错角是多少度？","answer":"124°","answerType":"multiple_choice","choices":[{"value":"56°","text":"56°"},{"value":"62°","text":"62°"},{"value":"90°","text":"90°"},{"value":"124°","text":"124°"},{"value":"236°","text":"236°"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_geometry_parallel_angle_proof","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["平行线角关系"],"patterns":["内错角相等"],"misconceptions":["把内错角当同旁内角"],"isAutoGradable":true,"solution":"两直线平行时内错角相等，所以另一个内错角为 124°。","curriculum":{"course":"CN Junior High Math","theme":"七年级基础几何","chapter":"cn-junior-auto-v1-basic-geometry","chapterTitle":"基础几何客观练习","sequence":27702},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_basicgeo_003","statement":"若直线 a∥b 且 b∥c，则 a 与 c 的位置关系是什么？","answer":"a∥c","answerType":"multiple_choice","choices":[{"value":"a∥c","text":"a∥c"},{"value":"a⊥c","text":"a⊥c"},{"value":"a 与 c 相交","text":"a 与 c 相交"},{"value":"a 与 c 重合","text":"a 与 c 重合"},{"value":"无法确定","text":"无法确定"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_parallel_angles_chain_proof","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["平行关系传递"],"patterns":["同平面内平行传递"],"misconceptions":["认为两直线都平行于第三条时互相垂直"],"isAutoGradable":true,"solution":"在同一平面内，两条直线都平行于同一条直线时，它们互相平行，因此 a∥c。","curriculum":{"course":"CN Junior High Math","theme":"七年级基础几何","chapter":"cn-junior-auto-v1-basic-geometry","chapterTitle":"基础几何客观练习","sequence":27703},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_stats_001","statement":"数据 6、8、8、10、13 加入一个数 x 后，六个数的平均数为 10。x 等于多少？","answer":"15","answerType":"multiple_choice","choices":[{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"15","text":"15"},{"value":"20","text":"20"},{"value":"25","text":"25"}],"difficulty":3,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_statistics_explanation","primaryConcept":"stats_mean","concepts":["stats_mean"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["平均数反求数据"],"patterns":["总量等于平均数乘个数"],"misconceptions":["用新平均数减原平均数"],"isAutoGradable":true,"solution":"六个数总和应为 60，原五个数和为 45，所以 x=15。","curriculum":{"course":"CN Junior High Math","theme":"七年级统计初步","chapter":"cn-junior-auto-v1-statistics","chapterTitle":"统计客观练习","sequence":27801},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_stats_002","statement":"数据 3、7、7、8、10、12、12、12 的中位数是多少？","answer":"9","answerType":"multiple_choice","choices":[{"value":"7","text":"7"},{"value":"8","text":"8"},{"value":"9","text":"9"},{"value":"10","text":"10"},{"value":"12","text":"12"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_statistics_median_mode","primaryConcept":"stats_median","concepts":["stats_median"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["偶数个数据的中位数"],"patterns":["中间两数平均"],"misconceptions":["只取一个中间数"],"isAutoGradable":true,"solution":"共有 8 个数据，中间两个是第 4、5 个，即 8 和 10，中位数为 9。","curriculum":{"course":"CN Junior High Math","theme":"七年级统计初步","chapter":"cn-junior-auto-v1-statistics","chapterTitle":"统计客观练习","sequence":27802},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"cn_junior_auto_v1_stats_003","statement":"6 次跳远成绩为 1.8、1.9、2.1、2.0、2.4、1.8 米。这组数据的极差是多少米？","answer":"0.6","answerType":"multiple_choice","choices":[{"value":"0.4","text":"0.4"},{"value":"0.5","text":"0.5"},{"value":"0.6","text":"0.6"},{"value":"1.8","text":"1.8"},{"value":"2.4","text":"2.4"}],"difficulty":2,"source":"cn_junior_auto_v1_adaptation","sourceProblemId":"subjective_v0_zh_g7_statistics_range_interpretation","primaryConcept":"stats_range","concepts":["stats_range","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["极差"],"patterns":["最大值减最小值"],"misconceptions":["把最大值作为极差"],"isAutoGradable":true,"solution":"最大值为 2.4，最小值为 1.8，极差为 2.4-1.8=0.6 米。","curriculum":{"course":"CN Junior High Math","theme":"七年级统计初步","chapter":"cn-junior-auto-v1-statistics","chapterTitle":"统计客观练习","sequence":27803},"locale":{"language":"zh-CN","displayTrack":"中文校内","gradeBand":"七年级","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
