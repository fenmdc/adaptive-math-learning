[
  {"id":"en_core_diag_v1_ratio_001","statement":"A recipe uses 2 cups of flour for 3 batches. How many cups are needed for 9 batches?","answer":"6","answerType":"multiple_choice","choices":[{"label":"A","value":"3","text":"3"},{"label":"B","value":"4","text":"4"},{"label":"C","value":"6","text":"6"},{"label":"D","value":"9","text":"9"},{"label":"E","value":"13.5","text":"13.5"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["scale_ratio"],"patterns":["multiplicative_scaling"],"misconceptions":["adds_scale_difference"],"isAutoGradable":true,"solution":"Nine batches are three times as many as three batches, so multiply 2 cups by 3 to get 6 cups.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-ratio-percent","chapterTitle":"Ratios and Percent","sequence":24101,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"ratio_scale","estimatedTimeSeconds":60},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ratio_002","statement":"Five notebooks cost $12.50 at the same unit price. What is the cost of one notebook?","answer":"$2.50","answerType":"multiple_choice","choices":[{"label":"A","value":"$0.40","text":"$0.40"},{"label":"B","value":"$2.50","text":"$2.50"},{"label":"C","value":"$5.00","text":"$5.00"},{"label":"D","value":"$7.50","text":"$7.50"},{"label":"E","value":"$62.50","text":"$62.50"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"arith_ratios","concepts":["arith_ratios","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["unit_rate"],"patterns":["total_divided_by_count"],"misconceptions":["reverses_rate_division"],"isAutoGradable":true,"solution":"Divide total cost by the number of notebooks: $12.50 ÷ 5 = $2.50 per notebook.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-ratio-percent","chapterTitle":"Ratios and Percent","sequence":24102,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"unit_rate","estimatedTimeSeconds":60},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ratio_003","statement":"What is 30% of 80?","answer":"24","answerType":"multiple_choice","choices":[{"label":"A","value":"18","text":"18"},{"label":"B","value":"24","text":"24"},{"label":"C","value":"30","text":"30"},{"label":"D","value":"50","text":"50"},{"label":"E","value":"240","text":"240"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"arith_percentages","concepts":["arith_percentages","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["percent_of_quantity"],"patterns":["convert_percent_then_multiply"],"misconceptions":["subtracts_percent_number"],"isAutoGradable":true,"solution":"Convert 30% to 0.30 and multiply: 0.30 × 80 = 24.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-ratio-percent","chapterTitle":"Ratios and Percent","sequence":24103,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"percent_of_number","estimatedTimeSeconds":55},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ratio_004","statement":"A $60 jacket is discounted by 25%. What is the sale price?","answer":"$45","answerType":"multiple_choice","choices":[{"label":"A","value":"$15","text":"$15"},{"label":"B","value":"$25","text":"$25"},{"label":"C","value":"$35","text":"$35"},{"label":"D","value":"$45","text":"$45"},{"label":"E","value":"$75","text":"$75"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"arith_percentages","concepts":["arith_percentages"],"prerequisiteConcepts":["arith_percentages"],"skills":["percent_discount"],"patterns":["original_minus_discount"],"misconceptions":["reports_discount_amount"],"isAutoGradable":true,"solution":"The discount is 0.25 × $60 = $15. Subtract it from the original price: $60 - $15 = $45.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-ratio-percent","chapterTitle":"Ratios and Percent","sequence":24104,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"discount_price","estimatedTimeSeconds":75},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ratio_005","statement":"A quantity increases from 40 to 50. What is the percent increase?","answer":"25%","answerType":"multiple_choice","choices":[{"label":"A","value":"10%","text":"10%"},{"label":"B","value":"20%","text":"20%"},{"label":"C","value":"25%","text":"25%"},{"label":"D","value":"40%","text":"40%"},{"label":"E","value":"80%","text":"80%"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"arith_percentages","concepts":["arith_percentages","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["percent_change"],"patterns":["change_over_original"],"misconceptions":["divides_change_by_new_value"],"isAutoGradable":true,"solution":"The increase is 10. Divide by the original 40: 10/40 = 0.25 = 25%.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-ratio-percent","chapterTitle":"Ratios and Percent","sequence":24105,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"percent_increase","estimatedTimeSeconds":85},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ratio_006","statement":"On a map, 3 centimeters represents 12 kilometers. How many kilometers does 7.5 centimeters represent?","answer":"30","answerType":"multiple_choice","choices":[{"label":"A","value":"18","text":"18"},{"label":"B","value":"24","text":"24"},{"label":"C","value":"30","text":"30"},{"label":"D","value":"36","text":"36"},{"label":"E","value":"90","text":"90"}],"difficulty":3,"source":"english_core_diagnostic_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["scale_conversion"],"patterns":["unit_rate_then_scale"],"misconceptions":["uses_additive_scale"],"isAutoGradable":true,"solution":"The scale is 12 ÷ 3 = 4 kilometers per centimeter. Then 7.5 × 4 = 30 kilometers.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-ratio-percent","chapterTitle":"Ratios and Percent","sequence":24106,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"map_scale","estimatedTimeSeconds":95},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_model_001","statement":"Which equation represents 'seven more than a number x is 19'?","answer":"x+7=19","answerType":"multiple_choice","choices":[{"label":"A","value":"7x=19","text":"7x=19"},{"label":"B","value":"x+7=19","text":"x+7=19"},{"label":"C","value":"x-7=19","text":"x-7=19"},{"label":"D","value":"7-x=19","text":"7-x=19"},{"label":"E","value":"x/7=19","text":"x/7=19"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","prealg_expressions"],"prerequisiteConcepts":["prealg_expressions"],"skills":["translate_addition_phrase"],"patterns":["verbal_to_symbolic"],"misconceptions":["treats_more_than_as_multiplication"],"isAutoGradable":true,"solution":"'Seven more than x' means x + 7, and 'is 19' means equals 19, giving x + 7 = 19.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-word-models","chapterTitle":"Word-to-Equation Modeling","sequence":24201,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"translate_equation","estimatedTimeSeconds":55},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_model_002","statement":"Maya has 4 fewer books than Leo, who has L books. Which expression gives Maya's number of books?","answer":"L-4","answerType":"multiple_choice","choices":[{"label":"A","value":"4-L","text":"4-L"},{"label":"B","value":"L-4","text":"L-4"},{"label":"C","value":"L+4","text":"L+4"},{"label":"D","value":"4L","text":"4L"},{"label":"E","value":"L/4","text":"L/4"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","prealg_expressions"],"prerequisiteConcepts":["prealg_expressions"],"skills":["translate_comparison"],"patterns":["fewer_than_order"],"misconceptions":["reverses_subtraction_order"],"isAutoGradable":true,"solution":"Maya has four fewer than Leo's L books, so subtract 4 from L: L - 4.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-word-models","chapterTitle":"Word-to-Equation Modeling","sequence":24202,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"comparison_expression","estimatedTimeSeconds":55},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_model_003","statement":"Three equal tickets and a $5 fee cost $29 total. Which equation finds the price p of one ticket?","answer":"3p+5=29","answerType":"multiple_choice","choices":[{"label":"A","value":"3(p+5)=29","text":"3(p+5)=29"},{"label":"B","value":"3p+5=29","text":"3p+5=29"},{"label":"C","value":"p+8=29","text":"p+8=29"},{"label":"D","value":"5p+3=29","text":"5p+3=29"},{"label":"E","value":"3p-5=29","text":"3p-5=29"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","alg_linear_equations"],"prerequisiteConcepts":["prealg_expressions"],"skills":["model_fixed_fee"],"patterns":["variable_cost_plus_fixed_cost"],"misconceptions":["multiplies_fixed_fee_per_item"],"isAutoGradable":true,"solution":"Three tickets cost 3p, and the fee is charged once, so the total equation is 3p + 5 = 29.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-word-models","chapterTitle":"Word-to-Equation Modeling","sequence":24203,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"fixed_fee_model","estimatedTimeSeconds":70},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_model_004","statement":"A rectangle has width w and length 3 more than its width. Which expression gives its perimeter?","answer":"4w+6","answerType":"multiple_choice","choices":[{"label":"A","value":"2w+3","text":"2w+3"},{"label":"B","value":"3w+3","text":"3w+3"},{"label":"C","value":"4w+3","text":"4w+3"},{"label":"D","value":"4w+6","text":"4w+6"},{"label":"E","value":"w^2+3w","text":"w^2+3w"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","geo_perimeter","prealg_simplification"],"prerequisiteConcepts":["geo_perimeter"],"skills":["model_perimeter","combine_like_terms"],"patterns":["substitute_dimension_expression"],"misconceptions":["uses_area_instead_of_perimeter"],"isAutoGradable":true,"solution":"The length is w+3. Perimeter is 2w+2(w+3)=2w+2w+6=4w+6.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-word-models","chapterTitle":"Word-to-Equation Modeling","sequence":24204,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"geometric_expression","estimatedTimeSeconds":90},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_model_005","statement":"A taxi charges $4 plus $2 per mile. If a ride costs $18, how many miles m were traveled?","answer":"7","answerType":"multiple_choice","choices":[{"label":"A","value":"5","text":"5"},{"label":"B","value":"7","text":"7"},{"label":"C","value":"9","text":"9"},{"label":"D","value":"11","text":"11"},{"label":"E","value":"14","text":"14"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["solve_cost_model"],"patterns":["fixed_plus_variable_cost"],"misconceptions":["divides_total_before_removing_fee"],"isAutoGradable":true,"solution":"Model the cost by 4+2m=18. Subtract 4 to get 2m=14, then divide by 2 to get m=7.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-word-models","chapterTitle":"Word-to-Equation Modeling","sequence":24205,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"solve_linear_model","estimatedTimeSeconds":85},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_model_006","statement":"The sum of three consecutive integers is 72. What is the middle integer?","answer":"24","answerType":"multiple_choice","choices":[{"label":"A","value":"22","text":"22"},{"label":"B","value":"23","text":"23"},{"label":"C","value":"24","text":"24"},{"label":"D","value":"25","text":"25"},{"label":"E","value":"26","text":"26"}],"difficulty":3,"source":"english_core_diagnostic_v1_original","primaryConcept":"prealg_word_to_equation","concepts":["prealg_word_to_equation","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["model_consecutive_integers"],"patterns":["symmetric_consecutive_sum"],"misconceptions":["uses_same_variable_three_times_without_offsets"],"isAutoGradable":true,"solution":"Let the middle integer be n. The integers are n-1, n, n+1, whose sum is 3n=72. Thus n=24.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-word-models","chapterTitle":"Word-to-Equation Modeling","sequence":24206,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"consecutive_integer_model","estimatedTimeSeconds":100},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ineq_001","statement":"Which value of x satisfies x+4<9?","answer":"3","answerType":"multiple_choice","choices":[{"label":"A","value":"3","text":"3"},{"label":"B","value":"5","text":"5"},{"label":"C","value":"6","text":"6"},{"label":"D","value":"9","text":"9"},{"label":"E","value":"13","text":"13"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["test_inequality_value"],"patterns":["substitute_and_compare"],"misconceptions":["treats_inequality_as_equation"],"isAutoGradable":true,"solution":"Substitute each value. For x=3, 3+4=7, and 7<9 is true; the other listed values do not satisfy the inequality.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":24301,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"test_inequality","estimatedTimeSeconds":55},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ineq_002","statement":"Solve the inequality 2x<14.","answer":"x<7","answerType":"multiple_choice","choices":[{"label":"A","value":"x<7","text":"x<7"},{"label":"B","value":"x>7","text":"x>7"},{"label":"C","value":"x<12","text":"x<12"},{"label":"D","value":"x=7","text":"x=7"},{"label":"E","value":"x>12","text":"x>12"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["divide_positive_inequality"],"patterns":["inverse_operation"],"misconceptions":["reverses_sign_for_positive_division"],"isAutoGradable":true,"solution":"Divide both sides by positive 2. The direction stays the same, giving x<7.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":24302,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"one_step_inequality","estimatedTimeSeconds":55},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ineq_003","statement":"Solve the inequality x-5≥2.","answer":"x≥7","answerType":"multiple_choice","choices":[{"label":"A","value":"x≥-3","text":"x≥-3"},{"label":"B","value":"x≤7","text":"x≤7"},{"label":"C","value":"x≥7","text":"x≥7"},{"label":"D","value":"x>7","text":"x>7"},{"label":"E","value":"x=7","text":"x=7"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["add_both_sides"],"patterns":["preserve_inclusive_boundary"],"misconceptions":["drops_equality_bar"],"isAutoGradable":true,"solution":"Add 5 to both sides to isolate x: x≥7. The equality bar remains because x=7 satisfies the original inequality.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":24303,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"inclusive_inequality","estimatedTimeSeconds":65},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ineq_004","statement":"Solve the inequality -3x>12.","answer":"x<-4","answerType":"multiple_choice","choices":[{"label":"A","value":"x>-4","text":"x>-4"},{"label":"B","value":"x<-4","text":"x<-4"},{"label":"C","value":"x<4","text":"x<4"},{"label":"D","value":"x>4","text":"x>4"},{"label":"E","value":"x=-4","text":"x=-4"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["divide_negative_inequality"],"patterns":["reverse_direction"],"misconceptions":["keeps_sign_after_negative_division"],"isAutoGradable":true,"solution":"Divide both sides by -3. Division by a negative reverses the inequality, so x<-4.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":24304,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"negative_coefficient_inequality","estimatedTimeSeconds":75},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ineq_005","statement":"Solve the inequality 3x+2≤17.","answer":"x≤5","answerType":"multiple_choice","choices":[{"label":"A","value":"x≤5","text":"x≤5"},{"label":"B","value":"x≥5","text":"x≥5"},{"label":"C","value":"x≤15","text":"x≤15"},{"label":"D","value":"x<5","text":"x<5"},{"label":"E","value":"x=5","text":"x=5"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["two_step_inequality"],"patterns":["undo_addition_then_multiplication"],"misconceptions":["stops_after_first_inverse_operation"],"isAutoGradable":true,"solution":"Subtract 2 to get 3x≤15, then divide by positive 3 to obtain x≤5.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":24305,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"two_step_inequality","estimatedTimeSeconds":80},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_ineq_006","statement":"A club needs at least $240. It has $75 and earns $15 per event. What is the least number of whole events needed?","answer":"11","answerType":"multiple_choice","choices":[{"label":"A","value":"10","text":"10"},{"label":"B","value":"11","text":"11"},{"label":"C","value":"12","text":"12"},{"label":"D","value":"16","text":"16"},{"label":"E","value":"21","text":"21"}],"difficulty":3,"source":"english_core_diagnostic_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities","prealg_word_to_equation"],"prerequisiteConcepts":["prealg_word_to_equation"],"skills":["model_minimum_requirement"],"patterns":["solve_then_apply_whole_number_constraint"],"misconceptions":["divides_target_without_subtracting_start"],"isAutoGradable":true,"solution":"Write 75+15e≥240. Then 15e≥165, so e≥11. The least whole number of events is 11.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":24306,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"minimum_count_inequality","estimatedTimeSeconds":100},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_coord_001","statement":"In which quadrant is the point (-3,4)?","answer":"Quadrant II","answerType":"multiple_choice","choices":[{"label":"A","value":"Quadrant I","text":"Quadrant I"},{"label":"B","value":"Quadrant II","text":"Quadrant II"},{"label":"C","value":"Quadrant III","text":"Quadrant III"},{"label":"D","value":"Quadrant IV","text":"Quadrant IV"},{"label":"E","value":"On an axis","text":"On an axis"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["identify_quadrant"],"patterns":["coordinate_signs"],"misconceptions":["reads_y_coordinate_first"],"isAutoGradable":true,"solution":"A negative x-coordinate and positive y-coordinate place the point in Quadrant II.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-coordinate","chapterTitle":"Coordinate Reasoning","sequence":24401,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"quadrant_identification","estimatedTimeSeconds":50},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_coord_002","statement":"What is the horizontal distance between (-2,5) and (6,5)?","answer":"8","answerType":"multiple_choice","choices":[{"label":"A","value":"4","text":"4"},{"label":"B","value":"6","text":"6"},{"label":"C","value":"8","text":"8"},{"label":"D","value":"10","text":"10"},{"label":"E","value":"13","text":"13"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry","arith_absolute_value"],"prerequisiteConcepts":["arith_integers"],"skills":["horizontal_distance"],"patterns":["absolute_coordinate_difference"],"misconceptions":["subtracts_absolute_values"],"isAutoGradable":true,"solution":"The y-coordinates match, so the distance is the absolute x-difference: |6-(-2)|=8.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-coordinate","chapterTitle":"Coordinate Reasoning","sequence":24402,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"horizontal_distance","estimatedTimeSeconds":55},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_coord_003","statement":"What is the midpoint of the segment with endpoints (2,4) and (8,10)?","answer":"(5,7)","answerType":"multiple_choice","choices":[{"label":"A","value":"(3,3)","text":"(3,3)"},{"label":"B","value":"(5,7)","text":"(5,7)"},{"label":"C","value":"(6,6)","text":"(6,6)"},{"label":"D","value":"(10,14)","text":"(10,14)"},{"label":"E","value":"(5,14)","text":"(5,14)"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry","stats_mean"],"prerequisiteConcepts":["stats_mean"],"skills":["midpoint_formula"],"patterns":["average_coordinates_separately"],"misconceptions":["adds_coordinates_without_dividing"],"isAutoGradable":true,"solution":"Average the x-coordinates and y-coordinates separately: ((2+8)/2,(4+10)/2)=(5,7).","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-coordinate","chapterTitle":"Coordinate Reasoning","sequence":24403,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"midpoint","estimatedTimeSeconds":70},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_coord_004","statement":"What is the slope of the line through (1,2) and (5,10)?","answer":"2","answerType":"multiple_choice","choices":[{"label":"A","value":"1/2","text":"1/2"},{"label":"B","value":"2","text":"2"},{"label":"C","value":"3","text":"3"},{"label":"D","value":"4","text":"4"},{"label":"E","value":"8","text":"8"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"alg_graphing","concepts":["alg_graphing","geo_coordinate_geometry"],"prerequisiteConcepts":["geo_coordinate_geometry"],"skills":["slope_from_points"],"patterns":["rise_over_run"],"misconceptions":["reverses_rise_and_run"],"isAutoGradable":true,"solution":"Slope is the change in y divided by the change in x: (10-2)/(5-1)=8/4=2.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-coordinate","chapterTitle":"Coordinate Reasoning","sequence":24404,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"slope_from_points","estimatedTimeSeconds":75},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_coord_005","statement":"A point starts at (-1,3), moves 4 units right and 5 units down. What are its new coordinates?","answer":"(3,-2)","answerType":"multiple_choice","choices":[{"label":"A","value":"(-5,8)","text":"(-5,8)"},{"label":"B","value":"(-5,-2)","text":"(-5,-2)"},{"label":"C","value":"(3,-2)","text":"(3,-2)"},{"label":"D","value":"(3,8)","text":"(3,8)"},{"label":"E","value":"(4,-5)","text":"(4,-5)"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry","arith_integers"],"prerequisiteConcepts":["arith_integers"],"skills":["coordinate_translation"],"patterns":["horizontal_changes_x_vertical_changes_y"],"misconceptions":["changes_wrong_coordinate"],"isAutoGradable":true,"solution":"Moving right adds 4 to x: -1+4=3. Moving down subtracts 5 from y: 3-5=-2, giving (3,-2).","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-coordinate","chapterTitle":"Coordinate Reasoning","sequence":24405,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"coordinate_translation","estimatedTimeSeconds":70},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_coord_006","statement":"A rectangle has vertices (1,1), (7,1), (7,5), and (1,5). What is its area?","answer":"24","answerType":"multiple_choice","choices":[{"label":"A","value":"10","text":"10"},{"label":"B","value":"20","text":"20"},{"label":"C","value":"22","text":"22"},{"label":"D","value":"24","text":"24"},{"label":"E","value":"35","text":"35"}],"difficulty":3,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_coordinate_geometry","concepts":["geo_coordinate_geometry","geo_area"],"prerequisiteConcepts":["geo_area"],"skills":["coordinate_rectangle_area"],"patterns":["coordinate_differences_as_dimensions"],"misconceptions":["uses_coordinates_as_side_lengths"],"isAutoGradable":true,"solution":"The width is 7-1=6 and the height is 5-1=4. The area is 6×4=24 square units.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-coordinate","chapterTitle":"Coordinate Reasoning","sequence":24406,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"coordinate_rectangle_area","estimatedTimeSeconds":85},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_angle_001","statement":"Two angles form a straight line. One angle measures 63°. What is the other angle?","answer":"117°","answerType":"multiple_choice","choices":[{"label":"A","value":"27°","text":"27°"},{"label":"B","value":"63°","text":"63°"},{"label":"C","value":"90°","text":"90°"},{"label":"D","value":"117°","text":"117°"},{"label":"E","value":"297°","text":"297°"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["supplementary_angles"],"patterns":["straight_angle_sum"],"misconceptions":["uses_complement_to_ninety"],"isAutoGradable":true,"solution":"Angles on a straight line sum to 180°, so the other angle is 180°-63°=117°.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-angles","chapterTitle":"Angle Relationships","sequence":24501,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"linear_pair","estimatedTimeSeconds":50},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_angle_002","statement":"Two complementary angles have measures 38° and x°. What is x?","answer":"52°","answerType":"multiple_choice","choices":[{"label":"A","value":"38°","text":"38°"},{"label":"B","value":"42°","text":"42°"},{"label":"C","value":"52°","text":"52°"},{"label":"D","value":"90°","text":"90°"},{"label":"E","value":"142°","text":"142°"}],"difficulty":1,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["complementary_angles"],"patterns":["right_angle_sum"],"misconceptions":["subtracts_from_one_eighty"],"isAutoGradable":true,"solution":"Complementary angles sum to 90°, so x=90°-38°=52°.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-angles","chapterTitle":"Angle Relationships","sequence":24502,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"complementary_angles","estimatedTimeSeconds":50},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_angle_003","statement":"Two lines intersect. One angle measures 74°. What is the measure of its vertical angle?","answer":"74°","answerType":"multiple_choice","choices":[{"label":"A","value":"16°","text":"16°"},{"label":"B","value":"74°","text":"74°"},{"label":"C","value":"90°","text":"90°"},{"label":"D","value":"106°","text":"106°"},{"label":"E","value":"148°","text":"148°"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["vertical_angles"],"patterns":["opposite_angles_equal"],"misconceptions":["treats_vertical_angles_as_supplementary"],"isAutoGradable":true,"solution":"Vertical angles are opposite angles formed by intersecting lines, and they have equal measure. The angle is 74°.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-angles","chapterTitle":"Angle Relationships","sequence":24503,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"vertical_angles","estimatedTimeSeconds":55},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_angle_004","statement":"A triangle has angles 45°, 65°, and x°. What is x?","answer":"70°","answerType":"multiple_choice","choices":[{"label":"A","value":"55°","text":"55°"},{"label":"B","value":"65°","text":"65°"},{"label":"C","value":"70°","text":"70°"},{"label":"D","value":"110°","text":"110°"},{"label":"E","value":"180°","text":"180°"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["triangle_angle_sum"],"patterns":["subtract_known_angles_from_one_eighty"],"misconceptions":["adds_known_angles_as_answer"],"isAutoGradable":true,"solution":"Triangle angles total 180°. The known angles total 110°, so x=180°-110°=70°.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-angles","chapterTitle":"Angle Relationships","sequence":24504,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"triangle_missing_angle","estimatedTimeSeconds":65},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_angle_005","statement":"Two parallel lines are cut by a transversal. One corresponding angle is 128°. What is the other corresponding angle?","answer":"128°","answerType":"multiple_choice","choices":[{"label":"A","value":"52°","text":"52°"},{"label":"B","value":"64°","text":"64°"},{"label":"C","value":"90°","text":"90°"},{"label":"D","value":"128°","text":"128°"},{"label":"E","value":"232°","text":"232°"}],"difficulty":2,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_angles","concepts":["geo_angles"],"prerequisiteConcepts":["geo_angles"],"skills":["corresponding_angles"],"patterns":["parallel_lines_equal_angles"],"misconceptions":["treats_corresponding_angles_as_supplementary"],"isAutoGradable":true,"solution":"When lines are parallel, corresponding angles formed by a transversal are congruent, so the other angle is 128°.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-angles","chapterTitle":"Angle Relationships","sequence":24505,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"corresponding_angles","estimatedTimeSeconds":65},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"en_core_diag_v1_angle_006","statement":"An isosceles triangle has a vertex angle of 32°. What is the measure of each base angle?","answer":"74°","answerType":"multiple_choice","choices":[{"label":"A","value":"32°","text":"32°"},{"label":"B","value":"58°","text":"58°"},{"label":"C","value":"64°","text":"64°"},{"label":"D","value":"74°","text":"74°"},{"label":"E","value":"148°","text":"148°"}],"difficulty":3,"source":"english_core_diagnostic_v1_original","primaryConcept":"geo_triangle_angles","concepts":["geo_triangle_angles","geo_triangles"],"prerequisiteConcepts":["geo_triangle_angles"],"skills":["isosceles_base_angles"],"patterns":["split_remaining_angle_sum_equally"],"misconceptions":["halves_vertex_angle"],"isAutoGradable":true,"solution":"The two equal base angles total 180°-32°=148°. Divide by 2 to get 74° for each base angle.","curriculum":{"course":"Pre-Algebra","theme":"Diagnostic Foundations","chapter":"english-core-diagnostic-v1-angles","chapterTitle":"Angle Relationships","sequence":24506,"sourceCollection":"english_core_diagnostic_v1"},"taxonomy":{"version":"v1","layer":"Diagnostic","problemType":"isosceles_base_angles","estimatedTimeSeconds":80},"locale":{"language":"en-US","curriculumSystem":"US","region":"US","displayTrack":"English Core","gradeBand":"Grades 6-8","contentStatus":"reviewed"},"reviewStatus":"reviewed"}
