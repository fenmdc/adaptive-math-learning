  {"id":"alg1_anchor_v1_ineq_001","statement":"Solve the inequality x+5<12. Which inequality describes all solutions?","answer":"x<7","answerType":"multiple_choice","choices":[{"value":"x<7","text":"x<7"},{"value":"x>7","text":"x>7"},{"value":"x<17","text":"x<17"},{"value":"x>17","text":"x>17"},{"value":"x=7","text":"x=7"}],"difficulty":1,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities"],"prerequisiteConcepts":["arith_integers"],"skills":["solve_one_step_inequality"],"patterns":["inverse_operation_preserves_order"],"misconceptions":["adds_instead_of_subtracts"],"isAutoGradable":true,"solution":"Subtract 5 from both sides to get x<7.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":27101},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_ineq_002","statement":"Solve -3x>=12. Which inequality describes all solutions?","answer":"x<=-4","answerType":"multiple_choice","choices":[{"value":"x>=-4","text":"x>=-4"},{"value":"x<=-4","text":"x<=-4"},{"value":"x>=4","text":"x>=4"},{"value":"x<=4","text":"x<=4"},{"value":"x=-4","text":"x=-4"}],"difficulty":2,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities"],"prerequisiteConcepts":["arith_integers"],"skills":["divide_inequality_by_negative"],"patterns":["reverse_order_when_multiplying_or_dividing_by_negative"],"misconceptions":["keeps_inequality_direction"],"isAutoGradable":true,"solution":"Divide both sides by -3 and reverse the inequality: x<=-4.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":27102},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_ineq_003","statement":"Solve the compound inequality -2<3x+1<=10.","answer":"-1<x<=3","answerType":"multiple_choice","choices":[{"value":"-1<x<=3","text":"-1<x<=3"},{"value":"-3<x<=9","text":"-3<x<=9"},{"value":"-1<=x<3","text":"-1<=x<3"},{"value":"x<=-1 or x>3","text":"x<=-1 or x>3"},{"value":"-2<x<=10","text":"-2<x<=10"}],"difficulty":3,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"alg_linear_inequalities","concepts":["alg_linear_inequalities"],"prerequisiteConcepts":["arith_integers"],"skills":["solve_compound_inequality"],"patterns":["apply_same_operation_to_three_parts"],"misconceptions":["changes_only_one_side"],"isAutoGradable":true,"solution":"Subtract 1 from all three parts to get -3<3x<=9, then divide by 3: -1<x<=3.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-inequalities","chapterTitle":"Linear Inequalities","sequence":27103},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"alg1_anchor_v1_exp_001","statement":"Evaluate 2^3*2^4 using the product rule for exponents.","answer":"128","answerType":"multiple_choice","choices":[{"value":"16","text":"16"},{"value":"32","text":"32"},{"value":"64","text":"64"},{"value":"128","text":"128"},{"value":"256","text":"256"}],"difficulty":1,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_exponents","concepts":["arith_exponents"],"prerequisiteConcepts":["arith_integers"],"skills":["multiply_same_base_powers"],"patterns":["add_exponents_for_same_base"],"misconceptions":["multiplies_exponents"],"isAutoGradable":true,"solution":"2^3*2^4=2^(3+4)=2^7=128.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-exponents","chapterTitle":"Exponent Rules","sequence":27201},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_exp_002","statement":"Evaluate (3^2)^3 using the power-of-a-power rule.","answer":"729","answerType":"multiple_choice","choices":[{"value":"81","text":"81"},{"value":"243","text":"243"},{"value":"512","text":"512"},{"value":"729","text":"729"},{"value":"6561","text":"6561"}],"difficulty":2,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_exponents","concepts":["arith_exponents"],"prerequisiteConcepts":["arith_integers"],"skills":["power_of_a_power"],"patterns":["multiply_exponents"],"misconceptions":["adds_exponents"],"isAutoGradable":true,"solution":"(3^2)^3=3^(2*3)=3^6=729.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-exponents","chapterTitle":"Exponent Rules","sequence":27202},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_exp_003","statement":"Simplify (2x^3y^2)^2.","answer":"4x^6y^4","answerType":"multiple_choice","choices":[{"value":"2x^5y^4","text":"2x^5y^4"},{"value":"4x^5y^4","text":"4x^5y^4"},{"value":"4x^6y^2","text":"4x^6y^2"},{"value":"4x^6y^4","text":"4x^6y^4"},{"value":"8x^6y^4","text":"8x^6y^4"}],"difficulty":3,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_exponents","concepts":["arith_exponents","prealg_expressions"],"prerequisiteConcepts":["prealg_expressions"],"skills":["power_of_a_product"],"patterns":["distribute_power_and_multiply_exponents"],"misconceptions":["applies_power_to_variables_but_not_coefficient"],"isAutoGradable":true,"solution":"Square each factor: 2^2*x^(3*2)*y^(2*2)=4x^6y^4.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-exponents","chapterTitle":"Exponent Rules","sequence":27203},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"alg1_anchor_v1_roots_001","statement":"What is the principal square root of 81?","answer":"9","answerType":"multiple_choice","choices":[{"value":"-9","text":"-9"},{"value":"8","text":"8"},{"value":"9","text":"9"},{"value":"18","text":"18"},{"value":"40.5","text":"40.5"}],"difficulty":1,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_roots","concepts":["arith_roots"],"prerequisiteConcepts":["arith_exponents"],"skills":["evaluate_perfect_square_root"],"patterns":["inverse_of_squaring"],"misconceptions":["returns_negative_root_for_principal_symbol"],"isAutoGradable":true,"solution":"Because 9^2=81, the principal square root is 9.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-roots","chapterTitle":"Radicals","sequence":27301},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_roots_002","statement":"Simplify sqrt(50) by removing the greatest perfect-square factor.","answer":"5sqrt(2)","answerType":"multiple_choice","choices":[{"value":"2sqrt(5)","text":"2sqrt(5)"},{"value":"5sqrt(2)","text":"5sqrt(2)"},{"value":"5sqrt(5)","text":"5sqrt(5)"},{"value":"10sqrt(2)","text":"10sqrt(2)"},{"value":"25sqrt(2)","text":"25sqrt(2)"}],"difficulty":2,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_roots","concepts":["arith_roots","nt_factorization"],"prerequisiteConcepts":["nt_factorization","arith_exponents"],"skills":["simplify_radical"],"patterns":["extract_perfect_square"],"misconceptions":["extracts_factor_without_square_rooting"],"isAutoGradable":true,"solution":"50=25*2, so sqrt(50)=sqrt(25)*sqrt(2)=5sqrt(2).","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-roots","chapterTitle":"Radicals","sequence":27302},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_roots_003","statement":"Solve sqrt(x+1)=5. What is x?","answer":"24","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"6","text":"6"},{"value":"16","text":"16"},{"value":"24","text":"24"},{"value":"26","text":"26"}],"difficulty":3,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_roots","concepts":["arith_roots","alg_linear_equations"],"prerequisiteConcepts":["alg_linear_equations"],"skills":["solve_simple_radical_equation"],"patterns":["square_then_isolate"],"misconceptions":["subtracts_one_before_squaring"],"isAutoGradable":true,"solution":"Square both sides to get x+1=25, then subtract 1: x=24.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-roots","chapterTitle":"Radicals","sequence":27303},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"alg1_anchor_v1_ratio_001","statement":"Simplify the ratio 12:18 to lowest terms.","answer":"2:3","answerType":"multiple_choice","choices":[{"value":"1:2","text":"1:2"},{"value":"2:3","text":"2:3"},{"value":"3:2","text":"3:2"},{"value":"4:9","text":"4:9"},{"value":"12:6","text":"12:6"}],"difficulty":1,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_ratios","concepts":["arith_ratios","nt_gcd"],"prerequisiteConcepts":["nt_gcd"],"skills":["simplify_ratio"],"patterns":["divide_both_terms_by_gcd"],"misconceptions":["reverses_ratio_order"],"isAutoGradable":true,"solution":"gcd(12,18)=6. Divide both terms by 6 to get 2:3.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-ratios","chapterTitle":"Ratios","sequence":27401},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_ratio_002","statement":"A total of 45 is divided in the ratio 2:3. What are the two parts, in that order?","answer":"18 and 27","answerType":"multiple_choice","choices":[{"value":"15 and 30","text":"15 and 30"},{"value":"18 and 27","text":"18 and 27"},{"value":"20 and 25","text":"20 and 25"},{"value":"27 and 18","text":"27 and 18"},{"value":"30 and 45","text":"30 and 45"}],"difficulty":2,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_ratios","concepts":["arith_ratios"],"prerequisiteConcepts":["arith_fractions"],"skills":["partition_by_ratio"],"patterns":["total_ratio_units"],"misconceptions":["uses_ratio_numbers_as_amounts"],"isAutoGradable":true,"solution":"There are 2+3=5 equal units. Each unit is 45/5=9, so the parts are 18 and 27.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-ratios","chapterTitle":"Ratios","sequence":27402},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_ratio_003","statement":"A map scale is 1:50,000. A road measures 6 cm on the map. What is its actual length in kilometers?","answer":"3 km","answerType":"multiple_choice","choices":[{"value":"0.3 km","text":"0.3 km"},{"value":"3 km","text":"3 km"},{"value":"30 km","text":"30 km"},{"value":"300 km","text":"300 km"},{"value":"3000 km","text":"3000 km"}],"difficulty":3,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_ratios","concepts":["arith_ratios","arith_decimals"],"prerequisiteConcepts":["arith_decimals"],"skills":["apply_map_scale"],"patterns":["scale_then_convert_units"],"misconceptions":["forgets_centimeters_to_kilometers_conversion"],"isAutoGradable":true,"solution":"6*50,000=300,000 cm. Since 100,000 cm=1 km, the road is 3 km.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-ratios","chapterTitle":"Ratios","sequence":27403},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"alg1_anchor_v1_prop_001","statement":"Solve the proportion x/5=6/15. What is x?","answer":"2","answerType":"multiple_choice","choices":[{"value":"2","text":"2"},{"value":"3","text":"3"},{"value":"5","text":"5"},{"value":"10","text":"10"},{"value":"18","text":"18"}],"difficulty":1,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_ratios"],"skills":["solve_basic_proportion"],"patterns":["cross_products"],"misconceptions":["matches_noncorresponding_terms"],"isAutoGradable":true,"solution":"Cross-multiply: 15x=5*6=30, so x=2.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-proportions","chapterTitle":"Proportions","sequence":27501},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_prop_002","statement":"Four notebooks cost $10 at a constant rate. How much do 10 notebooks cost?","answer":"$25","answerType":"multiple_choice","choices":[{"value":"$14","text":"$14"},{"value":"$20","text":"$20"},{"value":"$25","text":"$25"},{"value":"$40","text":"$40"},{"value":"$100","text":"$100"}],"difficulty":2,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","arith_ratios"],"prerequisiteConcepts":["arith_decimals"],"skills":["unit_rate_proportion"],"patterns":["constant_cost_per_item"],"misconceptions":["adds_item_and_cost_changes"],"isAutoGradable":true,"solution":"The unit cost is $10/4=$2.50. Ten notebooks cost 10*$2.50=$25.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-proportions","chapterTitle":"Proportions","sequence":27502},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_prop_003","statement":"Two similar triangles have corresponding sides 6 and 9 in the first triangle, and x and 15 in the second. What is x?","answer":"10","answerType":"multiple_choice","choices":[{"value":"4","text":"4"},{"value":"9","text":"9"},{"value":"10","text":"10"},{"value":"12","text":"12"},{"value":"22.5","text":"22.5"}],"difficulty":3,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_proportions","concepts":["arith_proportions","geo_similarity"],"prerequisiteConcepts":["arith_ratios"],"skills":["solve_similarity_proportion"],"patterns":["match_corresponding_sides"],"misconceptions":["pairs_noncorresponding_sides"],"isAutoGradable":true,"solution":"Use 6/9=x/15. Cross-multiply to get 9x=90, so x=10.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-proportions","chapterTitle":"Proportions","sequence":27503},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"alg1_anchor_v1_expr_001","statement":"Evaluate 3a-2b when a=4 and b=-1.","answer":"14","answerType":"multiple_choice","choices":[{"value":"8","text":"8"},{"value":"10","text":"10"},{"value":"11","text":"11"},{"value":"14","text":"14"},{"value":"16","text":"16"}],"difficulty":1,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"prealg_expressions","concepts":["prealg_expressions","prealg_substitution"],"prerequisiteConcepts":["arith_integers"],"skills":["evaluate_expression"],"patterns":["substitute_with_parentheses"],"misconceptions":["drops_negative_sign"],"isAutoGradable":true,"solution":"Substitute carefully: 3(4)-2(-1)=12+2=14.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-expressions","chapterTitle":"Algebraic Expressions","sequence":27601},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_expr_002","statement":"Simplify 5x-3+2x+8 by combining like terms.","answer":"7x+5","answerType":"multiple_choice","choices":[{"value":"7x+5","text":"7x+5"},{"value":"7x-11","text":"7x-11"},{"value":"10x+5","text":"10x+5"},{"value":"7x+8","text":"7x+8"},{"value":"3x+5","text":"3x+5"}],"difficulty":2,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"prealg_expressions","concepts":["prealg_expressions","prealg_simplification"],"prerequisiteConcepts":["arith_integers"],"skills":["combine_like_terms"],"patterns":["group_variable_and_constant_terms"],"misconceptions":["combines_unlike_terms"],"isAutoGradable":true,"solution":"Combine 5x+2x=7x and -3+8=5, giving 7x+5.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-expressions","chapterTitle":"Algebraic Expressions","sequence":27602},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_expr_003","statement":"A rectangle has length 2x+3 and width x-1. Which expression gives its perimeter?","answer":"6x+4","answerType":"multiple_choice","choices":[{"value":"3x+2","text":"3x+2"},{"value":"3x+4","text":"3x+4"},{"value":"4x+2","text":"4x+2"},{"value":"6x+4","text":"6x+4"},{"value":"2x^2+x-3","text":"2x^2+x-3"}],"difficulty":3,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"prealg_expressions","concepts":["prealg_expressions","geo_perimeter"],"prerequisiteConcepts":["prealg_simplification"],"skills":["write_and_simplify_perimeter_expression"],"patterns":["twice_length_plus_twice_width"],"misconceptions":["computes_area_instead_of_perimeter"],"isAutoGradable":true,"solution":"P=2(2x+3)+2(x-1)=4x+6+2x-2=6x+4.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-expressions","chapterTitle":"Algebraic Expressions","sequence":27603},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

  {"id":"alg1_anchor_v1_int_001","statement":"Evaluate -7+12.","answer":"5","answerType":"multiple_choice","choices":[{"value":"-19","text":"-19"},{"value":"-5","text":"-5"},{"value":"5","text":"5"},{"value":"7","text":"7"},{"value":"19","text":"19"}],"difficulty":1,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_integers","concepts":["arith_integers"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["add_integers"],"patterns":["subtract_magnitudes_for_opposite_signs"],"misconceptions":["adds_magnitudes_and_keeps_negative"],"isAutoGradable":true,"solution":"The signs differ, so subtract magnitudes: 12-7=5, with the positive sign of 12.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-integers","chapterTitle":"Integer Operations","sequence":27701},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_int_002","statement":"Evaluate -4(3-8).","answer":"20","answerType":"multiple_choice","choices":[{"value":"-44","text":"-44"},{"value":"-20","text":"-20"},{"value":"5","text":"5"},{"value":"20","text":"20"},{"value":"44","text":"44"}],"difficulty":2,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_integers","concepts":["arith_integers","prealg_expressions"],"prerequisiteConcepts":["arith_integers"],"skills":["integer_order_of_operations"],"patterns":["parentheses_then_multiply"],"misconceptions":["distributes_negative_sign_incorrectly"],"isAutoGradable":true,"solution":"First 3-8=-5. Then -4*(-5)=20.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-integers","chapterTitle":"Integer Operations","sequence":27702},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},
  {"id":"alg1_anchor_v1_int_003","statement":"The temperature is -6 degrees, rises 4 degrees, then falls 9 degrees. What is the final temperature?","answer":"-11 degrees","answerType":"multiple_choice","choices":[{"value":"-19 degrees","text":"-19 degrees"},{"value":"-11 degrees","text":"-11 degrees"},{"value":"-1 degree","text":"-1 degree"},{"value":"7 degrees","text":"7 degrees"},{"value":"11 degrees","text":"11 degrees"}],"difficulty":3,"source":"algebra1_reviewed_anchors_v1_original","primaryConcept":"arith_integers","concepts":["arith_integers"],"prerequisiteConcepts":["arith_natural_numbers"],"skills":["model_integer_changes"],"patterns":["signed_change_sequence"],"misconceptions":["uses_change_magnitudes_without_signs"],"isAutoGradable":true,"solution":"Start at -6: -6+4=-2, then -2-9=-11 degrees.","curriculum":{"course":"Algebra 1","theme":"Reviewed Concept Anchors","chapter":"algebra1-anchors-v1-integers","chapterTitle":"Integer Operations","sequence":27703},"locale":{"language":"en-US","displayTrack":"English Core","contentStatus":"reviewed"},"reviewStatus":"reviewed"},

